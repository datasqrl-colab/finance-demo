-- Customer Enriched Pipeline
-- Produces silver-layer Customer_Profile and Customer_Household tables
-- from customer_master and kyc_aml bronze sources.
--
-- Deduplication: latest-record-wins per natural key via DISTINCT ON.
-- Household formation: customers linked via SPOUSE/JOINT_OWNER/DEPENDENT
-- relationships share a household; all others are singleton households.
-- Age and tenure are computed relative to each record's source_updated_at
-- to keep results deterministic in streaming mode.

IMPORT data-catalog.customer.customer_data.customer_master-{{environment}} AS cs;
IMPORT data-catalog.customer.customer_data.kyc_aml-{{environment}} AS kyc;
IMPORT customer_enriched_sinks-{{environment}} AS sink;


-- ============================================================
-- DEDUPLICATION: Latest record per natural key
-- ============================================================

-- Latest customer record per customer_id (CDC append-stream dedup)
_Customer := DISTINCT cs.Customer ON customer_id ORDER BY source_updated_at DESC;

-- Latest address per (customer_id, address_type)
_CustomerAddress := DISTINCT cs.Customer_Address ON customer_id, address_type ORDER BY source_updated_at DESC;

-- Filter to active relationships before deduplication
_ActiveRelationship := SELECT * FROM cs.Customer_Relationship WHERE is_active = true;

-- Latest active relationship per pair
_CustomerRelationship := DISTINCT _ActiveRelationship ON primary_customer_id, related_customer_id ORDER BY source_updated_at DESC;

-- Filter to current risk rating rows (SCD Type 2 — is_current flags the active row)
_CurrentRiskRating := SELECT * FROM kyc.Customer_Risk_Rating WHERE is_current = true;

-- Current risk rating per customer
_CustomerRiskRating := DISTINCT _CurrentRiskRating ON customer_id ORDER BY source_updated_at DESC;

-- Latest KYC verification result per customer
_KycVerification := DISTINCT kyc.Kyc_Verification ON customer_id ORDER BY verified_at DESC;

-- Latest PEP screening per customer
_PepScreening := DISTINCT kyc.Pep_Screening ON customer_id ORDER BY screened_at DESC;

-- ============================================================
-- CONTACT RESOLUTION
-- ============================================================

-- Email: verified preferred over unverified; ties broken by recency
_EmailByPriority := SELECT
  customer_id,
  contact_value AS primary_email,
  CASE WHEN verification_status = 'VERIFIED' THEN 0 ELSE 1 END AS email_pref,
  source_updated_at
FROM cs.Customer_Contact
WHERE contact_type = 'EMAIL';

_PrimaryEmail := DISTINCT _EmailByPriority ON customer_id ORDER BY email_pref ASC, source_updated_at DESC;

-- Phone: MOBILE > HOME_PHONE > WORK_PHONE; ties broken by recency
_PhoneByPriority := SELECT
  customer_id,
  contact_value AS primary_phone,
  CASE contact_type WHEN 'MOBILE' THEN 0 WHEN 'HOME_PHONE' THEN 1 ELSE 2 END AS phone_pref,
  source_updated_at
FROM cs.Customer_Contact
WHERE contact_type IN ('MOBILE', 'HOME_PHONE', 'WORK_PHONE');

_PrimaryPhone := DISTINCT _PhoneByPriority ON customer_id ORDER BY phone_pref ASC, source_updated_at DESC;

-- Current residential (PRIMARY) address per customer
_ResidentialAddress := SELECT * FROM _CustomerAddress
WHERE address_type = 'PRIMARY' AND is_current = true;

-- ============================================================
-- CUSTOMER PROFILE
-- ============================================================

-- Pre-compute TIMESTAMPDIFF expressions in Flink before writing to Postgres.
-- Postgres cannot translate TIMESTAMPDIFF or CAST(expr AS DATE) — keeping them
-- in this intermediate layer ensures Customer_Profile only references plain columns.
/*+engine(flink)*/
_CustomerComputed := SELECT
  c.customer_id,
  TRIM(CONCAT(
    c.first_name,
    CASE WHEN c.middle_name IS NOT NULL AND CHAR_LENGTH(c.middle_name) > 0
         THEN CONCAT(' ', c.middle_name) ELSE '' END,
    ' ', c.last_name
  )) AS full_name,
  e.primary_email,
  p.primary_phone,
  a.address_line_1 AS primary_address,
  a.city AS primary_city,
  a.state_province AS primary_state,
  a.postal_code AS primary_postal_code,
  CASE WHEN c.date_of_birth IS NOT NULL
    THEN CAST(TIMESTAMPDIFF(YEAR, c.date_of_birth, CAST(c.source_updated_at AS DATE)) AS INT)
    ELSE NULL END AS age_years,
  CASE
    WHEN c.date_of_birth IS NULL THEN NULL
    WHEN TIMESTAMPDIFF(YEAR, c.date_of_birth, CAST(c.source_updated_at AS DATE)) < 25 THEN '18-24'
    WHEN TIMESTAMPDIFF(YEAR, c.date_of_birth, CAST(c.source_updated_at AS DATE)) < 35 THEN '25-34'
    WHEN TIMESTAMPDIFF(YEAR, c.date_of_birth, CAST(c.source_updated_at AS DATE)) < 45 THEN '35-44'
    WHEN TIMESTAMPDIFF(YEAR, c.date_of_birth, CAST(c.source_updated_at AS DATE)) < 55 THEN '45-54'
    WHEN TIMESTAMPDIFF(YEAR, c.date_of_birth, CAST(c.source_updated_at AS DATE)) < 65 THEN '55-64'
    ELSE '65+' END AS age_band,
  CAST(TIMESTAMPDIFF(MONTH, c.relationship_start_date, CAST(c.source_updated_at AS DATE)) AS INT) AS tenure_months,
  CASE
    WHEN TIMESTAMPDIFF(MONTH, c.relationship_start_date, CAST(c.source_updated_at AS DATE)) < 6 THEN 'NEW'
    WHEN TIMESTAMPDIFF(MONTH, c.relationship_start_date, CAST(c.source_updated_at AS DATE)) < 24 THEN 'DEVELOPING'
    WHEN TIMESTAMPDIFF(MONTH, c.relationship_start_date, CAST(c.source_updated_at AS DATE)) < 60 THEN 'ESTABLISHED'
    ELSE 'MATURE' END AS tenure_band,
  c.customer_type,
  c.customer_status,
  COALESCE(r.risk_rating, 'UNRATED') AS risk_rating,
  COALESCE(k.verification_result = 'PASS', FALSE) AS is_kyc_verified,
  COALESCE(pep.is_pep, FALSE) AS is_pep,
  FALSE AS is_digital_enrolled,
  '' AS preferred_channel,
  now() AS computed_at
FROM _Customer c
LEFT JOIN _PrimaryEmail e ON c.customer_id = e.customer_id
LEFT JOIN _PrimaryPhone p ON c.customer_id = p.customer_id
LEFT JOIN _ResidentialAddress a ON c.customer_id = a.customer_id
LEFT JOIN _CustomerRiskRating r ON c.customer_id = r.customer_id
LEFT JOIN _KycVerification k ON c.customer_id = k.customer_id
LEFT JOIN _PepScreening pep ON c.customer_id = pep.customer_id
WHERE c.customer_status IN ('ACTIVE', 'INACTIVE');

/** Consolidated customer profile combining identity, contact, address, and compliance data.
    One row per active or inactive customer.
    Counts for deposit/credit/loan products default to 0 pending downstream enrichment. */
/*+query_by_any(customer_id) */
Customer_Profile := DISTINCT _CustomerComputed ON customer_id ORDER BY computed_at DESC;

EXPORT Customer_Profile TO sink.Customer_Profile;

-- ============================================================
-- HOUSEHOLD FORMATION
-- ============================================================

-- Normalize relationship pairs: smaller customer_id always in hh_head position
-- to eliminate duplicate bidirectional entries.
_RelPairsNorm := SELECT
  CASE WHEN primary_customer_id < related_customer_id
       THEN primary_customer_id ELSE related_customer_id END AS hh_head,
  CASE WHEN primary_customer_id < related_customer_id
       THEN related_customer_id ELSE primary_customer_id END AS hh_member,
  relationship_type,
  relationship_start_date AS eff_from
FROM _CustomerRelationship
WHERE relationship_type IN ('SPOUSE', 'JOINT_OWNER', 'DEPENDENT');

-- Deduplicate pairs; oldest relationship wins for household_id stability.
_HouseholdPairs := DISTINCT _RelPairsNorm ON hh_head, hh_member ORDER BY eff_from ASC;

-- Head member entry for each relationship household
_HhHeads := SELECT
  hh_head AS household_id,
  hh_head AS customer_id,
  'HEAD' AS household_role,
  TRUE AS is_primary,
  CAST(2 AS INT) AS hh_size,
  'RELATIONSHIP' AS match_method,
  CAST(90 AS INT) AS confidence_score,
  eff_from
FROM _HouseholdPairs;

-- Non-head member entry for each relationship household
_HhMembers := SELECT
  hh_head AS household_id,
  hh_member AS customer_id,
  CASE relationship_type
    WHEN 'SPOUSE' THEN 'SPOUSE'
    WHEN 'DEPENDENT' THEN 'DEPENDENT'
    ELSE 'OTHER' END AS household_role,
  FALSE AS is_primary,
  CAST(2 AS INT) AS hh_size,
  'RELATIONSHIP' AS match_method,
  CAST(90 AS INT) AS confidence_score,
  eff_from
FROM _HouseholdPairs;

-- Combined household rows from all relationship-based memberships
_HouseholdFromRel := SELECT * FROM _HhHeads UNION ALL SELECT * FROM _HhMembers;

-- One household assignment per customer; oldest membership retained for stability
_CustomerHousehold := DISTINCT _HouseholdFromRel ON customer_id ORDER BY eff_from ASC;

-- Raw household assignment rows; keyed via the DISTINCT below so the
-- upsert key is explicit for the upsert sink. Keyed by customer_id alone
-- (a customer belongs to exactly one household), so a transient singleton
-- row is overwritten under the same key when the relationship match arrives.
_CustomerHouseholdRows := SELECT
  COALESCE(h.household_id, c.customer_id) AS household_id,
  c.customer_id,
  COALESCE(h.household_role, 'HEAD') AS household_role,
  COALESCE(h.is_primary, TRUE) AS is_primary,
  COALESCE(h.hh_size, CAST(1 AS INT)) AS household_size,
  CAST(NULL AS VARCHAR) AS household_income_band,
  ha.address_line_1 AS household_address,
  ha.city AS household_city,
  ha.state_province AS household_state,
  ha.postal_code AS household_postal_code,
  CAST(NULL AS BIGINT) AS household_balance_cents,
  CAST(NULL AS INT) AS household_product_count,
  COALESCE(h.match_method, 'SINGLETON') AS match_method,
  COALESCE(h.confidence_score, CAST(100 AS INT)) AS confidence_score,
  COALESCE(h.eff_from, c.relationship_start_date) AS effective_from,
  CAST(NULL AS DATE) AS effective_to,
  TRUE AS is_current,
  now() AS computed_at
FROM _Customer c
LEFT JOIN _CustomerHousehold h ON c.customer_id = h.customer_id
LEFT JOIN _ResidentialAddress ha ON COALESCE(h.household_id, c.customer_id) = ha.customer_id
WHERE c.customer_status IN ('ACTIVE', 'INACTIVE');

/** Customer household assignments: one row per customer.
    Relationship-based households use the head customer's residential address.
    Singletons (no qualifying relationship) use their own address as household address
    and household_id = customer_id. */
/*+query_by_any(household_id, customer_id) */
Customer_Household := DISTINCT _CustomerHouseholdRows ON customer_id ORDER BY computed_at DESC;

EXPORT Customer_Household TO sink.Customer_Household;

-- ============================================================
-- DATA QUALITY TABLES
-- ============================================================

/** DQ: Address records with invalid effective window (effective_from > effective_to).
    Non-empty output indicates a source data contract violation. */
DQ_Address_Window_Issues := SELECT
  customer_id, address_type, effective_from, effective_to, source_updated_at, ingested_at
FROM cs.Customer_Address
WHERE effective_to IS NOT NULL AND effective_from > effective_to ORDER BY source_updated_at DESC;

/** DQ: Active customers without a current AML risk rating — compliance-sensitive.
    Any row here requires immediate remediation. */
DQ_Unrated_Active_Customers := SELECT c.customer_id, c.customer_status, c.source_updated_at, c.ingested_at
FROM _Customer c
LEFT JOIN _CustomerRiskRating r ON c.customer_id = r.customer_id
WHERE c.customer_status = 'ACTIVE' AND r.customer_id IS NULL ORDER BY c.source_updated_at DESC;

-- ============================================================
-- OBSERVABILITY
-- ============================================================

-- Union of all source table records with source metadata
_SourceRecords := SELECT 'Customer' AS source_name, source_updated_at, ingested_at FROM cs.Customer
  UNION ALL SELECT 'Customer_Address' AS source_name, source_updated_at, ingested_at FROM cs.Customer_Address
  UNION ALL SELECT 'Customer_Contact' AS source_name, source_updated_at, ingested_at FROM cs.Customer_Contact
  UNION ALL SELECT 'Customer_Relationship' AS source_name, source_updated_at, ingested_at FROM cs.Customer_Relationship
  UNION ALL SELECT 'Customer_Risk_Rating' AS source_name, source_updated_at, ingested_at FROM kyc.Customer_Risk_Rating
  UNION ALL SELECT 'Kyc_Verification' AS source_name, verified_at AS source_updated_at, ingested_at FROM kyc.Kyc_Verification
  UNION ALL SELECT 'Pep_Screening' AS source_name, screened_at AS source_updated_at, ingested_at FROM kyc.Pep_Screening;

/** Hourly source ingestion statistics per source table.
    Tracks record counts and source_updated_at range per tumbling hour window. */
/*+query_by_any(source_name) */
SourceIngestionStats := SELECT
  source_name,
  window_start,
  window_time AS window_end,
  COUNT(*) AS record_count,
  MIN(source_updated_at) AS min_source_updated_at,
  MAX(source_updated_at) AS max_source_updated_at
FROM TABLE(TUMBLE(TABLE _SourceRecords, DESCRIPTOR(ingested_at), INTERVAL '1' HOUR))
GROUP BY source_name, window_start, window_end, window_time
ORDER BY window_time DESC, source_name ASC;

-- ============================================================
-- TEST QUERIES
-- ============================================================

/*+test */
CustomerProfileTest := SELECT
                           customer_id, full_name, primary_email, primary_phone,
                           primary_address, primary_city, primary_state,
                           customer_type, customer_status, risk_rating,
                           is_kyc_verified, is_pep,
                           is_digital_enrolled
                       FROM Customer_Profile
                       ORDER BY customer_id ASC;

/*+test */
CustomerHouseholdTest := SELECT
                             household_id, customer_id, household_role, is_primary, household_size,
                             household_address, household_city, match_method, is_current
                         FROM Customer_Household
                         ORDER BY customer_id ASC;

/*+test */
SourceIngestionStatsTests := SELECT * FROM SourceIngestionStats;