{
  "script": {
    "config": {
      "environment": "prod"
    }
  },
  "engines": {
    "vertx": {
      "config": {
        "auth": {
          "issuers": [
            {
              "issuer": "${AUTH_ISSUER}",
              "audiences": ["${AUTH_AUDIENCE}"],
