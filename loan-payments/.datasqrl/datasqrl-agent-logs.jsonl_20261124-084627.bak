URE', 'REO', 'TRANSFERRED', 'CHARGED_OFF');\n\n/** Mortgage borrower type must be a valid enumeration value */\n/*+test(no_rows) */\nBorrowerHasValidType_Test := SELECT * FROM Mortgage_Borrower WHERE borrower_type NOT IN ('PRIMARY', 'CO_BORROWER', 'GUARANTOR');\n\n/** Personal loan rate type must be a valid enumeration value */\n/*+test(no_rows) */\nPersonalLoanHasValidRateType_Test := SELECT * FROM Personal_Loan WHERE rate_type NOT IN ('FIXED', 'VARIABLE');\n\n/** Auto loan rate type must be a valid enumeration value */\n/*+test(no_rows) */\nAutoLoanHasValidRateType_Test := SELECT * FROM Auto_Loan WHERE rate_type NOT IN ('FIXED', 'VARIABLE');\n\n/** Mortgage loan rate type must be a valid enumeration value */\n/*+test(no_rows) */\nMortgageLoanHasValidRateType_Test := SELECT * FROM Mortgage_Loan WHERE rate_type NOT IN ('FIXED', 'ARM');\n\n/** Mortgage loan lien position must be a valid enumeration value */\n/*+test(no_rows) */\nMortgageLoanHasValidLienPosition_Test := SELECT * FROM Mortgage_Loan WHERE lien_position NOT IN ('FIRST', 'SECOND', 'HELOC');\n\n/** Mortgage loan occupancy type, when set, must be a valid enumeration value */\n/*+test(no_rows) */\nMortgageLoanHasValidOccupancyType_Test := SELECT * FROM Mortgage_Loan\n    WHERE occupancy_type IS NOT NULL AND occupancy_type NOT IN ('PRIMARY', 'SECOND_HOME', 'INVESTMENT');\n\n/** Mortgage loan program, when set, must be a valid enumeration value */\n/*+test(no_rows) */\nMortgageLoanHasValidProgram_Test := SELECT * FROM Mortgage_Loan\n    WHERE loan_program IS NOT NULL AND loan_program NOT IN ('CONVENTIONAL', 'FHA', 'VA', 'USDA', 'JUMBO');\n\n-- =====================================================\n-- Data Quality & Assertions: Date Ordering\n-- =====================================================\n\n/** Credit card account closed date must not be before its opened date */\n/*+test(no_rows) */\nCardAccountClosedNotBeforeOpened_Test := SELECT * FROM Credit_Card_Account WHERE closed_date IS NOT NULL AND closed_date < opened_date;\n\n/** Personal loan maturity date must not be before its funding date */\n/*+test(no_rows) */\nPersonalLoanMaturityNotBeforeFunding_Test := SELECT * FROM Personal_Loan WHERE maturity_date < funding_date;\n\n/** Auto loan maturity date must not be before its funding date */\n/*+test(no_rows) */\nAutoLoanMaturityNotBeforeFunding_Test := SELECT * FROM Auto_Loan WHERE maturity_date < funding_date;\n\n/** Mortgage loan maturity date must not be before its funding date */\n/*+test(no_rows) */\nMortgageLoanMaturityNotBeforeFunding_Test := SELECT * FROM Mortgage_Loan WHERE maturity_date < funding_date;\n\n/** Mortgage loan first payment date must not be before its funding date */\n/*+test(no_rows) */\nMortgageLoanFirstPaymentNotBeforeFunding_Test := SELECT * FROM Mortgage_Loan WHERE first_payment_date < funding_date;\n\n-- =====================================================\n-- Data Quality & Assertions: Numeric Sanity\n-- =====================================================\n\n/** Credit card account balances must never be negative */\n/*+test(no_rows) */\nCardAccountBalanceNonNegative_Test := SELECT * FROM Credit_Card_Account WHERE credit_limit_cents < 0 OR current_balance_cents < 0;\n\n/** Credit card payment amounts must never be negative */\n/*+test(no_rows) */\nCardPaymentAmountNonNegative_Test := SELECT * FROM Credit_Card_Payment WHERE payment_amount_cents < 0;\n\n/** Personal and auto loan amounts must never be negative */\n/*+test(no_rows) */\nPersonalLoanAmountNonNegative_Test := SELECT * FROM Personal_Loan\n    WHERE original_amount_cents < 0 OR current_balance_cents < 0 OR monthly_payment_cents < 0;\n\n/** Auto loan amounts must never be negative */\n/*+test(no_rows) */\nAutoLoanAmountNonNegative_Test := SELECT * FROM Auto_Loan\n    WHERE original_amount_cents < 0 OR current_balance_cents < 0 OR monthly_payment_cents < 0;\n\n/** Consumer loan payment amounts must never be negative */\n/*+test(no_rows) */\nLoanPaymentAmountNonNegative_Test := SELECT * FROM Loan_Payment WHERE payment_amount_cents < 0;\n\n/** Mortgage loan amounts must never be negative */\n/*+test(no_rows) */\nMortgageLoanAmountNonNegative_Test := SELECT * FROM Mortgage_Loan\n    WHERE original_principal_cents < 0 OR current_principal_cents < 0 OR monthly_pi_payment_cents < 0 OR total_monthly_payment_cents < 0;\n\n/** Mortgage payment amounts must never be negative */\n/*+test(no_rows) */\nMortgagePaymentAmountNonNegative_Test := SELECT * FROM Mortgage_Payment WHERE payment_amount_cents < 0;\n\n/** Credit scores, where recorded, must fall within the standard 300-850 scoring range */\n/*+test(no_rows) */\nCreditScoresInValidRange_Test := SELECT * FROM Loan_Application WHERE credit_score IS NOT NULL AND (credit_score < 300 OR credit_score > 850);\n\n/** Personal loan origination credit scores, where recorded, must fall within the standard 300-850 scoring range */\n/*+test(no_rows) */\nPersonalLoanCreditScoreInRange_Test := SELECT * FROM Personal_Loan\n    WHERE credit_score_at_origination IS NOT NULL AND (credit_score_at_origination < 300 OR credit_score_at_origination > 850);\n\n/** Auto loan origination credit scores, where recorded, must fall within the standard 300-850 scoring range */\n/*+test(no_rows) */\nAutoLoanCreditScoreInRange_Test := SELECT * FROM Auto_Loan\n    WHERE credit_score_at_origination IS NOT NULL AND (credit_score_at_origination < 300 OR credit_score_at_origination > 850);\n\n/** Mortgage borrower origination credit scores, where recorded, must fall within the standard 300-850 scoring range */\n/*+test(no_rows) */\nMortgageBorrowerCreditScoreInRange_Test := SELECT * FROM Mortgage_Borrower\n    WHERE credit_score_at_origination IS NOT NULL AND (credit_score_at_origination < 300 OR credit_score_at_origination > 850);\n\n-- =====================================================\n-- Data Quality & Assertions: Cross-Field Consistency\n-- =====================================================\n\n/** A closed credit card ac