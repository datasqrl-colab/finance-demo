dules\ndrwxr-xr-x  9 root root  288 Nov 24 08:27 lending\ndrwxr-xr-x  5 root root  160 Nov 24 08:44 loan-payments\n-rw-r--r--  1 root root 1064 Nov 24 08:27 README.md\n---LOAN---\ntotal 4\ndrwxr-xr-x  5 root root  160 Nov 24 08:44 .\ndrwxr-xr-x 11 root root  352 Nov 24 08:28 ..\ndrwxr-xr-x  3 root root   96 Nov 24 08:36 adr\n-rw-r--r--  1 root root 3221 Nov 24 08:44 AGENTS.md\ndrwxr-xr-x  6 root root  192 Nov 24 08:44 .datasqrl\n---ADR---\ntotal 20\ndrwxr-xr-x 3 root root    96 Nov 24 08:36 .\ndrwxr-xr-x 5 root root   160 Nov 24 08:44 ..\n-rw-r--r-- 1 root root 17315 Nov 24 08:44 requirements_20261124-113440.md\n"}], "isError": false, "durationMs": 14, "timestamp": 1795509897010}, {"role": "assistant", "content": [{"type": "thinking", "thinking": "The inventory is not at /workspace/.datasqrl but maybe under loan-payments/.datasqrl or elsewhere. Let me find it.", "thinkingSignature": "reasoning_content"}, {"type": "toolCall", "id": "call_01a20cbac9c67b619deec968", "name": "bash", "arguments": {"command": "find /workspace -name \"repo-inventory.md\" -not -path \"*/build/*\" 2>/dev/null; echo \"---\"; ls -la /workspace/loan-payments/.datasqrl; echo \"---datacatalog---\"; ls -la /workspace/data-catalog"}}, {"type": "toolCall", "id": "call_01a20cbaca1e7483acd39044", "name": "read", "arguments": {"path": "/workspace/README.md"}}, {"type": "toolCall", "id": "call_01a20cbaca41701386ad189e", "name": "read", "arguments": {"path": "/workspace/loan-payments/AGENTS.md"}}], "api": "openai-completions", "provider": "together", "model": "deepseek-ai/DeepSeek-V4.1-Flash", "usage": {"input": 539, "output": 202, "cacheRead": 19072, "cacheWrite": 0, "reasoning": 32, "totalTokens": 19813, "cost": {"input": 0.0001617, "output": 0.00024239999999999998, "cacheRead": 0.000114432, "cacheWrite": 0, "total": 0.000518532}}, "stopReason": "toolUse", "timestamp": 1795509897012, "responseId": "96f01bc26c64409680c05c9b86502dff-aws_ec1", "rawStopReason": "tool_calls", "durationMs": 943, "thinkingLevel": "high"}, {"role": "toolResult", "toolCallId": "call_01a20cbac9c67b619deec968", "toolName": "bash", "content": [{"type": "text", "text": "/workspace/loan-payments/.datasqrl/repo-inventory.md\n---\ntotal 236\ndrwxr-xr-x 6 root root    192 Nov 24 08:44 .\ndrwxr-xr-x 5 root root    160 Nov 24 08:44 ..\n-rw-r--r-- 1 root root   7581 Nov 24 08:44 datasqrl-agent-context.txt\n-rw-r--r-- 1 root root 176480 Nov 24  2026 datasqrl-agent-logs.jsonl.bak\n-rw-r--r-- 1 root root   1152 Nov 24 08:44 datasqrl-agent-progress.txt\n-rw-r--r-- 1 root root   8120 Nov 24 08:44 repo-inventory.md\n---datacatalog---\ntotal 60\ndrwxr-xr-x 14 root root   448 Nov 24 08:27 .\ndrwxr-xr-x 11 root root   352 Nov 24 08:28 ..\ndrwxr-xr-x  4 root root   128 Nov 24 08:27 customer\ndrwxr-xr-x  5 root root   160 Nov 24 08:27 deposits_payments\n-rw-r--r--  1 root root    96 Nov 24 08:27 .git\ndrwxr-xr-x  3 root root    96 Nov 24 08:27 .github\n-rw-r--r--  1 root root   134 Nov 24 08:27 .gitignore\ndrwxr-xr-x  5 root root   160 Nov 24 08:27 lending\n-rw-r--r--  1 root root   501 Nov 24 08:27 ontology-shared-package.json\n-rw-r--r--  1 root root 18322 Nov 24 08:27 ontology.sqrl\n-rw-r--r--  1 root root   308 Nov 24 08:27 ontology-test-package.json\n-rw-r--r--  1 root root  8589 Nov 24 08:27 README.md\n-rwxr-xr-x  1 root root  8752 Nov 24 08:27 run-tests.sh\ndrwxr-xr-x  3 root root    96 Nov 24 08:27 snapshots\n"}], "isError": false, "durationMs": 21, "timestamp": 1795509897980}, {"role": "toolResult", "toolCallId": "call_01a20cbaca1e7483acd39044", "toolName": "read", "content": [{"type": "text", "text": "# Finance Demo\n\nReal-time streaming data products for financial services built with DataSQRL.\n\nBoth data products consume the shared [`data-catalog`](https://github.com/datasqrl-colab/finance-data-catalog-demo) \u2014 a git submodule at the repository root \u2014 via `script.include` in their shared package files. Clone with submodules:\n\n```bash\ngit clone --recurse-submodules <repo-url>\n# or, in an existing checkout:\ngit submodule update --init --remote data-catalog\n```\n\n## Data Products\n\n### [Customer Enrichment Pipeline](customer/README.md)\n\nProduces silver-layer customer data from bronze-layer CDC streams. Consolidates identity, contact, compliance (KYC/AML/PEP), and relationship data into deduplicated `Customer_Profile` and `Customer_Household` tables with household grouping and data quality monitoring.\n\n### [Lending 360](lending/README.md)\n\nCustomer-facing unified view of all lending instruments \u2014 mortgages, consumer loans (personal and auto), and credit cards. Provides active balances, terms, and consolidated payment history across all products.\n"}], "isError": false, "durationMs": 8, "timestamp": 1795509897980}, {"role": "toolResult", "toolCallId": "call_01a20cbaca41701386ad189e", "toolName": "read", "content": [{"type": "text", "text": "You are a DataSQRL planning and Q&A expert. Your job is to investigate a DataSQRL project\nand either answer a question or produce a structured implementation plan.\n\n## What You Do NOT Do\n\n- Do NOT run compile or test commands (`cmd.sh`, `mvn`, `docker`, etc.)\n- Do NOT modify any `.sqrl`, `.json`, `.graphqls`, `.graphql`, or source files\n- Do NOT create files other than the single plan file you are explicitly told to write\n- Do NOT write SQRL, JSON config or Java statements in the plan's `## Implementation Checklist`\n  or `## Technical Decisions`\n- Do NOT write a fenced code block in the plan's `## Implementation Checklist`\n- Any referenced files must be in the project.\n\n## What You Do\n\nYou investigate, reason, and write exactly one output:\n- For a question: your answer as text\n- For an implementation request: a structured plan written to the plan-file path given in your prompt (a single self-contained ADR whose `## Implementation Checklist` uses `- [ ]` checkboxes)\n\n\n## Step 1: Read the Workspace\n\nBefore doing anything else, understand the repository around you and the current project state:\n\n1. **Survey the repository.** Your project can sit inside a repo containing other SQRL projects and shared modules (typically a data catalog). Investigate shared modules/data catalogs first, then the other projects. \nEverything outside your own project is mounted **READ-ONLY**: never modify it, never copy its files into your project, and never read another project's `build/` directory (compiler output \u2014 deliberately excluded from the inventory).\n2. Read all `.sqrl` files to understand the data model and pipeline logic\n3. Read all `package.json` files to understand configuration and engines\n4. Read `README.md` if it exists\n5. Read the recent `adr/plan_*.md` and `adr/requirements_*.md` (filenames are timestamped) to understand the latest decisions and what has already been implemented.\n\n## Step 2: Read the Available Skills\n\nThe complete text of every DataSQRL skill is loaded in your system prompt under \"DataSQRL skills (complete)\". It states the instructions and rules that apply when a DataSQRL pipeline or data catalog is built. Use it to:\n\n- classify the request along both axes (scenario and task type),\n- select an architecture whose constructs exist in DataSQRL,\n- identify the constraints that determine a plan's shape: which tables are exposed as mutations,\n  where operator state is unbounded, which connector applies per environment, which windowing\n  satisfies a stated freshness target,\n- annotate each checklist step with the skill that executes it (e.g. `\u2192 skill: /implement-sqrl`).\n\nCode examples in the skills are inputs to the implementation agent, which compiles them.\n\n`/opt/agent/skills/<name>/` holds reference pages excluded from the loaded corpus (`functions/`, `connectors/`, `formats/`, `guides/`). Read one when a design decision depends on its content.\n\n## Output Constraints\n\n- For questions: respond with your answer inline. Write no files.\n- For implementation plans: write ONLY to the plan-file path specified in your prompt, with every\n  checklist box left unchecked (`- [ ]`). Confirm completion by responding with exactly the path\n  you wrote to, nothing else.\n"}], "isError": false, "durationMs": 9, "timestamp": 1795509897980}, {"role": "assistant", "content": [{"type": "toolCall", "id": "call_01a20cbacd297750804159bb", "name": "read", "arguments": {"path": "/workspace/loan-payments/.datasqrl/repo-inventory.md"}}, {"type": "toolCall", "id": "call_01a20cbacd5e7a418e50e3de", "name": "read", "arguments": {"path": "/workspace/data-catalog/README.md"}}], "api": "openai-completions", "provider": "together", "model": "deepseek-ai/DeepSeek-V4.1-Flash", "usage": {"input": 1582, "output": 89, "cacheRead": 19712, "cacheWrite": 0, "reasoning": 0, "totalTokens": 21383, "cost": {"input": 0.0004746, "output": 0.0001068, "cacheRead": 0.000118272, "cacheWrite": 0, "total": 0.0006996719999999999}}, "stopReason": "toolUse", "timestamp": 1795509897982, "responseId": "05d45319e0b34274b30e8a5a5aa0ec90-aws_ec1", "rawStopReason": "tool_calls", "durationMs": 770, "thinkingLevel": "high"}, {"role": "toolResult", "toolCallId": "call_01a20cbacd297750804159bb", "toolName": "read", "content": [{"type": "text", "text": "# Repository inventory\n\nGenerated by the orchestrator for project `loan-payments`. Everything listed here is mounted **READ-ONLY** \u2014 it is reference material, not yours to change.\n\nRules:\n- **Never** create, edit, copy or delete anything under these directories.\n- **Never** copy their files into your project \u2014 include shared modules via `script.include`.\n- **Never** read their `build/` directories (compiler output; excluded from this inventory).\n- Read a directory's README first (when present), then its `.sqrl` files, then its `package.json`.\n\n## `data-catalog` \u2014 SHARED MODULE\n\n_declared under script.include by customer_\n\n- Main script: `ontology.sqrl`\n- Engines: `flink`, `postgres`, `vertx`\n- Package configs: `ontology-shared-package.json`, `ontology-test-package.json`\n- Include via `script.include`: `\"data_catalog\": { \"package\": \"../data-catalog/ontology-shared-package.json\" }` (any top-level package file of the module works)\n- SQRL files: `customer/customer-ontology.sqrl`, `customer/customer_data/customer_enriched-prod.sqrl`, `customer/customer_data/customer_enriched-test.sqrl`, `customer/customer_data/customer_enriched.sqrl`, `customer/customer_data/customer_master-prod.sqrl`, `customer/customer_data/customer_master-test.sqrl`, `customer/customer_data/customer_master.sqrl`, `customer/customer_data/kyc_aml-prod.sqrl`, `customer/customer_data/kyc_aml-test.sqrl`, `customer/customer_data/kyc_aml.sqrl`, `deposits_payments/accounts/account_analytics-prod.sqrl`, `deposits_payments/accounts/account_analytics-test.sqrl`, `deposits_payments/accounts/account_analytics.sqrl`, `deposits_payments/accounts/account_balances-prod.sqrl`, `deposits_payments/accounts/account_balances-test.sqrl`, `deposits_payments/accounts/account_balances.sqrl`, `deposits_payments/accounts/deposit_accounts-prod.sqrl`, `deposits_payments/accounts/deposit_accounts-test.sqrl`, `deposits_payments/accounts/deposit_accounts.sqrl`, `deposits_payments/deposits_payments-ontology.sqrl`, `deposits_payments/transactions/card_transactions-prod.sqrl`, `deposits_payments/transactions/card_transactions-test.sqrl`, `deposits_payments/transactions/card_transactions.sqrl`, `deposits_payments/transactions/core_transactions-prod.sqrl`, `deposits_payments/transactions/core_transactions-test.sqrl`, `deposits_payments/transactions/core_transactions.sqrl`, `deposits_payments/transactions/enriched_transactions-prod.sqrl`, `deposits_payments/transactions/enriched_transactions-test.sqrl`, `deposits_payments/transactions/enriched_transactions.sqrl`, `deposits_payments/transactions/wire_ach_transactions-prod.sqrl`, `deposits_payments/transactions/wire_ach_transactions-test.sqrl`, `deposits_payments/transactions/wire_ach_transactions.sqrl`, `lending/cards_consumer_credit/consumer_loans-prod.sqrl`, `lending/cards_consumer_credit/consumer_loans-test.sqrl`, `lending/cards_consumer_credit/consumer_loans.sqrl`, `lending/cards_consumer_credit/credit_cards-prod.sqrl`, `lending/cards_consumer_credit/credit_cards-test.sqrl`, `lending/cards_consumer_credit/credit_cards.sqrl`, `lending/cards_consumer_credit/credit_risk_signals-prod.sqrl`, `lending/cards_consumer_credit/credit_risk_signals-test.sqrl` (+12 more not listed)\n\n<details><summary>README.md</summary>\n\n# Retail Bank Data Catalog\n\nA data catalog covering the **bronze** (source) and **silver** (enriched/conformed) layers of a retail bank's data mesh. Tables are documented as SQRL `CREATE TABLE` definitions using Flink SQL syntax, organized by line of business and team.\n\n## Catalog Index\n\n| Line of Business | Team | Folder | Key Datasets |\n|---|---|---|---|\n| Customer | Customer Data | [customer/customer_data/](customer/customer_data/) | Customer master, KYC/AML, Customer profiles |\n| Deposits & Payments | Accounts | [deposits_payments/accounts/](deposits_payments/accounts/) | Deposit accounts, Balances, Account analytics |\n| Deposits & Payments | Transactions | [deposits_payments/transactions/](deposits_payments/transactions/) | Core transactions, Card/Wire/ACH, Enriched transactions |\n| Lending | Mortgages | [lending/mortgages/](lending/mortgages/) | Originations, Servicing, Performance analytics |\n| Lending | Cards & Consumer Credit | [lending/cards_consumer_credit/](lending/cards_consumer_credit/) | Credit cards, Consumer loans, Credit risk signals |\n\n## Classification Levels\n\n| Level | Description |\n|---|---|\n| **Public** | Disclosed publicly or intended for public use |\n| **In\n\n_(README truncated in this inventory \u2014 read the file for the rest.)_\n\n</details>\n\n## `customer` \u2014 SQRL PROJECT\n\n_has a main script / environment package configs_\n\n- Main script: `customer_enriched_pipeline.sqrl`\n- Engines: `flink`, `iceberg`, `duckdb`, `vertx`\n- Consumes shared module(s): `data-catalog`\n- Package configs: `customer_enriched_pipeline-batch-package.json`, `customer_enriched_pipeline-prod-package.json`, `customer_enriched_pipeline-shared-package.json`, `customer_enriched_pipeline-test-package.json`\n- SQRL files: `customer_enriched_pipeline.sqrl`, `customer_enriched_sinks-prod.sqrl`, `customer_enriched_sinks-test.sqrl`\n\n<details><summary>README.md</summary>\n\n# Customer Enrichment Pipeline\n\nA real-time streaming pipeline that produces silver-layer customer data products from bronze-layer source streams. It consolidates customer identity, contact, compliance, and relationship data into queryable `Customer_Profile` and `Customer_Household` tables exposed via GraphQL, REST, and MCP APIs.\n\n## Motivation and Requirements\n\nBanks and financial institutions maintain customer data across multiple authoritative systems \u2014 a core customer master (CDC stream), KYC verification records, AML risk ratings, and PEP screening results. These systems use append-only or CDC event streams, meaning the same customer can appear multiple times as records are updated.\n\nDownstream consumers (analytics, marketing, relationship management, compliance reporting) need:\n\n- **A single, deduplicated customer view** \u2014 one row per customer with the latest identity, contact, and address information.\n- **Compliance enrichment** \u2014 KYC verification status, AML risk rating, and PEP flag attached to each customer record.\n- **Household groupings** \u2014 customers linked via SPOUSE, JOINT_OWNER, or DEPENDENT relationships grouped into households for relationship-level analytics.\n- **\n\n_(README truncated in this inventory \u2014 read the file for the rest.)_\n\n</details>\n\n## `lending` \u2014 SQRL PROJECT\n\n_has a main script / environment package configs_\n\n- Main script: `lending360.sqrl`\n- Engines: `flink`, `postgres`, `kafka`, `vertx`\n- Consumes shared module(s): `data-catalog`\n- Package configs: `lending360-prod-package.json`, `lending360-shared-package.json`, `lending360-test-package.json`\n- SQRL files: `lending360.sqrl`\n\n<details><summary>README.md</summary>\n\n# Lending 360\n\nA customer-facing data application that provides a unified view of all lending instruments a customer holds, including mortgages, consumer loans (personal and auto), and credit cards. Customers can see active balances, terms, and a consolidated payment history across all products.\n\n## Features\n\n- **Mortgage**: Active mortgage loans with key terms (rate, balance, payment, maturity)\n- **CreditCard**: Active credit card accounts with balance, credit limit, APR, and rewards\n- **ConsumerLoan**: Active personal and auto loans in a unified view\n- **Customer**: Basic customer profile without sensitive PII (no SSN, TIN, or date of birth)\n- **ConsolidatedLoanPayments**: All payments across mortgages, consumer loans, and credit cards in one table\n\n## Data Sources\n\nData is sourced from the shared [`data-catalog`](../data-catalog) submodule at the repository root, wired in via `script.include` in `lending360-shared-package.json`:\n- `data-catalog/lending/mortgages` \u2014 mortgage originations and servicing\n- `data-catalog/lending/cards_consumer_credit` \u2014 consumer loans and credit cards\n- `data-catalog/customer/customer_data` \u2014 customer master records\n\n## Project Structure\n\n```\nlending\n\n_(README truncated in this inventory \u2014 read the file for the rest.)_\n\n</details>\n"}], "isError": false, "durationMs": 4, "timestamp": 1795509898758}, {"role": "toolResult", "toolCallId": "call_01a20cbacd5e7a418e50e3de", "toolName": "read", "content": [{"type": "text", "text": "# Retail Bank Data Catalog\n\nA data catalog covering the **bronze** (source) and **silver** (enriched/conformed) layers of a retail bank's data mesh. Tables are documented as SQRL `CREATE TABLE` definitions using Flink SQL syntax, organized by line of business and team.\n\n## Catalog Index\n\n| Line of Business | Team | Folder | Key Datasets |\n|---|---|---|---|\n| Customer | Customer Data | [customer/customer_data/](customer/customer_data/) | Customer master, KYC/AML, Customer profiles |\n| Deposits & Payments | Accounts | [deposits_payments/accounts/](deposits_payments/accounts/) | Deposit accounts, Balances, Account analytics |\n| Deposits & Payments | Transactions | [deposits_payments/transactions/](deposits_payments/transactions/) | Core transactions, Card/Wire/ACH, Enriched transactions |\n| Lending | Mortgages | [lending/mortgages/](lending/mortgages/) | Originations, Servicing, Performance analytics |\n| Lending | Cards & Consumer Credit | [lending/cards_consumer_credit/](lending/cards_consumer_credit/) | Credit cards, Consumer loans, Credit risk signals |\n\n## Classification Levels\n\n| Level | Description |\n|---|---|\n| **Public** | Disclosed publicly or intended for public use |\n| **Internal** | Internal-by-default, low harm if disclosed |\n| **Confidential** | Disclosure causes material harm or competitive damage |\n| **Restricted** | Disclosure causes regulatory, legal, or significant customer harm (PII, NPI, PCI) |\n\n## Sensitivity Tags\n\n| Tag | Category |\n|---|---|\n| `@pii` | Personally Identifiable Information (name, address, phone, email, DOB) |\n| `@spii` | Sensitive PII (SSN, passport, driver's license, biometrics) |\n| `@npi` | GLBA Non-public Personal Information (account numbers, balances, transactions) |\n| `@pci` | Payment Card Industry data (PAN, expiration, cardholder name) |\n| `@confidential` | Internal sensitive but not personal (risk scores, pricing models) |\n\n## Regulatory Scope Tags\n\n`@glba` (Gramm-Leach-Bliley) | `@gdpr` (EU GDPR) | `@ccpa` (California CCPA/CPRA) | `@pci-dss` (PCI DSS) | `@bsa` (Bank Secrecy Act) | `@sox` (Sarbanes-Oxley)\n\n## Handling Tags\n\n| Tag | Required Handling |\n|---|---|\n| `@encrypt` | Encrypted at rest using platform key management |\n| `@tokenize` | Original value replaced by token; raw value in vault only |\n| `@mask` | Display masked outside production and to non-privileged consumers |\n| `@erasable` | Subject to right-to-erasure (GDPR Art. 17, CCPA delete) |\n\n## File Structure\n\nEach dataset is split into a schema file and one connector file per environment:\n- **`{dataset}.sqrl`** \u2014 header comment with layer, classification, and regulatory scope, followed\n  by `_schema`-suffixed `CREATE TABLE` statements. Each table carries a single table-level\n  doc-string that states its grain and a `# Columns:` section documenting every column in\n  declaration order, with its sensitivity tags (`@pii`, `@npi`, `@pci`, `@confidential`, \u2026). The\n  `CREATE TABLE` body itself holds only bare `column TYPE [NOT NULL]` definitions \u2014 no inline\n  column comments.\n- **`{dataset}-test.sqrl`** and **`{dataset}-prod.sqrl`** \u2014 one connector file per environment,\n  each importing the schema file and extending its tables with `LIKE`. The connector table owns\n  the environment-specific pieces the schema table does not: the watermark, the ingestion column\n  (`ingested_at` for bronze sources, `computed_at` for silver), and the `WITH (...)` connector\n  configuration (`filesystem` in test, `kafka-safe`/`iceberg` in prod).\n- **`testdata/`** \u2014 one `.jsonl` file per table, named `{dataset}-{table}.jsonl`, read by the\n  `-test.sqrl` connectors.\n\nBronze tables carry the audit columns `source_system` and `source_updated_at` in their schema, and\n`ingested_at` in their connector table. Silver tables carry `computed_at` in their connector table\ninstead.\n\n**Watermarks are intentionally asymmetric between environments.** Every bronze `-test.sqrl`\nwatermarks its ingestion column 10 seconds back; every bronze `-prod.sqrl` watermarks the same\ncolumn 30 seconds back. This is not a mismatch to reconcile \u2014 test data is small, ordered and\nreplayed once, so a short offset is enough to close out windows quickly, while production Kafka\ndelivery is genuinely out of order and needs the wider tolerance. What must match between the two\n(and does, everywhere in this catalog) is the watermark **column name**, so a table's event-time\nsemantics don't change shape across environments. Likewise, a bronze test connector declares its\n`ingested_at` as a plain physical `TIMESTAMP_LTZ(3)` column while the prod connector sources the\nsame-named column via Kafka `METADATA FROM 'timestamp'` \u2014 the filesystem connector used in test has\nno record metadata to read, so a physical column populated by the test data is the closest\nequivalent. Silver connector tables carry `computed_at` with **no watermark** in either environment,\nbecause they are recomputed upsert snapshots (keyed on the table's grain), not event streams.\n\n## Ontology Layer & Environment Model\n\nEach line of business has a `{lob}-ontology.sqrl` file that imports its datasets, defines the\nrelationships between them, and ends with its data-quality assertions:\n\n- [`customer/customer-ontology.sqrl`](customer/customer-ontology.sqrl) \u2014 Customer line of business\n- [`lending/lending-ontology.sqrl`](lending/lending-ontology.sqrl) \u2014 Lending line of business\n- [`deposits_payments/deposits_payments-ontology.sqrl`](deposits_payments/deposits_payments-ontology.sqrl) \u2014 Deposits & Payments line of business\n\n[`ontology.sqrl`](ontology.sqrl) at the catalog root imports all three unit ontologies, defines the\nrelationships that cross line-of-business boundaries (e.g. a lending account's borrower back to\n`Customer`, a deposit account's holder back to `Customer`), and carries the cross-domain\nreferential-integrity assertions and snapshot tests described below.\n\nEvery dataset and ontology import is written with a `{{environment}}` template variable\n(`IMPORT dataset-{{environment}}.*;`), which `script.config.environment` resolves at compile time\nto select the `-test` or `-prod` connector set for every table in the import chain at once.\n\n## Data Quality\n\nEvery unit and the root ontology end with `/*+test(no_rows) */` assertions: each selects the rows\nthat violate a rule and the assertion passes when the query returns zero rows. The catalog covers\nreferential integrity (mandatory for every foreign key), enum validity, mandatory-field,\nnumeric-sanity, date-ordering, cross-field-consistency and self-reference checks.\n\n- **Intra-unit foreign keys** (child and parent both live in the same line of business) are\n  asserted in that unit's `{lob}-ontology.sqrl` \u2014 e.g. `Account_Holder.account_id` against\n  `Account.account_id` in the Deposits & Payments ontology.\n- **Cross-domain foreign keys** (child and parent live in different lines of business \u2014 e.g. a\n  `Credit_Card_Account.primary_customer_id` referencing `Customer`) can only be asserted in the\n  root `ontology.sqrl`, since it is the only file that imports every unit.\n\nThe root `ontology.sqrl` also carries one `/*+test */` snapshot query per imported dataset,\nfiltered on a known identifier from that dataset's test data, so a change to a schema, connector or\ntest-data file that alters what the catalog serves shows up as a snapshot diff.\n\n## Compile and Test\n\nConfiguration is split into a shared base plus a thin test overlay:\n`ontology-shared-package.json` and `ontology-test-package.json`. Compile and test by layering the\nbase then the overlay (last one wins):\n\n```bash\ndocker run -it --rm -p 8888:8888 -p 8081:8081 -v $PWD:/build datasqrl/cmd \\\n  compile ontology-shared-package.json ontology-test-package.json\n\ndocker run -it --rm -p 8888:8888 -p 8081:8081 -v $PWD:/build datasqrl/cmd \\\n  test ontology-shared-package.json ontology-test-package.json\n```\n\n[`run-tests.sh`](run-tests.sh) at the catalog root is the single entry point for the catalog's\ntests (`./run-tests.sh` runs every suite against `test`; `./run-tests.sh --compile` compiles it\nwithout running the tests). It is what the code agent, CI and a developer all run \u2014\nsee `./run-tests.sh --list-invocations` for what a given flag combination would execute.\n\n## Known Gaps\n\n- **No debit-card master dataset.** `Card_Authorization.card_id`, `Card_Settlement.card_id` and\n  `Card_Chargeback.card_id` in `deposits_payments/transactions/card_transactions.sqrl` have no\n  parent table anywhere in this catalog, so no referential-integrity assertion is written for\n  them. A future card-issuing dataset would need to add one.\n"}], "isError": false, "durationMs": 3, "timestamp": 1795509898758}, {"role": "assistant", "content": [{"type": "thinking", "thinking": "Now let me read the catalog's consumer_loans files and the lending project. Also check the requirements file and progress file.", "thinkingSignature": "reasoning_content"}, {"type": "text", "text": "Now let me read the specific catalog files for consumer loans and the lending project."}, {"type": "toolCall", "id": "call_01a20cbad1067a02a62cc1ee", "name": "read", "arguments": {"path": "/workspace/data-catalog/lending/cards_consumer_credit/consumer_loans.sqrl"}}, {"type": "toolCall", "id": "call_01a20cbad16675d291c05182", "name": "read", "arguments": {"path": "/workspace/data-catalog/lending/cards_consumer_credit/consumer_loans-test.sqrl"}}, {"type": "toolCall", "id": "call_01a20cbad1a27220968506e3", "name": "read", "arguments": {"path": "/workspace/data-catalog/lending/cards_consumer_credit/consumer_loans-prod.sqrl"}}], "api": "openai-completions", "provider": "together", "model": "deepseek-ai/DeepSeek-V4.1-Flash", "usage": {"input": 4280, "output": 199, "cacheRead": 21376, "cacheWrite": 0, "reasoning": 26, "totalTokens": 25855, "cost": {"input": 0.001284, "output": 0.00023879999999999998, "cacheRead": 0.00012825599999999999, "cacheWrite": 0, "total": 0.001651056}}, "stopReason": "toolUse", "timestamp": 1795509898761, "responseId": "60472d022df045a0aae92e9d7f3932a1-aws_ec1", "rawStopReason": "tool_calls", "durationMs": 1110, "thinkingLevel": "high"}, {"role": "toolResult", "toolCallId": "call_01a20cbad1067a02a62cc1ee", "toolName": "read", "content": [{"type": "text", "text": "-- ## Consumer Loans\n--\n-- Personal and auto loan data including loan applications, funded loans,\n-- payment history, and delinquency tracking. Supports the full consumer\n-- lending lifecycle from application through payoff or charge-off.\n-- Data is a CDC stream from source system.\n--\n-- Layer:            bronze\n-- Classification:   Restricted\n-- Regulatory scope: GLBA, GDPR, CCPA, FCRA, TILA, ECOA, SCRA\n\n/** Personal/unsecured loan records.\n    Grain: one row per loan_id.\n\n    # Columns:\n    * loan_id: Unique identifier for the loan\n    * application_id: Reference to application\n    * primary_borrower_customer_id: Reference to primary borrower @pii\n    * loan_number: Loan number displayed to customer @npi @mask\n    * loan_status: Loan status: ACTIVE, PAID_OFF, CHARGED_OFF, SETTLED\n    * loan_purpose: Loan purpose: DEBT_CONSOLIDATION, HOME_IMPROVEMENT, MAJOR_PURCHASE, MEDICAL, VACATION, OTHER\n    * original_amount_cents: Original loan amount in cents @npi @confidential\n    * current_balance_cents: Current principal balance in cents @npi @confidential\n    * interest_rate: Interest rate (APR) @confidential\n    * rate_type: Rate type: FIXED, VARIABLE\n    * original_term_months: Original term in months\n    * remaining_term_months: Remaining term in months\n    * monthly_payment_cents: Monthly payment amount in cents @npi @confidential\n    * funding_date: Date loan was funded\n    * first_payment_date: First payment due date\n    * maturity_date: Maturity date\n    * next_payment_due_date: Next payment due date\n    * paid_off_date: Date loan was paid off\n    * origination_fee_cents: Origination fee in cents\n    * credit_score_at_origination: Credit score at origination @npi @confidential\n    * dti_at_origination: DTI ratio at origination @npi @confidential\n    * autopay_enrolled: Autopay enrolled\n    * disbursement_account_id: Disbursement account @npi\n    * payment_account_id: Payment account @npi\n    * origination_channel: Origination channel: ONLINE, BRANCH, PHONE, PARTNER\n    * source_system: Source system identifier\n    * source_updated_at: Timestamp when record was last updated in source system */\nCREATE TABLE Personal_Loan_schema (\n  loan_id STRING NOT NULL,\n  application_id STRING,\n  primary_borrower_customer_id STRING NOT NULL,\n  loan_number STRING NOT NULL,\n  loan_status STRING NOT NULL,\n  loan_purpose STRING,\n  original_amount_cents BIGINT NOT NULL,\n  current_balance_cents BIGINT NOT NULL,\n  interest_rate DECIMAL(6, 4) NOT NULL,\n  rate_type STRING NOT NULL,\n  original_term_months INT NOT NULL,\n  remaining_term_months INT,\n  monthly_payment_cents BIGINT NOT NULL,\n  funding_date DATE NOT NULL,\n  first_payment_date DATE NOT NULL,\n  maturity_date DATE NOT NULL,\n  next_payment_due_date DATE,\n  paid_off_date DATE,\n  origination_fee_cents BIGINT,\n  credit_score_at_origination INT,\n  dti_at_origination DECIMAL(5, 2),\n  autopay_enrolled BOOLEAN NOT NULL,\n  disbursement_account_id STRING,\n  payment_account_id STRING,\n  origination_channel STRING,\n  source_system STRING NOT NULL,\n  source_updated_at TIMESTAMP_LTZ(3) NOT NULL\n);\n\n/** Auto loan records with vehicle collateral information.\n    Grain: one row per loan_id.\n\n    # Columns:\n    * loan_id: Unique identifier for the loan\n    * application_id: Reference to application\n    * primary_borrower_customer_id: Reference to primary borrower @pii\n    * loan_number: Loan number displayed to customer @npi @mask\n    * loan_status: Loan status: ACTIVE, PAID_OFF, CHARGED_OFF, REPOSSESSED\n    * loan_type: Loan type: NEW_VEHICLE, USED_VEHICLE, REFINANCE, LEASE_BUYOUT\n    * original_amount_cents: Original loan amount in cents @npi @confidential\n    * current_balance_cents: Current principal balance in cents @npi @confidential\n    * interest_rate: Interest rate (APR) @confidential\n    * rate_type: Rate type: FIXED, VARIABLE\n    * original_term_months: Original term in months\n    * remaining_term_months: Remaining term in months\n    * monthly_payment_cents: Monthly payment amount in cents @npi @confidential\n    * funding_date: Date loan was funded\n    * first_payment_date: First payment due date\n    * maturity_date: Maturity date\n    * next_payment_due_date: Next payment due date\n    * paid_off_date: Date loan was paid off\n    * vehicle_vin: Vehicle VIN @pii\n    * vehicle_year: Vehicle year\n    * vehicle_make: Vehicle make\n    * vehicle_model: Vehicle model\n    * vehicle_trim: Vehicle trim\n    * mileage_at_origination: Vehicle mileage at origination\n    * vehicle_condition: Vehicle condition: NEW, USED, CERTIFIED\n    * vehicle_value_at_origination_cents: Vehicle value at origination in cents @npi @confidential\n    * current_vehicle_value_cents: Current estimated vehicle value in cents @npi @confidential\n    * ltv_at_origination: Loan-to-value ratio at origination\n    * current_ltv: Current LTV\n    * dealer_name: Dealer name @pii\n    * dealer_id: Dealer ID\n    * gap_insurance: GAP insurance included\n    * extended_warranty: Extended warranty included\n    * credit_score_at_origination: Credit score at origination @npi @confidential\n    * dti_at_origination: DTI ratio at origination @npi @confidential\n    * title_status: Title status: HELD, RELEASED, DEFECTIVE\n    * lien_state: Lien holder state\n    * autopay_enrolled: Autopay enrolled\n    * source_system: Source system identifier\n    * source_updated_at: Timestamp when record was last updated in source system */\nCREATE TABLE Auto_Loan_schema (\n  loan_id STRING NOT NULL,\n  application_id STRING,\n  primary_borrower_customer_id STRING NOT NULL,\n  loan_number STRING NOT NULL,\n  loan_status STRING NOT NULL,\n  loan_type STRING NOT NULL,\n  original_amount_cents BIGINT NOT NULL,\n  current_balance_cents BIGINT NOT NULL,\n  interest_rate DECIMAL(6, 4) NOT NULL,\n  rate_type STRING NOT NULL,\n  original_term_months INT NOT NULL,\n  remaining_term_months INT,\n  monthly_payment_cents BIGINT NOT NULL,\n  funding_date DATE NOT NULL,\n  first_payment_date DATE NOT NULL,\n  maturity_date DATE NOT NULL,\n  next_payment_due_date DATE,\n  paid_off_date DATE,\n  vehicle_vin STRING NOT NULL,\n  vehicle_year INT NOT NULL,\n  vehicle_make STRING NOT NULL,\n  vehicle_model STRING NOT NULL,\n  vehicle_trim STRING,\n  mileage_at_origination INT,\n  vehicle_condition STRING NOT NULL,\n  vehicle_value_at_origination_cents BIGINT,\n  current_vehicle_value_cents BIGINT,\n  ltv_at_origination DECIMAL(5, 2),\n  current_ltv DECIMAL(5, 2),\n  dealer_name STRING,\n  dealer_id STRING,\n  gap_insurance BOOLEAN,\n  extended_warranty BOOLEAN,\n  credit_score_at_origination INT,\n  dti_at_origination DECIMAL(5, 2),\n  title_status STRING,\n  lien_state STRING,\n  autopay_enrolled BOOLEAN NOT NULL,\n  source_system STRING NOT NULL,\n  source_updated_at TIMESTAMP_LTZ(3) NOT NULL\n);\n\n/** Consumer loan payment records (personal and auto).\n    Grain: one row per payment_id.\n\n    # Columns:\n    * payment_id: Unique identifier for the payment\n    * loan_id: Reference to loan\n    * loan_type: Loan type: PERSONAL, AUTO\n    * payment_amount_cents: Payment amount in cents @npi @confidential\n    * principal_cents: Principal portion in cents @npi @confidential\n    * interest_cents: Interest portion in cents @npi @confidential\n    * late_fee_cents: Late fee amount in cents\n    * other_fees_cents: Other fees in cents\n    * payment_type: Payment type: REGULAR, EXTRA_PRINCIPAL, PAYOFF, PARTIAL\n    * payment_status: Payment status: APPLIED, PENDING, RETURNED, REVERSED\n    * due_date: Date payment was due\n    * received_date: Date payment was received\n    * applied_date: Date payment was applied\n    * payment_method: Payment method: ACH, CHECK, DEBIT_CARD, ONLINE\n    * principal_balance_after_cents: Principal balance after payment in cents @npi @confidential\n    * days_past_due_at_payment: Days past due at time of payment\n    * confirmation_number: Confirmation number\n    * return_reason_code: Return reason code (if returned)\n    * source_system: Source system identifier\n    * source_updated_at: Timestamp when record was last updated in source system */\nCREATE TABLE Loan_Payment_schema (\n  payment_id STRING NOT NULL,\n  loan_id STRING NOT NULL,\n  loan_type STRING NOT NULL,\n  payment_amount_cents BIGINT NOT NULL,\n  principal_cents BIGINT,\n  interest_cents BIGINT,\n  late_fee_cents BIGINT,\n  other_fees_cents BIGINT,\n  payment_type STRING NOT NULL,\n  payment_status STRING NOT NULL,\n  due_date DATE NOT NULL,\n  received_date DATE,\n  applied_date DATE,\n  payment_method STRING,\n  principal_balance_after_cents BIGINT,\n  days_past_due_at_payment INT,\n  confirmation_number STRING,\n  return_reason_code STRING,\n  source_system STRING NOT NULL,\n  source_updated_at TIMESTAMP_LTZ(3) NOT NULL\n);\n\n/** Consumer loan application records.\n    Grain: one row per application_id.\n\n    # Columns:\n    * application_id: Unique identifier for the application\n    * primary_applicant_customer_id: Reference to primary applicant @pii\n    * co_applicant_customer_id: Reference to co-applicant (if applicable) @pii\n    * loan_type: Loan type: PERSONAL, AUTO\n    * loan_purpose: Loan purpose: DEBT_CONSOLIDATION, HOME_IMPROVEMENT, VEHICLE_PURCHASE, REFINANCE, OTHER\n    * requested_amount_cents: Requested loan amount in cents @npi @confidential\n    * requested_term_months: Requested term in months\n    * application_status: Application status: SUBMITTED, IN_REVIEW, APPROVED, COUNTER_OFFER, DENIED, WITHDRAWN, FUNDED\n    * submitted_at: Date application was submitted\n    * decision_date: Date decision was made\n    * decision_type: Decision type: APPROVED, DENIED, COUNTER_OFFER\n    * approved_amount_cents: Approved amount in cents @npi @confidential\n    * approved_rate: Approved rate @confidential\n    * approved_term_months: Approved term in months\n    * denial_reasons: Denial reason codes (if denied) @confidential\n    * credit_score: Credit score at application @npi @confidential\n    * annual_income_cents: Annual income stated @npi @confidential\n    * monthly_debt_cents: Monthly debt obligations @npi @confidential\n    * dti_ratio: DTI ratio calculated @npi @confidential\n    * employment_status: Employment status: EMPLOYED, SELF_EMPLOYED, RETIRED, OTHER\n    * employer_name: Employer name @pii\n    * years_employed: Years at current employer\n    * origination_channel: Origination channel: ONLINE, BRANCH, PHONE, DEALER, PARTNER\n    * promo_code: Promo code applied\n    * funded_date: Date application was funded\n    * source_system: Source system identifier\n    * source_updated_at: Timestamp when record was last updated in source system */\nCREATE TABLE Loan_Application_schema (\n  application_id STRING NOT NULL,\n  primary_applicant_customer_id STRING NOT NULL,\n  co_applicant_customer_id STRING,\n  loan_type STRING NOT NULL,\n  loan_purpose STRING,\n  requested_amount_cents BIGINT NOT NULL,\n  requested_term_months INT,\n  application_status STRING NOT NULL,\n  submitted_at TIMESTAMP_LTZ(3) NOT NULL,\n  decision_date DATE,\n  decision_type STRING,\n  approved_amount_cents BIGINT,\n  approved_rate DECIMAL(6, 4),\n  approved_term_months INT,\n  denial_reasons STRING,\n  credit_score INT,\n  annual_income_cents BIGINT,\n  monthly_debt_cents BIGINT,\n  dti_ratio DECIMAL(5, 2),\n  employment_status STRING,\n  employer_name STRING,\n  years_employed INT,\n  origination_channel STRING,\n  promo_code STRING,\n  funded_date DATE,\n  source_system STRING NOT NULL,\n  source_updated_at TIMESTAMP_LTZ(3) NOT NULL\n);\n\n/** Consumer loan delinquency events.\n    Grain: one row per delinquency_event_id.\n\n    # Columns:\n    * delinquency_event_id: Unique identifier for the delinquency event\n    * loan_id: Reference to loan\n    * loan_type: Loan type: PERSONAL, AUTO\n    * customer_id: Reference to customer @pii\n    * event_type: Event type: MISSED_PAYMENT, DELINQUENCY_START, DELINQUENCY_CURED, CHARGE_OFF, REPOSSESSION, COLLECTION_ASSIGNED, RECOVERY\n    * days_past_due: Days past due at event\n    * delinquency_bucket: Delinquency bucket: CURRENT, 30_DAY, 60_DAY, 90_DAY, 120_PLUS\n    * amount_past_due_cents: Amount past due in cents @npi @confidential\n    * total_balance_cents: Total balance at event in cents @npi @confidential\n    * event_date: Event date\n    * cured_date: Date cured (if applicable)\n    * collection_action: Collection action taken @confidential\n    * collection_agency: Collection agency assigned\n    * repossession_date: Repossession date (for auto)\n    * repossession_agency: Repossession agency\n    * sale_date: Sale date (for repo)\n    * sale_amount_cents: Sale amount in cents\n    * deficiency_balance_cents: Deficiency balance in cents @npi @confidential\n    * charge_off_date: Charge-off date\n    * charge_off_amount_cents: Charge-off amount in cents @npi @confidential\n    * recovery_amount_cents: Recovery amount in cents\n    * source_system: Source system identifier\n    * source_updated_at: Timestamp when record was last updated in source system */\nCREATE TABLE Consumer_Loan_Delinquency_Event_schema (\n  delinquency_event_id STRING NOT NULL,\n  loan_id STRING NOT NULL,\n  loan_type STRING NOT NULL,\n  customer_id STRING NOT NULL,\n  event_type STRING NOT NULL,\n  days_past_due INT NOT NULL,\n  delinquency_bucket STRING NOT NULL,\n  amount_past_due_cents BIGINT,\n  total_balance_cents BIGINT,\n  event_date DATE NOT NULL,\n  cured_date DATE,\n  collection_action STRING,\n  collection_agency STRING,\n  repossession_date DATE,\n  repossession_agency STRING,\n  sale_date DATE,\n  sale_amount_cents BIGINT,\n  deficiency_balance_cents BIGINT,\n  charge_off_date DATE,\n  charge_off_amount_cents BIGINT,\n  recovery_amount_cents BIGINT,\n  source_system STRING NOT NULL,\n  source_updated_at TIMESTAMP_LTZ(3) NOT NULL\n);\n"}], "isError": false, "durationMs": 7, "timestamp": 1795509899881}, {"role": "toolResult", "toolCallId": "call_01a20cbad16675d291c05182", "toolName": "read", "content": [{"type": "text", "text": "-- ## Consumer Loans - Test Data\n--\n-- Use local filesystem data for testing\n\nIMPORT consumer_loans.*;\n\nCREATE TABLE Personal_Loan (\n  /** Timestamp when record was ingested into the data platform */\n  ingested_at TIMESTAMP_LTZ(3) NOT NULL,\n  WATERMARK FOR ingested_at AS ingested_at - INTERVAL '10' SECOND\n) WITH (\n    'connector' = 'filesystem',\n    'path' = '${DATA_PATH}/consumer_loans-personal_loan.jsonl',\n{{^is_batch}}\n    'source.monitor-interval' = '10 min',\n{{/is_batch}}\n    'format' = 'json',\n    'json.timestamp-format.standard' = 'ISO-8601'\n) LIKE Personal_Loan_schema;\n\nCREATE TABLE Auto_Loan (\n  /** Timestamp when record was ingested into the data platform */\n  ingested_at TIMESTAMP_LTZ(3) NOT NULL,\n  WATERMARK FOR ingested_at AS ingested_at - INTERVAL '10' SECOND\n) WITH (\n    'connector' = 'filesystem',\n    'path' = '${DATA_PATH}/consumer_loans-auto_loan.jsonl',\n{{^is_batch}}\n    'source.monitor-interval' = '10 min',\n{{/is_batch}}\n    'format' = 'json',\n    'json.timestamp-format.standard' = 'ISO-8601'\n) LIKE Auto_Loan_schema;\n\nCREATE TABLE Loan_Payment (\n  /** Timestamp when record was ingested into the data platform */\n  ingested_at TIMESTAMP_LTZ(3) NOT NULL,\n  WATERMARK FOR ingested_at AS ingested_at - INTERVAL '10' SECOND\n) WITH (\n    'connector' = 'filesystem',\n    'path' = '${DATA_PATH}/consumer_loans-loan_payment.jsonl',\n{{^is_batch}}\n    'source.monitor-interval' = '10 min',\n{{/is_batch}}\n    'format' = 'json',\n    'json.timestamp-format.standard' = 'ISO-8601'\n) LIKE Loan_Payment_schema;\n\nCREATE TABLE Loan_Application (\n  /** Timestamp when record was ingested into the data platform */\n  ingested_at TIMESTAMP_LTZ(3) NOT NULL,\n  WATERMARK FOR ingested_at AS ingested_at - INTERVAL '10' SECOND\n) WITH (\n    'connector' = 'filesystem',\n    'path' = '${DATA_PATH}/consumer_loans-loan_application.jsonl',\n{{^is_batch}}\n    'source.monitor-interval' = '10 min',\n{{/is_batch}}\n    'format' = 'json',\n    'json.timestamp-format.standard' = 'ISO-8601'\n) LIKE Loan_Application_schema;\n\nCREATE TABLE Consumer_Loan_Delinquency_Event (\n  /** Timestamp when record was ingested into the data platform */\n  ingested_at TIMESTAMP_LTZ(3) NOT NULL,\n  WATERMARK FOR ingested_at AS ingested_at - INTERVAL '10' SECOND\n) WITH (\n    'connector' = 'filesystem',\n    'path' = '${DATA_PATH}/consumer_loans-consumer_loan_delinquency_event.jsonl',\n{{^is_batch}}\n    'source.monitor-interval' = '10 min',\n{{/is_batch}}\n    'format' = 'json',\n    'json.timestamp-format.standard' = 'ISO-8601'\n) LIKE Consumer_Loan_Delinquency_Event_schema;\n"}], "isError": false, "durationMs": 7, "timestamp": 1795509899881}, {"role": "toolResult", "toolCallId": "call_01a20cbad1a27220968506e3", "toolName": "read", "content": [{"type": "text", "text": "-- ## Consumer Loans - Production\n--\n-- Ingests source data from Kafka\n\nIMPORT consumer_loans.*;\n\nCREATE TABLE Personal_Loan (\n  /** Timestamp when record was ingested into the data platform */\n  ingested_at TIMESTAMP_LTZ(3) METADATA FROM 'timestamp',\n  WATERMARK FOR ingested_at AS ingested_at - INTERVAL '30' SECOND\n) WITH (\n    'connector' = 'kafka-safe',\n    'properties.bootstrap.servers' = '${LENDING_KAFKA_BROKERS}',\n    'properties.group.id' = '${DEPLOYMENT_ID}',\n    'topic' = 'consumer_loans.personal_loan',\n    'scan.startup.mode' = 'earliest-offset',\n{{#is_batch}}\n    'scan.bounded.mode' = 'latest-offset',\n{{/is_batch}}\n    'value.format' = 'json',\n    'value.json.timestamp-format.standard' = 'ISO-8601'\n) LIKE Personal_Loan_schema;\n\nCREATE TABLE Auto_Loan (\n  /** Timestamp when record was ingested into the data platform */\n  ingested_at TIMESTAMP_LTZ(3) METADATA FROM 'timestamp',\n  WATERMARK FOR ingested_at AS ingested_at - INTERVAL '30' SECOND\n) WITH (\n    'connector' = 'kafka-safe',\n    'properties.bootstrap.servers' = '${LENDING_KAFKA_BROKERS}',\n    'properties.group.id' = '${DEPLOYMENT_ID}',\n    'topic' = 'consumer_loans.auto_loan',\n    'scan.startup.mode' = 'earliest-offset',\n{{#is_batch}}\n    'scan.bounded.mode' = 'latest-offset',\n{{/is_batch}}\n    'value.format' = 'json',\n    'value.json.timestamp-format.standard' = 'ISO-8601'\n) LIKE Auto_Loan_schema;\n\nCREATE TABLE Loan_Payment (\n  /** Timestamp when record was ingested into the data platform */\n  ingested_at TIMESTAMP_LTZ(3) METADATA FROM 'timestamp',\n  WATERMARK FOR ingested_at AS ingested_at - INTERVAL '30' SECOND\n) WITH (\n    'connector' = 'kafka-safe',\n    'properties.bootstrap.servers' = '${LENDING_KAFKA_BROKERS}',\n    'properties.group.id' = '${DEPLOYMENT_ID}',\n    'topic' = 'consumer_loans.loan_payment',\n    'scan.startup.mode' = 'earliest-offset',\n{{#is_batch}}\n    'scan.bounded.mode' = 'latest-offset',\n{{/is_batch}}\n    'value.format' = 'json',\n    'value.json.timestamp-format.standard' = 'ISO-8601'\n) LIKE Loan_Payment_schema;\n\nCREATE TABLE Loan_Application (\n  /** Timestamp when record was ingested into the data platform */\n  ingested_at TIMESTAMP_LTZ(3) METADATA FROM 'timestamp',\n  WATERMARK FOR ingested_at AS ingested_at - INTERVAL '30' SECOND\n) WITH (\n    'connector' = 'kafka-safe',\n    'properties.bootstrap.servers' = '${LENDING_KAFKA_BROKERS}',\n    'properties.group.id' = '${DEPLOYMENT_ID}',\n    'topic' = 'consumer_loans.loan_application',\n    'scan.startup.mode' = 'earliest-offset',\n{{#is_batch}}\n    'scan.bounded.mode' = 'latest-offset',\n{{/is_batch}}\n    'value.format' = 'json',\n    'value.json.timestamp-format.standard' = 'ISO-8601'\n) LIKE Loan_Application_schema;\n\nCREATE TABLE Consumer_Loan_Delinquency_Event (\n  /** Timestamp when record was ingested into the data platform */\n  ingested_at TIMESTAMP_LTZ(3) METADATA FROM 'timestamp',\n  WATERMARK FOR ingested_at AS ingested_at - INTERVAL '30' SECOND\n) WITH (\n    'connector' = 'kafka-safe',\n    'properties.bootstrap.servers' = '${LENDING_KAFKA_BROKERS}',\n    'properties.group.id' = '${DEPLOYMENT_ID}',\n    'topic' = 'consumer_loans.consumer_loan_delinquency_event',\n    'scan.startup.mode' = 'earliest-offset',\n{{#is_batch}}\n    'scan.bounded.mode' = 'latest-offset',\n{{/is_batch}}\n    'value.format' = 'json',\n    'value.json.timestamp-format.standard' = 'ISO-8601'\n) LIKE Consumer_Loan_Delinquency_Event_schema;\n"}], "isError": false, "durationMs": 7, "timestamp": 1795509899882}, {"role": "assistant", "content": [{"type": "thinking", "thinking": "Now let's read the lending project's scripts and package configs. This is the sibling reference. Let me read the lending360.sqrl and package configs, plus README.", "thinkingSignature": "reasoning_content"}, {"type": "text", "text": "Now the sibling `lending/` project, which is the reference."}, {"type": "toolCall", "id": "call_01a20cbad51c7fe39bf679a4", "name": "read", "arguments": {"path": "/workspace/lending/lending360.sqrl"}}, {"type": "toolCall", "id": "call_01a20cbad5487e91a10b4eed", "name": "bash", "arguments": {"command": "cd /workspace/lending && ls -la && echo \"===SHARED===\" && cat lending360-shared-package.json && echo \"===TEST===\" && cat lending360-test-package.json && echo \"===PROD===\" && cat lending360-prod-package.json"}}], "api": "openai-completions", "provider": "together", "model": "deepseek-ai/DeepSeek-V4.1-Flash", "usage": {"input": 5562, "output": 186, "cacheRead": 25728, "cacheWrite": 0, "reasoning": 38, "totalTokens": 31476, "cost": {"input": 0.0016686, "output": 0.00022319999999999998, "cacheRead": 0.000154368, "cacheWrite": 0, "total": 0.002046168}}, "stopReason": "toolUse", "timestamp": 1795509899884, "responseId": "fc4d1f7962494d42b95f29ea1bda0691-aws_ec1", "rawStopReason": "tool_calls", "durationMs": 961, "thinkingLevel": "high"}, {"role": "toolResult", "toolCallId": "call_01a20cbad51c7fe39bf679a4", "toolName": "read", "content": [{"type": "text", "text": "-- Lending 360: Unified customer-facing view of all active lending instruments.\n-- Brings together mortgages, consumer loans (personal + auto), and credit cards\n-- into a coherent picture for each customer, including consolidated payment history.\n\nIMPORT data-catalog.lending.mortgages.mortgage_originations-{{environment}} AS mort_orig;\nIMPORT data-catalog.lending.mortgages.mortgage_servicing-{{environment}} AS mort_svc;\nIMPORT data-catalog.lending.cards_consumer_credit.consumer_loans-{{environment}} AS cons_loans;\nIMPORT data-catalog.lending.cards_consumer_credit.credit_cards-{{environment}} AS cc;\nIMPORT data-catalog.customer.customer_data.customer_master-{{environment}} AS cust_data;\n\n-- Deduplicate CDC streams: retain only the latest record per primary key\n\n_LatestMortgageLoan := DISTINCT mort_orig.Mortgage_Loan ON loan_id ORDER BY source_updated_at DESC;\n_LatestCreditCardAccount := DISTINCT cc.Credit_Card_Account ON credit_card_account_id ORDER BY source_updated_at DESC;\n_LatestPersonalLoan := DISTINCT cons_loans.Personal_Loan ON loan_id ORDER BY source_updated_at DESC;\n_LatestAutoLoan := DISTINCT cons_loans.Auto_Loan ON loan_id ORDER BY source_updated_at DESC;\n_LatestCustomer := DISTINCT cust_data.Customer ON customer_id ORDER BY source_updated_at DESC;\n\n/** Active mortgage loans with key terms for customer display. */\n/*+query_by_any(loan_id, customer_id) */\nMortgage := SELECT loan_id, loan_number,\n                   primary_borrower_customer_id AS customer_id,\n                   loan_status, loan_program, lien_position, loan_purpose, occupancy_type,\n                   rate_type, interest_rate, original_principal_cents, current_principal_cents,\n                   original_term_months, remaining_term_months, monthly_pi_payment_cents,\n                   total_monthly_payment_cents, funding_date, first_payment_date,\n                   maturity_date, next_payment_due_date\n            FROM _LatestMortgageLoan\n            WHERE loan_status = 'ACTIVE'\n            ORDER BY funding_date DESC, loan_id;\n\n/** Active credit card accounts with current balance and credit terms. */\n/*+query_by_any(credit_card_account_id, customer_id) */\nCreditCard := SELECT credit_card_account_id, account_number,\n                     primary_customer_id AS customer_id,\n                     product_name, account_status, credit_limit_cents, available_credit_cents,\n                     current_balance_cents, minimum_payment_due_cents, payment_due_date,\n                     purchase_apr, opened_date, autopay_enrolled, rewards_program, rewards_balance\n              FROM _LatestCreditCardAccount\n              WHERE account_status = 'OPEN'\n              ORDER BY opened_date DESC, credit_card_account_id;\n\n-- Combine personal and auto loans into a common schema for the ConsumerLoan table.\n-- loan_purpose is null for auto loans since that concept maps to loan_type there.\n_ConsumerLoanRaw :=\n    SELECT loan_id, loan_number,\n           primary_borrower_customer_id AS customer_id,\n           'PERSONAL' AS loan_type, loan_purpose,\n           original_amount_cents, current_balance_cents,\n           interest_rate, rate_type, monthly_payment_cents,\n           original_term_months, remaining_term_months,\n           funding_date, maturity_date, next_payment_due_date, autopay_enrolled\n    FROM _LatestPersonalLoan\n    WHERE loan_status = 'ACTIVE'\n    UNION ALL\n    SELECT loan_id, loan_number,\n           primary_borrower_customer_id AS customer_id,\n           'AUTO' AS loan_type, CAST(NULL AS STRING) AS loan_purpose,\n           original_amount_cents, current_balance_cents,\n           interest_rate, rate_type, monthly_payment_cents,\n           original_term_months, remaining_term_months,\n           funding_date, maturity_date, next_payment_due_date, autopay_enrolled\n    FROM _LatestAutoLoan\n    WHERE loan_status = 'ACTIVE';\n\n/** Active personal and auto loans in a unified view with common lending attributes. */\n/*+query_by_any(loan_id, customer_id) */\nConsumerLoan := SELECT * FROM _ConsumerLoanRaw ORDER BY funding_date DESC, loan_id;\n\n/** Basic customer profile without sensitive PII (SSN, TIN, and date of birth are excluded). */\n/*+query_by_any(customer_id) */\nCustomer := SELECT customer_id, first_name, last_name, name_suffix,\n                   customer_type, customer_status, relationship_start_date,\n                   citizenship_country, preferred_language\n            FROM _LatestCustomer\n            WHERE customer_status = 'ACTIVE'\n            ORDER BY customer_id;\n\n/** Active mortgages owned by this customer. */\nCustomer.mortgages := SELECT * FROM Mortgage m WHERE m.customer_id = this.customer_id ORDER BY m.funding_date DESC;\n/** Active credit card accounts owned by this customer. */\nCustomer.credit_cards := SELECT * FROM CreditCard c WHERE c.customer_id = this.customer_id ORDER BY c.opened_date DESC;\n/** Active consumer loans (personal and auto) owned by this customer. */\nCustomer.consumer_loans := SELECT * FROM ConsumerLoan l WHERE l.customer_id = this.customer_id ORDER BY l.funding_date DESC;\n\n-- Lookup table mapping loan_id to customer_id across both personal and auto loan types.\n-- Used to enrich payment records, which do not carry customer_id directly.\n_ConsumerLoanLookup :=\n    SELECT loan_id, primary_borrower_customer_id AS customer_id\n    FROM _LatestPersonalLoan\n    UNION ALL\n    SELECT loan_id, primary_borrower_customer_id AS customer_id\n    FROM _LatestAutoLoan;\n\n-- Mortgage payments enriched with customer_id from the loan record\n_MortgagePayments :=\n    SELECT mp.payment_id,\n           'MORTGAGE' AS instrument_type,\n           mp.loan_id AS instrument_id,\n           ml.primary_borrower_customer_id AS customer_id,\n           mp.payment_amount_cents,\n           mp.payment_type,\n           mp.payment_status,\n           mp.received_date AS payment_date,\n           mp.principal_cents,\n           mp.interest_cents,\n           mp.ingested_at\n    FROM mort_svc.Mortgage_Payment mp\n    JOIN _LatestMortgageLoan ml ON mp.loan_id = ml.loan_id;\n\n-- Consumer loan payments (personal + auto) enriched with customer_id\n_ConsumerLoanPayments :=\n    SELECT lp.payment_id,\n           CASE lp.loan_type WHEN 'PERSONAL' THEN 'PERSONAL_LOAN' ELSE 'AUTO_LOAN' END AS instrument_type,\n           lp.loan_id AS instrument_id,\n           cl.customer_id,\n           lp.payment_amount_cents,\n           lp.payment_type,\n           lp.payment_status,\n           lp.received_date AS payment_date,\n           lp.principal_cents,\n           lp.interest_cents,\n           lp.ingested_at\n    FROM cons_loans.Loan_Payment lp\n    JOIN _ConsumerLoanLookup cl ON lp.loan_id = cl.loan_id;\n\n-- Credit card payments enriched with customer_id from the account record\n_CreditCardPayments :=\n    SELECT ccp.payment_id,\n           'CREDIT_CARD' AS instrument_type,\n           ccp.credit_card_account_id AS instrument_id,\n           cca.primary_customer_id AS customer_id,\n           ccp.payment_amount_cents,\n           ccp.payment_type,\n           ccp.payment_status,\n           ccp.received_date AS payment_date,\n           CAST(NULL AS BIGINT) AS principal_cents,\n           CAST(NULL AS BIGINT) AS interest_cents,\n           ccp.ingested_at\n    FROM cc.Credit_Card_Payment ccp\n    JOIN _LatestCreditCardAccount cca ON ccp.credit_card_account_id = cca.credit_card_account_id;\n\n_AllPayments :=\n    SELECT payment_id, instrument_type, instrument_id, customer_id,\n           payment_amount_cents, payment_type, payment_status,\n           payment_date, principal_cents, interest_cents, ingested_at\n    FROM _MortgagePayments\n    UNION ALL\n    SELECT payment_id, instrument_type, instrument_id, customer_id,\n           payment_amount_cents, payment_type, payment_status,\n           payment_date, principal_cents, interest_cents, ingested_at\n    FROM _ConsumerLoanPayments\n    UNION ALL\n    SELECT payment_id, instrument_type, instrument_id, customer_id,\n           payment_amount_cents, payment_type, payment_status,\n           payment_date, principal_cents, interest_cents, ingested_at\n    FROM _CreditCardPayments;\n\n/** All loan payments across mortgages, consumer loans, and credit cards.\n    Allows customers to see a unified payment history across all their lending instruments.\n    instrument_type values: MORTGAGE, PERSONAL_LOAN, AUTO_LOAN, CREDIT_CARD */\n/*+query_by_all(customer_id) */\nConsolidatedLoanPayments := SELECT * FROM _AllPayments ORDER BY payment_date DESC, payment_id;\n\n-- Test queries: validate key tables using known test data values\n\n/*+test */\nMortgage_Test := SELECT loan_id, loan_number, customer_id, loan_status, loan_program,\n                        interest_rate, current_principal_cents, total_monthly_payment_cents,\n                        next_payment_due_date\n                 FROM Mortgage WHERE customer_id = 'CUST-001' ORDER BY loan_id;\n\n/*+test */\nCreditCard_Test := SELECT credit_card_account_id, account_number, customer_id, product_name,\n                          current_balance_cents, credit_limit_cents, payment_due_date, purchase_apr\n                   FROM CreditCard WHERE customer_id = 'CUST-001' ORDER BY credit_card_account_id;\n\n/*+test */\nConsumerLoan_Test := SELECT loan_id, loan_number, customer_id, loan_type, loan_purpose,\n                            current_balance_cents, interest_rate, monthly_payment_cents,\n                            next_payment_due_date\n                     FROM ConsumerLoan WHERE customer_id = 'CUST-001' ORDER BY loan_id;\n\n/*+test */\nCustomer_Test := SELECT customer_id, first_name, last_name, customer_type, customer_status,\n                        relationship_start_date, preferred_language\n                 FROM Customer WHERE customer_id = 'CUST-001' ORDER BY customer_id;\n\n/*+test */\nConsolidatedLoanPayments_Test := SELECT payment_id, instrument_type, instrument_id, customer_id,\n                                        payment_amount_cents, payment_type, payment_status, payment_date\n                                 FROM ConsolidatedLoanPayments WHERE customer_id = 'CUST-001'\n                                 ORDER BY payment_id;\n"}], "isError": false, "durationMs": 6, "timestamp": 1795509900856}, {"role": "toolResult", "toolCallId": "call_01a20cbad5487e91a10b4eed", "toolName": "bash", "content": [{"type": "text", "text": "total 28\ndrwxr-xr-x  9 root root   288 Nov 24 08:27 .\ndrwxr-xr-x 11 root root   352 Nov 24 08:28 ..\ndrwxr-xr-x  5 root root   160 Nov 24 08:27 lending360-api\n-rw-r--r--  1 root root    72 Nov 24 08:27 lending360-prod-package.json\n-rw-r--r--  1 root root   910 Nov 24 08:27 lending360-shared-package.json\n-rw-r--r--  1 root root 10057 Nov 24 08:27 lending360.sqrl\n-rw-r--r--  1 root root   353 Nov 24 08:27 lending360-test-package.json\n-rw-r--r--  1 root root  3417 Nov 24 08:27 README.md\ndrwxr-xr-x  3 root root    96 Nov 24 08:27 snapshots\n===SHARED===\n{\n  \"version\": \"1\",\n  \"enabled-engines\": [\"flink\", \"postgres\", \"kafka\", \"vertx\"],\n  \"script\": {\n    \"main\": \"lending360.sqrl\",\n    \"include\": {\n      \"data-catalog\": {\n        \"package\": \"../data-catalog/ontology-test-package.json\",\n        \"config\": {\n          \"is_batch\": false\n        }\n      }\n    },\n    \"api\": {\n      \"v1\": {\n        \"schema\": \"lending360-api/schema.v1.graphqls\",\n        \"operations\": [\"lending360-api/operations.v1.graphql\"]\n      }\n    }\n  },\n  \"engines\": {\n    \"flink\": {\n      \"config\": {\n        \"execution.runtime-mode\": \"STREAMING\",\n        \"table.exec.source.idle-timeout\": \"30 s\"\n      }\n    }\n  },\n  \"compiler\": {\n    \"predicate-pushdown-rules\": \"LIMITED_RULES\",\n    \"api\": {\n      \"protocols\": [\n        \"GRAPHQL\",\n        \"REST\",\n        \"MCP\"\n      ],\n      \"endpoints\": \"FULL\",\n      \"add-prefix\": true,\n      \"max-result-depth\": 2,\n      \"default-limit\": 20\n    }\n  }\n}\n===TEST===\n{\n  \"script\": {\n    \"config\": {\n      \"environment\": \"test\"\n    }\n  },\n  \"engines\": {\n    \"flink\": {\n      \"config\": {\n        \"table.exec.source.idle-timeout\": \"1 s\"\n      }\n    }\n  },\n  \"test-runner\": {\n    \"delay-sec\": -1,\n    \"required-checkpoints\": 1,\n    \"snapshot-folder\": \"snapshots/lending360/\",\n    \"test-folder\": \"lending360-api/tests\"\n  }\n}\n===PROD===\n{\n  \"script\": {\n    \"config\": {\n      \"environment\": \"prod\"\n    }\n  }\n}\n"}], "isError": false, "durationMs": 9, "timestamp": 1795509900857}, {"role": "assistant", "content": [{"type": "thinking", "thinking": "There's an important discrepancy. The requirements say include path should be `../data-catalog/ontology-shared-package.json` but the lending reference uses `../data-catalog/ontology-test-package.json`. The inventory example also says the shared module example package is `../data-catalog/ontology-shared-package.json`. The task context says the `data_catalog` namespace with package `../data-catalog/ontology-shared-package.json`. But the lending project uses namespace `data-catalog` (with dash) and package `ontology-test-package.json`.\n\nHmm. The task context example says namespace `data_catalog` (underscores preferred). Let me note. The requirements say \"A test and a prod environment, with the same layout as the sibling project lending/\". So likely follow lending's layout but configure the include appropriately. The task context explicitly gives the example with `data_catalog` namespace and `../data-catalog/ontology-shared-package.json`.\n\nWait \u2014 there's a subtlety: `ontology-shared-package.json` vs `ontology-test-package.json`. The include package file's folder is used as include root, so either works. But the module's own scripts contain `{{environment}}` placeholders. The included module config must supply `environment` (and `is_batch`). Let me check the catalog's package files.\n\nAlso note the lending project does NOT import `data_catalog` namespace; it imports `data-catalog.lending...`. The namespace is the include key. In lending's shared package the key is `data-catalog`. So the import is `data-catalog.<...>`.\n\nThe task context says prefer underscores: `data_catalog`. I'll use that. But the requirements say same layout as lending. Hmm, need to decide. The task-context's \"Shared modules\" section is authoritative for this planning agent: declare `\"data_catalog\": { \"package\": \"../data-catalog/ontology-shared-package.json\" }`. I'll follow that.\n\nNow let's read the API schema and operations and tests folder of lending. Also read catalog package files and ontology.\n\nLet me also check the loan-payments progress file and requirements file (already given in prompt but let me check the actual file). Also check the requirements file content matches. And check the .datasqrl progress.", "thinkingSignature": "reasoning_content"}, {"type": "toolCall", "id": "call_01a20cbadd3f7341826c8df0", "name": "bash", "arguments": {"command": "cd /workspace/lending && echo \"===API DIR===\" && find lending360-api -type f | head -50 && echo \"===SCHEMA===\" && cat lending360-api/schema.v1.graphqls && echo \"===OPS===\" && cat lending360-api/operations.v1.graphql && echo \"===TESTS===\" && find lending360-api/tests -type f | head -50"}}, {"type": "toolCall", "id": "call_01a20cbaddb072728cdf694e", "name": "bash", "arguments": {"command": "cd /workspace/data-catalog && echo \"===SHARED PKG===\" && cat ontology-shared-package.json && echo \"===TEST PKG===\" && cat ontology-test-package.json && echo \"===ONTOLOGY HEAD===\" && head -80 ontology.sqrl"}}], "api": "openai-completions", "provider": "together", "model": "deepseek-ai/DeepSeek-V4.1-Flash", "usage": {"input": 3079, "output": 697, "cacheRead": 31360, "cacheWrite": 0, "reasoning": 487, "totalTokens": 35136, "cost": {"input": 0.0009237, "output": 0.0008364, "cacheRead": 0.00018816, "cacheWrite": 0, "total": 0.0019482599999999998}}, "stopReason": "toolUse", "timestamp": 1795509900859, "responseId": "c49b5239acba440093aa89150666c211-aws_ec1", "rawStopReason": "tool_calls", "durationMs": 2132, "thinkingLevel": "high"}, {"role": "toolResult", "toolCallId": "call_01a20cbadd3f7341826c8df0", "toolName": "bash", "content": [{"type": "text", "text": "===API DIR===\nlending360-api/operations.v1.graphql\nlending360-api/tests/payment-history.graphql\nlending360-api/tests/customer-lending.graphql\nlending360-api/schema.v1.graphqls\n===SCHEMA===\ntype Customer {\n  customer_id: String!\n  first_name: String!\n  last_name: String!\n  name_suffix: String\n  customer_type: String!\n  customer_status: String!\n  relationship_start_date: Date!\n  citizenship_country: String\n  preferred_language: String\n  mortgages(limit: Int = 10, offset: Int = 0): [Mortgage!]\n  credit_cards(limit: Int = 10, offset: Int = 0): [CreditCard!]\n  consumer_loans(limit: Int = 10, offset: Int = 0): [ConsumerLoan!]\n}\n\ntype Mortgage {\n  loan_id: String!\n  loan_number: String!\n  customer_id: String!\n  loan_status: String!\n  loan_program: String\n  lien_position: String!\n  loan_purpose: String\n  occupancy_type: String\n  rate_type: String!\n  interest_rate: Float!\n  original_principal_cents: Long!\n  current_principal_cents: Long!\n  original_term_months: Int!\n  remaining_term_months: Int\n  monthly_pi_payment_cents: Long!\n  total_monthly_payment_cents: Long!\n  funding_date: Date!\n  first_payment_date: Date!\n  maturity_date: Date!\n  next_payment_due_date: Date\n}\n\ntype CreditCard {\n  credit_card_account_id: String!\n  account_number: String!\n  customer_id: String!\n  product_name: String\n  account_status: String!\n  credit_limit_cents: Long!\n  available_credit_cents: Long\n  current_balance_cents: Long!\n  minimum_payment_due_cents: Long\n  payment_due_date: Date\n  purchase_apr: Float!\n  opened_date: Date!\n  autopay_enrolled: Boolean!\n  rewards_program: String\n  rewards_balance: Long\n}\n\ntype ConsumerLoan {\n  loan_id: String!\n  loan_number: String!\n  customer_id: String!\n  loan_type: String!\n  loan_purpose: String\n  original_amount_cents: Long!\n  current_balance_cents: Long!\n  interest_rate: Float!\n  rate_type: String!\n  monthly_payment_cents: Long!\n  original_term_months: Int!\n  remaining_term_months: Int\n  funding_date: Date!\n  maturity_date: Date!\n  next_payment_due_date: Date\n  autopay_enrolled: Boolean!\n}\n\ntype ConsolidatedLoanPayments {\n  payment_id: String!\n  instrument_type: String!\n  instrument_id: String!\n  customer_id: String!\n  payment_amount_cents: Long!\n  payment_type: String!\n  payment_status: String!\n  payment_date: Date\n  principal_cents: Long\n  interest_cents: Long\n}\n\n\"An RFC-3339 compliant Full Date Scalar\"\nscalar Date\n\n\"A DateTime scalar that handles both full RFC3339 and shorter timestamp formats\"\nscalar DateTime\n\n\"A 64-bit signed integer\"\nscalar Long\n\ntype Query {\n  \"Basic customer profile (no sensitive PII) with relationships to all active lending instruments.\"\n  Customer(customer_id: String, limit: Int = 10, offset: Int = 0): [Customer!]\n  \"Active mortgage loans, queryable by loan or customer.\"\n  Mortgage(loan_id: String, customer_id: String, limit: Int = 10, offset: Int = 0): [Mortgage!]\n  \"Active credit card accounts, queryable by account or customer.\"\n  CreditCard(credit_card_account_id: String, customer_id: String, limit: Int = 10, offset: Int = 0): [CreditCard!]\n  \"Active consumer loans (personal and auto), queryable by loan or customer.\"\n  ConsumerLoan(loan_id: String, customer_id: String, limit: Int = 10, offset: Int = 0): [ConsumerLoan!]\n  \"Unified payment history across all lending instruments for a customer.\"\n  ConsolidatedLoanPayments(customer_id: String!, limit: Int = 10, offset: Int = 0): [ConsolidatedLoanPayments!]\n}\n\nenum _McpMethodType {\n  NONE\n  TOOL\n  RESOURCE\n}\n\nenum _RestMethodType {\n  NONE\n  GET\n  POST\n}\n\ndirective @api(mcp: _McpMethodType, rest: _RestMethodType, uri: String) on QUERY | MUTATION | FIELD_DEFINITION\n===OPS===\n# Retrieve a customer's full lending overview including all active mortgages,\n# credit cards, and consumer loans in a single call\nquery GetCustomerLendingOverview($customer_id: String) @api(mcp: TOOL, rest: GET, uri: \"/customer/{customer_id}/lending\") {\n  Customer(customer_id: $customer_id) {\n    customer_id\n    first_name\n    last_name\n    customer_type\n    customer_status\n    relationship_start_date\n    mortgages {\n      loan_id\n      loan_number\n      loan_program\n      loan_purpose\n      interest_rate\n      rate_type\n      current_principal_cents\n      total_monthly_payment_cents\n      next_payment_due_date\n      maturity_date\n    }\n    credit_cards {\n      credit_card_account_id\n      account_number\n      product_name\n      credit_limit_cents\n      current_balance_cents\n      available_credit_cents\n      minimum_payment_due_cents\n      payment_due_date\n      purchase_apr\n      rewards_program\n      rewards_balance\n    }\n    consumer_loans {\n      loan_id\n      loan_number\n      loan_type\n      loan_purpose\n      original_amount_cents\n      current_balance_cents\n      interest_rate\n      monthly_payment_cents\n      next_payment_due_date\n      maturity_date\n    }\n  }\n}\n\n# Retrieve all payment activity across a customer's lending instruments\nquery GetCustomerPaymentHistory($customer_id: String!, $limit: Int = 50) @api(mcp: TOOL, rest: GET, uri: \"/customer/{customer_id}/payments\") {\n  ConsolidatedLoanPayments(customer_id: $customer_id, limit: $limit) {\n    payment_id\n    instrument_type\n    instrument_id\n    payment_amount_cents\n    payment_type\n    payment_status\n    payment_date\n    principal_cents\n    interest_cents\n  }\n}\n\n# Retrieve details for a specific mortgage loan\nquery GetMortgage($loan_id: String, $customer_id: String) @api(mcp: TOOL, rest: GET, uri: \"/mortgage/{loan_id}\") {\n  Mortgage(loan_id: $loan_id, customer_id: $customer_id) {\n    loan_id\n    loan_number\n    customer_id\n    loan_status\n    loan_program\n    lien_position\n    loan_purpose\n    occupancy_type\n    rate_type\n    interest_rate\n    original_principal_cents\n    current_principal_cents\n    original_term_months\n    remaining_term_months\n    monthly_pi_payment_cents\n    total_monthly_payment_cents\n    funding_date\n    first_payment_date\n    maturity_date\n    next_payment_due_date\n  }\n}\n\n# Retrieve details for a specific credit card account\nquery GetCreditCard($credit_card_account_id: String, $customer_id: String) @api(mcp: TOOL, rest: GET, uri: \"/credit-card/{credit_card_account_id}\") {\n  CreditCard(credit_card_account_id: $credit_card_account_id, customer_id: $customer_id) {\n    credit_card_account_id\n    account_number\n    customer_id\n    product_name\n    account_status\n    credit_limit_cents\n    available_credit_cents\n    current_balance_cents\n    minimum_payment_due_cents\n    payment_due_date\n    purchase_apr\n    opened_date\n    autopay_enrolled\n    rewards_program\n    rewards_balance\n  }\n}\n\n# Retrieve details for a specific consumer loan (personal or auto)\nquery GetConsumerLoan($loan_id: String, $customer_id: String) @api(mcp: TOOL, rest: GET, uri: \"/consumer-loan/{loan_id}\") {\n  ConsumerLoan(loan_id: $loan_id, customer_id: $customer_id) {\n    loan_id\n    loan_number\n    customer_id\n    loan_type\n    loan_purpose\n    original_amount_cents\n    current_balance_cents\n    interest_rate\n    rate_type\n    monthly_payment_cents\n    original_term_months\n    remaining_term_months\n    funding_date\n    maturity_date\n    next_payment_due_date\n    autopay_enrolled\n  }\n}\n===TESTS===\nlending360-api/tests/payment-history.graphql\nlending360-api/tests/customer-lending.graphql\n"}], "isError": false, "durationMs": 13, "timestamp": 1795509903005}, {"role": "toolResult", "toolCallId": "call_01a20cbaddb072728cdf694e", "toolName": "bash", "content": [{"type": "text", "text": "===SHARED PKG===\n{\n  \"version\": \"1\",\n  \"enabled-engines\": [\"flink\", \"postgres\", \"vertx\"],\n  \"script\": {\n    \"main\": \"ontology.sqrl\"\n  },\n  \"engines\": {\n    \"flink\": {\n      \"config\": {\n        \"execution.runtime-mode\": \"STREAMING\",\n        \"table.exec.source.idle-timeout\": \"30 s\"\n      }\n    }\n  },\n  \"compiler\": {\n    \"predicate-pushdown-rules\": \"LIMITED_RULES\",\n    \"api\": {\n      \"protocols\": [\"GRAPHQL\", \"REST\", \"MCP\"],\n      \"endpoints\": \"FULL\",\n      \"max-result-depth\": 1,\n      \"add-prefix\": true\n    }\n  }\n}\n===TEST PKG===\n{\n  \"script\": {\n    \"config\": {\n      \"environment\": \"test\"\n    }\n  },\n  \"engines\": {\n    \"flink\": {\n      \"config\": {\n        \"table.exec.source.idle-timeout\": \"1 s\"\n      }\n    }\n  },\n  \"test-runner\": {\n    \"delay-sec\": -1,\n    \"required-checkpoints\": 1,\n    \"snapshot-folder\": \"snapshots/ontology/\"\n  }\n}\n===ONTOLOGY HEAD===\nIMPORT customer.customer-ontology.*;\nIMPORT lending.lending-ontology.*;\nIMPORT deposits_payments.deposits_payments-ontology.*;\n\n-- =====================================================\n-- Customer to Credit Card Relationships\n-- =====================================================\n\n/** Credit card accounts where customer is the primary account holder */\nCustomer.credit_card_accounts := SELECT * FROM Credit_Card_Account a WHERE this.customer_id = a.primary_customer_id;\n\n/** Open credit card accounts for this customer */\nCustomer.open_credit_card_accounts := SELECT * FROM Credit_Card_Account a WHERE this.customer_id = a.primary_customer_id\n                                                                      AND account_status = 'OPEN';\n\n/** Credit cards where customer is the cardholder (including authorized user cards) */\nCustomer.credit_cards := SELECT * FROM Credit_Card c WHERE this.customer_id = c.cardholder_customer_id;\n\n/** Card delinquency events for this customer */\nCustomer.card_delinquency_events := SELECT * FROM Card_Delinquency_Event d WHERE this.customer_id = d.customer_id\n                                                                       ORDER BY event_date DESC;\n\n-- =====================================================\n-- Customer to Consumer Loan Relationships\n-- =====================================================\n\n/** Personal loans where customer is the primary borrower */\nCustomer.personal_loans := SELECT * FROM Personal_Loan l WHERE this.customer_id = l.primary_borrower_customer_id;\n\n/** Active personal loans for this customer */\nCustomer.active_personal_loans := SELECT * FROM Personal_Loan l WHERE this.customer_id = l.primary_borrower_customer_id\n                                                            AND loan_status = 'ACTIVE';\n\n/** Auto loans where customer is the primary borrower */\nCustomer.auto_loans := SELECT * FROM Auto_Loan l WHERE this.customer_id = l.primary_borrower_customer_id;\n\n/** Active auto loans for this customer */\nCustomer.active_auto_loans := SELECT * FROM Auto_Loan l WHERE this.customer_id = l.primary_borrower_customer_id\n                                                    AND loan_status = 'ACTIVE';\n\n/** Loan applications where customer is the primary applicant */\nCustomer.loan_applications := SELECT * FROM Loan_Application a WHERE this.customer_id = a.primary_applicant_customer_id\n                                                           ORDER BY submitted_at DESC;\n\n/** Loan applications where customer is a co-applicant */\nCustomer.loan_applications_as_coapplicant := SELECT * FROM Loan_Application a WHERE this.customer_id = a.co_applicant_customer_id\n                                                                          ORDER BY submitted_at DESC;\n\n/** Consumer loan delinquency events for this customer */\nCustomer.consumer_loan_delinquency_events := SELECT * FROM Consumer_Loan_Delinquency_Event d WHERE this.customer_id = d.customer_id\n                                                                                         ORDER BY event_date DESC;\n\n-- =====================================================\n-- Customer to Mortgage Relationships\n-- =====================================================\n\n/** Mortgage applications where customer is the primary borrower */\nCustomer.mortgage_applications := SELECT * FROM Mortgage_Application a WHERE this.customer_id = a.primary_borrower_customer_id\n                                                                   ORDER BY submitted_at DESC;\n\n/** Mortgage loans where customer is the primary borrower */\nCustomer.mortgage_loans := SELECT * FROM Mortgage_Loan l WHERE this.customer_id = l.primary_borrower_customer_id;\n\n/** Active mortgage loans for this customer */\nCustomer.active_mortgage_loans := SELECT * FROM Mortgage_Loan l WHERE this.customer_id = l.primary_borrower_customer_id\n                                                            AND loan_status = 'ACTIVE';\n\n/** All mortgages where customer is a borrower (primary, co-borrower, or guarantor) */\nCustomer.mortgage_borrower_records := SELECT * FROM Mortgage_Borrower b WHERE this.customer_id = b.customer_id;\n\n/** Mortgage delinquency events for this customer */\nCustomer.mortgage_delinquency_events := SELECT * FROM Delinquency_Event d WHERE this.customer_id = d.customer_id\n                                                                      ORDER BY event_date DESC;\n\n/** Mortgage loan modifications for this customer */\nCustomer.mortgage_modifications := SELECT * FROM Loan_Modification m WHERE this.customer_id = m.customer_id\n                                                                 ORDER BY request_date DESC;\n\n-- =====================================================\n-- Customer to Deposits & Payments Relationships\n"}], "isError": false, "durationMs": 10, "timestamp": 1795509903005}, {"role": "assistant", "content": [{"type": "thinking", "thinking": "Now I understand the layout. Let me read the test graphql files and the run-tests.sh of lending, and check if lending has a run-tests.sh. Also read the loan-payments progress file and requirements. Let me check the .datasqrl progress file for any prior planning.", "thinkingSignature": "reasoning_content"}, {"type": "toolCall", "id": "call_01a20cbae1317cf28606aa60", "name": "bash", "arguments": {"command": "cd /workspace/lending && echo \"===TESTS===\" && for f in lending360-api/tests/*.graphql; do echo \"---$f---\"; cat \"$f\"; done && echo \"===RUN-TESTS?===\" && ls -la run-tests.sh 2>/dev/null; find /workspace/lending -maxdepth 1 -name \"*.sh\"; echo \"===SNAPSHOTS===\" && find snapshots -type f | head"}}, {"type": "toolCall", "id": "call_01a20cbae1bf7483aabd3cbb", "name": "read", "arguments": {"path": "/workspace/loan-payments/.datasqrl/datasqrl-agent-progress.txt"}}, {"type": "toolCall", "id": "call_01a20cbae1ee70a391ca36c5", "name": "read", "arguments": {"path": "/workspace/loan-payments/.datasqrl/datasqrl-agent-context.txt"}}], "api": "openai-completions", "provider": "together", "model": "deepseek-ai/DeepSeek-V4.1-Flash", "usage": {"input": 3227, "output": 292, "cacheRead": 35072, "cacheWrite": 0, "reasoning": 61, "totalTokens": 38591, "cost": {"input": 0.0009681, "output": 0.0003504, "cacheRead": 0.000210432, "cacheWrite": 0, "total": 0.001528932}}, "stopReason": "toolUse", "timestamp": 1795509903007, "responseId": "b5836a1f50004df390b96f60859ac113-aws_ec1", "rawStopReason": "tool_calls", "durationMs": 1029, "thinkingLevel": "high"}, {"role": "toolResult", "toolCallId": "call_01a20cbae1317cf28606aa60", "toolName": "bash", "content": [{"type": "text", "text": "===TESTS===\n---lending360-api/tests/customer-lending.graphql---\nquery GetCustomerLendingOverview {\n  Customer(customer_id: \"CUST-001\") {\n    customer_id\n    first_name\n    last_name\n    customer_type\n    customer_status\n    mortgages {\n      loan_id\n      loan_number\n      loan_program\n      interest_rate\n      current_principal_cents\n      total_monthly_payment_cents\n    }\n    credit_cards {\n      credit_card_account_id\n      product_name\n      current_balance_cents\n      credit_limit_cents\n      purchase_apr\n    }\n    consumer_loans {\n      loan_id\n      loan_type\n      loan_purpose\n      current_balance_cents\n      monthly_payment_cents\n    }\n  }\n}\n---lending360-api/tests/payment-history.graphql---\nquery GetCustomerPaymentHistory {\n  ConsolidatedLoanPayments(customer_id: \"CUST-001\", limit: 20) {\n    payment_id\n    instrument_type\n    instrument_id\n    payment_amount_cents\n    payment_type\n    payment_status\n    payment_date\n  }\n}\n===RUN-TESTS?===\n===SNAPSHOTS===\nsnapshots/lending360/ConsolidatedLoanPayments_Test.snapshot\nsnapshots/lending360/payment-history.snapshot\nsnapshots/lending360/CreditCard_Test.snapshot\nsnapshots/lending360/customer-lending.snapshot\nsnapshots/lending360/Mortgage_Test.snapshot\nsnapshots/lending360/Customer_Test.snapshot\nsnapshots/lending360/ConsumerLoan_Test.snapshot\n"}], "isError": false, "durationMs": 14, "timestamp": 1795509904052}, {"role": "toolResult", "toolCallId": "call_01a20cbae1bf7483aabd3cbb", "toolName": "read", "content": [{"type": "text", "text": "+00:00:00  INFO   Image edition: pro (pro-agent)\n+00:00:00  INFO   Discovered 3 sibling entr(ies) (1 shared module(s))\n+00:00:00  RUN    Run started \u00b7 planning\n+00:00:00  INFO   Wrote repo inventory to .datasqrl/repo-inventory.md\n+00:00:00  STEP   Iteration 0 \u00b7 implementing\n+00:00:02  THINK  Let me start by reading the repo inventory and exploring the workspace.\n+00:00:02  TEXT   I'll start by surveying the repository, beginning with the inventory and shared catalog.\n+00:00:02  TOOL   read /workspace/.datasqrl/repo-inventory.md\n+00:00:02  TOOL   bash ls -la /workspace && echo \"---LOAN---\" && ls -la /workspace/loan-payments && echo \"---ADR---\" && ls -la /workspace/loan-payments/adr 2>/dev/null\n+00:00:02  THINK  The inventory is not at /workspace/.datasqrl but maybe under loan-payments/.datasqrl or elsewhere. Let me find it.\n+00:00:02  TOOL   bash find /workspace -name \"repo-inventory.md\" -not -path \"*/build/*\" 2>/dev/null; echo \"---\"; ls -la /workspace/loan-payments/.datasqrl; echo \"---datacatalog---\"; ls -la /workspace/data-catalog\n+00:00:02  TOOL   read /workspace/README.md\n+00:00:02  TOOL   read /workspace/loan-payments/AGENTS.md\n+00:00:03  TOOL   read /workspace/loan-payments/.datasqrl/repo-inventory.md\n+00:00:03  TOOL   read /workspace/data-catalog/README.md\n+00:00:04  THINK  Now let me read the catalog's consumer_loans files and the lending project. Also check the requirements file and progress file.\n+00:00:04  TEXT   Now let me read the specific catalog files for consumer loans and the lending project.\n+00:00:04  TOOL   read /workspace/data-catalog/lending/cards_consumer_credit/consumer_loans.sqrl\n+00:00:04  TOOL   read /workspace/data-catalog/lending/cards_consumer_credit/consumer_loans-test.sqrl\n+00:00:04  TOOL   read /workspace/data-catalog/lending/cards_consumer_credit/consumer_loans-prod.sqrl\n+00:00:05  THINK  Now let's read the lending project's scripts and package configs. This is the sibling reference. Let me read the lending360.sqrl and package configs, plus READM\u2026\n+00:00:05  TEXT   Now the sibling `lending/` project, which is the reference.\n+00:00:05  TOOL   read /workspace/lending/lending360.sqrl\n+00:00:05  TOOL   bash cd /workspace/lending && ls -la && echo \"===SHARED===\" && cat lending360-shared-package.json && echo \"===TEST===\" && cat lending360-test-package.json && echo \"===PROD===\" && cat lending360-prod-package.json\n+00:00:07  THINK  There's an important discrepancy. The requirements say include path should be `../data-catalog/ontology-shared-package.json` but the lending reference uses `../\u2026\n+00:00:07  TOOL   bash cd /workspace/lending && echo \"===API DIR===\" && find lending360-api -type f | head -50 && echo \"===SCHEMA===\" && cat lending360-api/schema.v1.graphqls && echo \"===OPS===\" && cat lending360-api/operations.v1.graphql && echo \"===TESTS===\" && find lending360-api/tests -type f | head -50\n+00:00:07  TOOL   bash cd /workspace/data-catalog && echo \"===SHARED PKG===\" && cat ontology-shared-package.json && echo \"===TEST PKG===\" && cat ontology-test-package.json && echo \"===ONTOLOGY HEAD===\" && head -80 ontology.sqrl\n+00:00:09  THINK  Now I understand the layout. Let me read the test graphql files and the run-tests.sh of lending, and check if lending has a run-tests.sh. Also read the loan-pay\u2026\n+00:00:09  TOOL   bash cd /workspace/lending && echo \"===TESTS===\" && for f in lending360-api/tests/*.graphql; do echo \"---$f---\"; cat \"$f\"; done && echo \"===RUN-TESTS?===\" && ls -la run-tests.sh 2>/dev/null; find /workspace/lending -maxdepth 1 -name \"*.sh\"; echo \"===SNAPSHOTS===\" && find snapshots -type f | head\n+00:00:09  TOOL   read /workspace/loan-payments/.datasqrl/datasqrl-agent-progress.txt\n+00:00:09  TOOL   read /workspace/loan-payments/.datasqrl/datasqrl-agent-context.txt\n"}], "isError": false, "durationMs": 7, "timestamp": 1795509904053}, {"role": "toolResult", "toolCallId": "call_01a20cbae1ee70a391ca36c5", "toolName": "read", "content": [{"type": "text", "text": "# Task context (persistent \u2014 keep these in mind across compaction)\n\n## Plan Section Content Rule\n\n`## Implementation Checklist`, `## Technical Decisions` and\n`## Data Quality & Observability` sections are short prose: they state what each step\nachieves and why, cite the requirements it serves, and carry the `\u2192 skill:` that supplies\nthe syntax at implementation phase, a downstreaming phase. The names of tables, columns and\nfunctions the implementation creates are left to it.\n\nCritical rules:\n\n- Never write SQRL, JSON, or Java statements in `## Implementation Checklist`, `## Technical Decisions` or `## Data Quality & Observability`.\n- Never write a fenced code block in `## Implementation Checklist`.\n- Any referenced files must be in the project.\n\n## Shared modules (read before configuring imports)\n\nThis project consumes external SQRL module(s) that are mounted as **read-only sibling directories** next to your project \u2014 NOT inside it. They are shared with other projects; you must **never create, copy, edit, or delete** any file under them. Treat them exactly like a shared data catalog.\n\nDeclare the module(s) you actually need under the `script.include` block in your project's `*-package.json` config files \u2014 in each config that carries a `script` block (the ones defining `script.main`, i.e. the configs you compile/test with); overlay configs that only define overwrites settings need none. Each include key is the **namespace** you import the module under (prefer underscores for each namespace); its `package` is the path, relative to your project root, to a package file at the module's top level \u2014 DataSQRL takes that file's folder as the include root and loads every `.sqrl` in it and its subfolders. Import their scripts by that namespace. Do **not** import them with a bare relative path and do **not** duplicate their contents into your project.\n\nAvailable shared module(s) \u2014 each shown with ONE of its top-level package files as the `package` example; any other package file at that module's top level works (the compiler only uses the file's folder as the include root):\n- `data-catalog` \u2014 namespace `data_catalog`, declare `\"data_catalog\": { \"package\": \"../data-catalog/ontology-shared-package.json\" }`\n\nExample package config `script` block:\n```json\n\"script\": {\n  \"main\": \"<your-main>.sqrl\",\n  \"include\": {\n      \"data_catalog\": { \"package\": \"../data-catalog/ontology-shared-package.json\" }\n  },\n  \"config\": { \"variant\": \"test\" }\n}\n```\n\nImport a script from a module by its namespace (`{{variant}}` is resolved from `script.config`, so the same import serves test/prod):\n```sqrl\nIMPORT data_catalog.<script>-{{variant}} AS my_alias;\n```\n\nIf a module's OWN scripts contain `{{...}}` placeholders (inspect them before importing), supply those values in that module's `script.include` entry via a `config` object, e.g. `\"data_catalog\": { \"package\": \"../data-catalog/ontology-shared-package.json\", \"config\": { \"environment\": \"test\" } }` \u2014 otherwise unresolved placeholders become SQL parse errors.\nFrom a script in a subfolder of your project, use the `root` prefix: `IMPORT root.data_catalog.<script>;`.\n\nCompile/test from the project \u2014 the package path is resolved at the mount root, so it must be project-qualified:\n```bash\n/opt/agent/cmd.sh compile loan-payments/<your>-package.json\n/opt/agent/cmd.sh test loan-payments/<your>-test-package.json\n```\n\n## Repository inventory\nThis repo contains other SQRL projects/modules. `.datasqrl/repo-inventory.md` lists them (paths, READMEs, SQRL files, package summaries) \u2014 read it before deciding how to build. They are mounted READ-ONLY: never edit them, never copy their files into this project (include shared modules via `script.include` in `*-package.json` files instead), and never read their `build/` directories.\n\n## DataSQRL skills\n\nThe DataSQRL skills available. Read the ones your work touches before you\nwrite or change anything, and open the reference pages they point to.\n\n### /build-catalog \u2014 Use when creating or updating a data catalog that defines sources, sinks, and data products used by multiple implementations.\n### /configure-sqrl \u2014 Use when configuring a DataSQRL project's `*-package.json` files. Use for engine selection (Flink, Postgres, Kafka, Iceberg and its query engines DuckDB, Snowflake, Spark SQL, Redshift, Trino), API protocols, compiler options, runtime settings, or deployment/infrastructure settings.\n### /data-observation \u2014 Use when a task provides source, sample, or test data files to inspect before modeling schemas, connectors, writing test data or implementing anything. Ensures you look at the real data (size, format, values) instead of guessing from filenames, READMEs, or prior knowledge.\n### /design-api \u2014 Use when designing or modifying the API exposed by a DataSQRL data pipeline. Use for GraphQL, REST, or MCP endpoints, access control, or data serving requirements. Use for adjusting exposed GraphQL schema.\n### /from-api \u2014 Use when requirements define an API schema or specification that the resulting DataSQRL pipeline should expose. Use when requirements (partially) define GraphQL schema, REST endpoints (e.g. Swagger or OpenAPI), or MCP tools with interface or result schema (JSON).\n### /handle-large-data-files \u2014 Use when the workspace contains a large data file, or when a compile/test run is blocked with LARGE_DATA_BLOCKED. Used to sample the large files down or exclude them so that DataSQRL compiles seamlessly.\n### /implement-sqrl \u2014 Use when writing or editing DataSQRL scripts (.sqrl) for data processing, transformation, aggregation, or serving logic. Use for any pipeline logic implementation. Contains SQRL language spec.\n### /implement-udf \u2014 Use when SQRL/SQL alone cannot implement required logic. Use to create custom scalar, aggregate, or table functions in Java.\n### /implement-ui \u2014 Use for building simple user interfaces that interact with the API of a DataSQRL pipeline. Use when asked for an interface, UI, SPA, dashboard, or charts for a DataSQRL pipeline.\n### /init-sqrl \u2014 Use when starting a new DataSQRL project or initializing an empty pipeline. Use for greenfield implementations, project scaffolding, or setting up the folder structure.\n### /manage-connector \u2014 Use when connecting to external data systems for ingestion or export in DataSQRL. Use for Kafka, filesystem, database, Iceberg, or other connector configuration.\n### /monitor-pipeline \u2014 Use when reviewing a DataSQRL pipeline's monitoring needs or implementing data-quality captures and observability statistics. Decide which data quality and monitoring tables are useful and how to build them.\n### /optimize-deployment \u2014 Use when planning and implementing a DataSQRL project. Use when user specifically mentions cost or sizing. This includes creating or editing a `*-package.json`, adding an engine or an environment, and setting `engines.<flink|postgres|vertx>.deployment` sizes, CPU, replicas or disks. Also use when asked to reduce cloud cost or right-size a deployment.\n### /test-sqrl \u2014 Use when adding or updating tests for a DataSQRL pipeline. Use after implementing features to verify correctness.\n### /troubleshoot-test \u2014 Use when a DataSQRL test fails unexpectedly or produces wrong results. Use when previous fix attempts did not resolve the issue. Use for complex DataSQRL compile-time errors or when a previous attempt of fixing a compile time error did not work.\n### /write-documentation \u2014 Use when writing or updating project documentation, README files, or API documentation for a DataSQRL project."}], "isError": false, "durationMs": 8, "timestamp": 1795509904053}, {"role": "assistant", "content": [{"type": "thinking", "thinking": "Now I have a good understanding. Let me read the key skills that inform the plan: implement-sqrl (particularly around JWT auth, aggregation, DISTINCT), design-api (auth), configure-sqrl (JWT config, engines), and from-api. Let me read them.\n\nAlso I should check the requirements file saved in the project to confirm. And check test data observation perhaps. Let me read the relevant skills.\n\nLet me read the skills. They may be long. Let me read implement-sqrl first, then design-api, configure-sqrl, from-api, monitor-pipeline, test-sqrl.", "thinkingSignature": "reasoning_content"}, {"type": "text", "text": "Now let me read the key skills that shape the plan."}, {"type": "toolCall", "id": "call_01a20cbae7147d908d5834d8", "name": "read", "arguments": {"path": "/opt/agent/skills/implement-sqrl/SKILL.md"}}, {"type": "toolCall", "id": "call_01a20cbae7437a52a34f2a01", "name": "read", "arguments": {"path": "/opt/agent/skills/design-api/SKILL.md"}}], "api": "openai-completions", "provider": "together", "model": "deepseek-ai/DeepSeek-V4.1-Flash", "usage": {"input": 3375, "output": 232, "cacheRead": 38528, "cacheWrite": 0, "reasoning": 128, "totalTokens": 42135, "cost": {"input": 0.0010125, "output": 0.0002784, "cacheRead": 0.000231168, "cacheWrite": 0, "total": 0.001522068}}, "stopReason": "toolUse", "timestamp": 1795509904056, "responseId": "b0ed441878cc42ad80da14553dd302b3-aws_ec1", "rawStopReason": "tool_calls", "durationMs": 1321, "thinkingLevel": "high"}, {"role": "toolResult", "toolCallId": "call_01a20cbae7147d908d5834d8", "toolName": "read", "content": [{"type": "text", "text": "---\nname: implement-sqrl\ndescription: Use when writing or editing DataSQRL scripts (.sqrl) for data processing, transformation, aggregation, or serving logic. Use for any pipeline logic implementation. Contains SQRL language spec.\n---\n\n# Implement SQRL scripts\n\nSQRL is an extension of Flink SQL that adds support for table functions and convenience syntax to build reactive data processing and serving applications.  \nThe \u201cR\u201d in **SQRL** stands for *Reactive* and *Relationships*.\n\nThis document focuses only on features **unique to SQRL**; when SQRL accepts Flink SQL verbatim we simply refer to the upstream spec.\n\n## Reference Templates\n\nReview project examples in `/opt/datasqrl-examples/README.md` before implementing new features to identify related projects and copy features from those reference implementations.\n\n## Script Structure\n\nA SQRL script is an **ordered list** of statements separated by semicolons (`;`).  \nOnly one statement is allowed per line, but a statement may span multiple lines.\n\nTypical order of statements:\n\n```text\nIMPORT ...            -- import other SQRL scripts\nCREATE TABLE ...      -- define internal & external sources\nMyTable := SELECT ... -- define tables or functions (with hints)\nEXPORT MyTable TO ... -- write table data to sinks\n```\n\nAt compile time the statements form a *directed-acyclic graph* (DAG).  \nEach node is then assigned to an enabled execution engine according to the optimizer and the compiler generates the data processing code for that engine. See [Where a table runs](#where-a-table-runs).\n\n## Flink SQL\n\nSQRL inherits full Flink SQL grammar for\n\n* `CREATE {TABLE | VIEW | FUNCTION | CATALOG | DATABASE}`\n* `SELECT` queries inside any of the above\n* `USE ...`\n* `INSERT INTO`\n\nSQRL currently tracks Flink 2.3; use its compatible SQL syntax. Refer to the Flink SQL documentation for the detailed specification.\n\n## Type System\nIn SQRL, every table and function has a type based on how the table represents data.\nThe type determines the semantic validity of queries against tables and how data is processed by different engines.\n\nSQRL assigns one of the following types to tables based on the definition:\n- **STREAM**: Represents a stream of immutable records with an assigned timestamp (often referred to as the \"event time\"). Streams are append-only. Stream tables represent events or actions over time.\n- **VERSIONED_STATE**: Contains records with a natural primary key and a timestamp, tracking changes over time to each record, thereby creating a change-stream.\n- **STATE**: Similar to VERSIONED_STATE but without tracking the history of changes. Each record is uniquely identified by its natural primary key.\n- **LOOKUP**: Supports lookup operations using a primary key against external data systems but does not allow further processing of the data.\n- **STATIC**: For data that does not change over time, such as constants.\n\nThe table type determines what operators a table supports and how those operators are applied.\n\n## IMPORT Statement\n\nImports another SQRL script into the current script.\n```\nIMPORT qualifiedPath (AS identifier)?;\nIMPORT qualifiedPath.*;             -- wildcard\n```\n\n### Path resolution\n\nA `qualifiedPath` resolves in exactly one of three ways:\n\n* **Relative (default)** \u2014 against the directory of the importing script: `IMPORT my.custom.script` maps to `./my/custom/script.sqrl`.\n* **`root.` (reserved)** \u2014 resolves the rest of the path against the **build root of the top-level project being compiled**, no matter how deeply nested the importing script is. SQRL dot-paths have no `..`, so a script in a **subfolder** cannot climb upward relatively; `root.` is the only way for it to reach something at the project root (`IMPORT root.data_catalog.identity.customers;`, `IMPORT root.functions.my_func;`).\n* **`stdlib.` (reserved)** \u2014 resolves to compiler built-ins (e.g. `IMPORT stdlib.math.*;`), not the file system. Import a whole library with `.*` or a single function by name.\n\n\n- The path may continue one segment past a SQRL script to import a **single `CREATE TABLE`** from it. Standard-library paths may similarly select a function, e.g. `IMPORT stdlib.math.hypot AS hypotenuse`. Hyphenated segments are written as they are (`IMPORT connectors.kafka-source.*`); backticking a segment is also accepted (`` IMPORT `data_catalog`.`sources` ``). A `{{...}}` template variable in the path is substituted from `script.config` before the path is resolved (`IMPORT connectors.sources-{{environment}} AS sources;` \u2014 see [Config Templating](guides/templating.md)).\n- Imports that end in `.*` are imported inline which means that the statement from that script are executed verbatim in the current script.\nOtherwise, imports are available within a namespace that's equal to the name of the script or the optional `AS` identifier.\n\n### Examples\n\n* `IMPORT my.custom.script.*`: All table definitions from the script are imported inline and can be referenced directly as `MyTable` in `FROM` clauses.\n* `IMPORT my.custom.script`: Tables are imported into the `script` namespace and can be referenced as `script.MyTable`\n* `IMPORT my.custom.script AS myNamespace`: Tables are imported into the `myNamespace` namespace and can be referenced as `myNamespace.MyTable`\n* `IMPORT connectors.sources-{{environment}} AS sources`: Imports the connector file selected by the `environment` config variable (`sources-test.sqrl`, `sources-prod.sqrl`, \u2026) into the `sources` namespace\n* `IMPORT functions.*` / `IMPORT functions.my_func`: Imports Java UDFs from the project's `functions/` folder (invoke the `/implement-udf` skill); `IMPORT stdlib.math.*` imports built-in functions (see [functions.md](functions.md))\n\n### Import style controls API exposure\n\nBecause a wildcard import executes the statements verbatim in the current script (above), its tables become definitions of this script and follow the normal exposure rules (see *Interfaces*). A namespaced import keeps its tables **private**: they can be referenced in `FROM` clauses as `namespace.Table`, but they are not exposed in the interface directly.\n\n```sql\nIMPORT connectors.sources AS sources;   -- private: sources.Customer usable in FROM, absent from the API directly\nIMPORT connectors.enablement.*;         -- inline: these tables are exposed in the API\n```\n\nTo publish only what the API needs, import the sources aliased and re-declare the tables that should be exposed:\n\n```sql\nIMPORT connectors.sources AS sources;\n/** Purchases with computed line total. */\nPurchase := SELECT *, quantity * unit_price AS total_price FROM sources.Purchase;\n```\n\nWhen a single table must be a **mutation**, put it in its own connector file and wildcard-import that file, while the read-only sources stay aliased.\n\n### Included projects / multi-project (`script.include`)\n\nA project can import scripts from **another SQRL project**, e.g. a shared data catalog or a metrics layer reused by several pipelines, declared under `script.include` in the project's configuration file. To include another SQRL project, invoke the `/configure-sqrl` skill for configuration. What matters for the language is how the imports resolve:\n\n* At compile time the included project (the directory holding the top-level package file, together with all its subfolders, every `.sqrl` in them is loaded) is **copied into `build/<namespace>/`**, alongside the consumer's own scripts, where `<namespace>` is the key of its `script.include` entry in the configuration file. A script reaches it with a plain **relative** import, like `IMPORT <namespace>.sources AS sources;`, and that is the preferred form. Name include namespaces with underscores (`data_catalog`), because a dash has a different meaning in SQL. When the importing script is in a subdirectory (e.g. `./my-module/module-script.sqrl`), use `IMPORT root.<namespace>.sources;` (see *Path resolution*). Below the namespace the path follows the included project's own directory structure at any depth. Example:`IMPORT data_catalog.customer.customer_data.customer_master-{{environment}} AS cs;`.\n* `{{...}}` in the *consumer's* import statement is substituted from the consumer's own `script.config`; `{{...}}` inside the *included project's* scripts (e.g. a catalog's `{{environment}}` or a `{{^is_batch}}\u2026{{/is_batch}}` section) is rendered with the `script.config` of the package file named by `package`, overridden by `script.include.<namespace>.config`.\n* **Inside an included project, reference sibling scripts with *relative* imports**, so they travel with the copied files. A `root.` import inside an included project breaks once it is consumed: `root` then points at the consumer's build root, not the included project's.\n* A **`standalone`** include (see `/configure-sqrl`) is deployed on its own, so the consumer does not repeat what that deployment writes: the consumer's subscriptions on tables that the include's main script (or its inline imports) subscribes to read the include's topics, and the include's `EXPORT`/`INSERT` statements into the log, its internal Kafka tables and external tables do not run in the consumer (a NOTICE names each). Write your own subscriptions and exports in the consumer's scripts; those always run.\n\n## CREATE TABLE (internal vs external)\n\nSQRL understands the complete Flink SQL `CREATE TABLE` syntax, but distinguishes between **internal** and **external** source tables.\nExternal source tables are standard Flink SQL tables that connect to an external data source (e.g. database or Kafka cluster).\nInternal tables are managed by SQRL through an engine hint (`kafka` or `iceberg`). Kafka internal sources are exposed for data ingestion in the interface.\n\n| Feature           | Internal source (managed by SQRL)                                   | External Source (connector)    |\n|-------------------|---------------------------------------------------------------------|--------------------------------|\n| Connector options | **omitted**; other engine-specific `WITH (...)` options are allowed | **required**                   |\n| Engine hint       | **required**                                                        | Not used to select a connector |\n| Metadata columns  | `METADATA FROM 'uuid'`, `'timestamp'`, `'auth.<claim>'` only        | Passed through                 |\n| Watermark spec    | **generated**                                                       | **required**                   |\n| Primary key       | *Unenforced* upsert semantics                                       | Same as Flink                  |\n\nOn an internal table, use only the metadata keys `'uuid'`, `'timestamp'` and `'auth.<claim>'`. A `METADATA` column without `FROM` uses its column name as the key. Any other key stops the compile with an `Unknown metadata key` error, for example `'auht.sub'` or the Flink Kafka key `'offset'`. If you see that error, correct the key to one of the three supported keys.\n\nExample (internal): An internal table managed by DataSQRL as a Kafka topic carries the `engine(kafka)` hint (see the `/manage-connector` skill):\n\n```sql\n/*+engine(kafka) */\nCREATE TABLE Customer (\n  customerid BIGINT,\n  email STRING,\n  ts TIMESTAMP_LTZ(3) METADATA FROM 'timestamp',\n  PRIMARY KEY (customerid) NOT ENFORCED\n);\n```\n\nThe internal table does not need `WATERMARK` declaration. SQRL generates the watermark for it. \nDeclare a `WATERMARK` explicitely on an internal table only when the user asks for one.\n\nWith `engine(kafka)`, `PARTITIONED BY (col, ...)` on an internal table without a `PRIMARY KEY` keys each record by those columns, both the records the server writes for mutations and the records the pipeline exports into the table, so records with the same key stay on one Kafka partition in order.\nThe key columns can be `uuid` or `auth` metadata columns, but not the `timestamp` metadata column.\nThe Flink source ignores that key and reads every column from the message value, so adding `PARTITIONED BY` to an existing internal table is safe: records written before the table had a key are still read, also when the topic is read again from the earliest offset.\nThis relies on the default `kafka-safe` connector. Do not switch internal Kafka tables to the plain `kafka` connector, which drops records that have no key.\nUse `PARTITIONED BY` when records only need a Kafka key for partitioning and ordering. A `PRIMARY KEY` also keys the records, but it makes the table an upsert table (`VERSIONED_STATE`), and its upsert source drops records that were written without a key.\n\nExample (external): An external table connects to a data system through a `WITH (...)` clause and declares its own `WATERMARK`:\n\n```sql\nCREATE TABLE kafka_json_table (\n  user_id    INT,\n  name       STRING,\n  event_time TIMESTAMP_LTZ(3) NOT NULL METADATA FROM 'timestamp',\n  WATERMARK FOR event_time AS event_time - INTERVAL '1' SECOND\n) WITH (\n  'connector' = 'kafka-safe',\n  'topic'     = 'users',\n  'format'    = 'flexible-json'\n);\n```\n\n- Invoke the `/manage-connector` skill before writing or editing any table with a `WITH (...)` clause i.e. every external source and sink. This section covers the statement syntax only. Use that skill to decide which connector and format to use, the watermark rules for the source type, whether the schema belongs in a separate `_schema` table referenced with `LIKE`, and which values become `${VARIABLE}` references.\n- With the `_schema` + `LIKE` source pattern, the `WATERMARK`, any `METADATA FROM '...'` column, and any computed (`AS ...`) column belong to the **connector table**, never the `_X_schema` table. Invoke the `/manage-connector` skill for those rules.\n\n### File-based sources: watermarks & snapshot aggregation\n\nFile-based sources (`filesystem`, `iceberg`, `hudi`, `deltalake`) behave differently from Kafka streams.\n\n**(A) Watermark column.** A file-based source whose data timestamp is not quasi-monotonic, or whose files do not arrive frequently, watermarks a computed `ingestion_time AS now()` column instead of a data column. The one exception to \"prefer event time\". The rule that decides this belongs to the source table: invoke the `/manage-connector` skill (Event-Time Processing \u2192 Watermarks on production file-based sources).\n\n**(B) Complete-snapshot sources.** If a file source re-lists every object each cycle (e.g. S3 Inventory, full dumps), a global (non-windowed) `GROUP BY` **double-counts** \u2014 it counts each object once per snapshot. Aggregate each snapshot independently with a `SESSION` window over the `ingestion_time AS now()` column from (A), `PARTITION BY` the group key (read [SESSION Windows](guides/session-tvf.md) first): each snapshot's records arrive as one ingestion burst and form one session, so they are counted once. A short session gap (e.g. 1 minute) closes the window shortly after a snapshot finishes loading, while the much larger gap between snapshots keeps them in separate sessions.\n\n**Wrong fixes:** a `PRIMARY KEY` on a filesystem source does **not** dedup (the source is append-only); even a correct `DISTINCT`-dedup mishandles deletions (an object disappears by absence in the next snapshot) and grows unbounded state.\n\n## Definition statements\n\n### Table definition\n\n```\nTableName := SELECT ... ;\n```\n\nEquivalent to a `CREATE VIEW` in SQL.\n\n```sql\nValidCustomer := SELECT * FROM Customer WHERE customerid > 0 AND email IS NOT NULL;\n```\n\nA common pattern is stream enrichment with a temporal join:\n\n```sql\n-- Temporal join for stream enrichment \u2014 intermediate result uses _ prefix\n_EnrichedOrders := SELECT o.*, c.name, c.email\n  FROM Orders o\n  JOIN Customer FOR SYSTEM_TIME AS OF o.event_time AS c\n    ON o.customerid = c.customerid;\n\n-- If the enriched table is exposed directly in the API, use a public name:\n/** Orders enriched with customer details */\nEnrichedOrders := SELECT o.*, c.name, c.email\n  FROM Orders o\n  JOIN Customer FOR SYSTEM_TIME AS OF o.event_time AS c\n    ON o.customerid = c.customerid;\n```\n\n### Timestamp of a join result\n\nFor every join, decide the timestamp of the result: the time when the result row last changed. Choose it by the type of join:\n\n| Join | Timestamp of the result |\n|---|---|\n| Temporal join (`FOR SYSTEM_TIME AS OF`) or interval join | The timestamp of the stream side. Each result row is an event at that time, and the join never changes it later. |\n| Regular join (an inner or outer join without `FOR SYSTEM_TIME AS OF` or a time bound) | Reason about how the result row changes over time. In the common case, both sides change independently. The row then last changed at the later of the two times: `GREATEST(l.ts, r.ts)`. Give `GREATEST` one argument for each joined table that has a timestamp. A table without a timestamp, such as a table of fixed values, never changes, so it adds no argument. `GREATEST` returns `NULL` when one argument is `NULL`. In an outer join, wrap the timestamp of each side that can be missing in `COALESCE` with the timestamp of another side. For example, in a `LEFT JOIN`, write `GREATEST(l.ts, COALESCE(r.ts, l.ts))`. |\n\nA regular join emits a new version of a result row each time either side changes. A row that keeps the timestamp of one side only looks out of date when the other side changes. API clients that sort or filter by that timestamp then get wrong results.\n\nThe Postgres sink writes a new version of a `STATE` row only when this timestamp is not older than the stored one. `GREATEST` goes back to an older timestamp when the optional side of an outer join stops matching, for example because its row is deleted or filtered out. The sink then keeps the old joined values. For such a join, use only the timestamp of the preserved side, such as `l.ts` in a `LEFT JOIN`. It does not show changes of the optional side, but it never goes back.\n\nA `FULL JOIN` has no preserved side. If its sides can stop matching, `CAST` the result timestamp to its type, for example `CAST(GREATEST(...) AS TIMESTAMP_LTZ(3))`, to remove the row-time marker. The sink then writes every version without comparing timestamps.\n\n### DISTINCT operator\n\n```\nDistinctTbl := DISTINCT SourceTbl\n               ON pk_col [, ...]\n               ORDER BY ts_col [ASC|DESC] [NULLS LAST] ;\n```\n\n* Deduplicates a **STREAM** of changelog data into a **VERSIONED_STATE** table.\n* The SQRL `DISTINCT` statement is not SQL `SELECT DISTINCT`.\n* Hint `/*+filtered_distinct_order*/` (see hints) may precede the statement to push filters before deduplication for optimization.\n\n**Use `DISTINCT` when the source table is a `STREAM` of updates to an entity that needs to be converted to a state table, i.e. changelog.** A `DISTINCT` statement adds a stateful operator and changes the semantics of the table.\nCheck the type of the source table before you write one:\n\n| Source table | What to do |\n|---|---|\n| A `STREAM` that carries several records for the same key, for example an append-only change feed | Write the `DISTINCT` statement where a consumer needs a single version per entity, either the current one or the one valid at an event's timestamp in a temporal join. It turns the stream into `VERSIONED_STATE`. |\n| A table that already declares a `PRIMARY KEY` with upsert semantics, for example an `upsert-kafka` source or an internal table with an engine hint and a primary key | Read the table directly. It is `VERSIONED_STATE` already, so a `DISTINCT` on that same key returns the same rows and only costs state. |\n\nRead the `STREAM` directly where a consumer needs the changes themselves, such as a history endpoint, an aggregation over every update, an alert per change, or a stream-to-stream join. When both consumers exist, keep the `STREAM` and define the `DISTINCT` table, if needed, beside it, so each keeps its own semantics.\n\n```sql\n-- Intermediate dedup step (feeds into another table) \u2014 use _ prefix\n_DistinctProducts := DISTINCT Products ON id ORDER BY updated DESC;\n\n-- Final dedup result exposed directly in the API \u2014 use public name\n/** Latest version of each product, deduplicated by id */\nDistinctProducts := DISTINCT Products ON id ORDER BY updated DESC;\n```\n\n### Primary key columns\n\nA table gets a primary key from a `PRIMARY KEY` in its `CREATE TABLE`, or from a `DISTINCT ... ON` or `GROUP BY` on the key columns. Such a table has the type `VERSIONED_STATE` or `STATE` (see [Type System](#type-system)).\n\nClean the primary key columns before the first table that has that primary key, and select them unchanged in every table that reads from that table, directly or through other tables.\nFor example, when `Customer` has the primary key `customer_id`, a later table selects `customer_id`, and never `TRIM(customer_id) AS customer_id`.\n\nA function on a key column in such a later table (`TRIM`, `LOWER`, `REGEXP_REPLACE`, `CAST`, `NULLIF`) hides the key from the Flink planner. A function can turn two different keys into the same value, so the planner treats the result as a normal column, not as a key. Every join that reads the later table stores each full row in its state and finds a row by comparing all of its columns (`NoUniqueKey`), instead of finding it by its key. This makes the state larger and every update slower.\nColumns that are not part of the key can be cleaned in any table.\n\nThese rules apply to entity data (see the `/manage-connector` skill, Entity Data), where each new record replaces the previous version of the same entity, such as a customer or an account.\n\n**Writing entity data.** When the pipeline writes entity data into a table that other tables or projects read, clean the key before the `EXPORT`.\nSuch a table is a mutation table with a `PRIMARY KEY` (an internal table with an engine hint) or a Kafka sink with a `PRIMARY KEY`.\nEvery reader then receives the final key value and can select it unchanged.\nFollow these steps:\n\n1. Clean the key in a view, and keep only the rows whose cleaned key is not empty.\n2. Make the cleaned key unique with `DISTINCT ... ON` the cleaned key.\n3. Export the `DISTINCT` table into the table with the primary key.\n\nIn this example, `RawCustomerUpdate` is the source table the pipeline reads. It has no key, and its `customer_id` values can contain extra spaces or be empty.\n\n```sql\n/*+engine(kafka) */\nCREATE TABLE Customer (\n  customer_id STRING NOT NULL,\n  email STRING,\n  event_time TIMESTAMP_LTZ(3) NOT NULL METADATA FROM 'timestamp',\n  PRIMARY KEY (customer_id) NOT ENFORCED\n);\n\n_CleanCustomerUpdate := SELECT NULLIF(TRIM(REGEXP_REPLACE(customer_id, '\\s+', ' ')), '') AS customer_id,\n                               email, event_time\n                        FROM RawCustomerUpdate\n                        WHERE NULLIF(TRIM(REGEXP_REPLACE(customer_id, '\\s+', ' ')), '') IS NOT NULL;\n\n_LatestCustomerUpdate := DISTINCT _CleanCustomerUpdate ON customer_id ORDER BY event_time DESC;\n\nEXPORT _LatestCustomerUpdate TO Customer;\n```\n\nStep 2 is required.\nIt keeps the latest version of each key by `event_time`, and makes the cleaned key the upsert key of the exported query.\nAn `EXPORT` into a table declared with `CREATE TABLE` gets no generated `ON CONFLICT` clause, so when the upsert key of the exported query differs from the `PRIMARY KEY` of that table, Flink rejects the `EXPORT` with the error `The query has an upsert key that differs from the primary key of the sink table`.\nA view that only cleans and filters a source without a key has no upsert key at all, so exporting it directly fails with this error. Export the `DISTINCT` table instead.\n\n**Reading keys that arrive dirty.** When the writer is outside this project, for example an external client that calls a mutation endpoint, the pipeline cannot clean the key before it is stored.\nClean it in the first table after the mutation instead:\n\n1. Declare the mutation without a `PRIMARY KEY`, so that each write is stored as an event with the key value exactly as the client sent it.\n   A `PRIMARY KEY` on the raw key would make the raw value the key, and cleaning it in a later table would hide that key from the planner.\n2. Clean the key in a view, and keep only the rows whose cleaned key is not empty.\n3. Make the cleaned key unique with `DISTINCT ... ON` the cleaned key. Every later table reads this `DISTINCT` table.\n\n```sql\n/*+engine(kafka) */\nCREATE TABLE CustomerUpdate (\n  customer_id STRING NOT NULL,\n  email STRING,\n  event_time TIMESTAMP_LTZ(3) NOT NULL METADATA FROM 'timestamp'\n);\n\n_CleanCustomerUpdate := SELECT NULLIF(TRIM(REGEXP_REPLACE(customer_id, '\\s+', ' ')), '') AS customer_id,\n                               email, event_time\n                        FROM CustomerUpdate\n                        WHERE NULLIF(TRIM(REGEXP_REPLACE(customer_id, '\\s+', ' ')), '') IS NOT NULL;\n\n/** Current version of each customer, with the cleaned id as primary key */\nCustomer := DISTINCT _CleanCustomerUpdate ON customer_id ORDER BY event_time DESC;\n```\n\nFollow the same steps for an external source whose keys can arrive dirty.\nWhen an external source's keys always arrive clean, read its key unchanged and skip the cleaning.\n\nClean the key in a view, as shown above, and not inside the `CREATE TABLE`.\nFlink accepts a `PRIMARY KEY` only on physical columns, so a computed column such as `customer_id AS TRIM(raw_customer_id)` cannot be the key.\n\nThe `/*+primary_key(...)*/` hint does not fix this: it declares the key for DataSQRL, but does not deduplicate the data and is not visible to Flink.\nWhen the hint is placed on a state table whose rows the query does not keep unique on the hinted columns, the compiler warns with `PRIMARY_KEY_NOT_UNIQUE`. Do not ignore this warning: replace the hint with `DISTINCT ... ON` the cleaned key.\n\n### Function definition\n\n```\nFuncName(arg1 TYPE [NOT NULL] [, ...]) :=\n  SELECT ... WHERE col = :arg1 ;\n```\n\nArguments are referenced with `:name` in the `SELECT` query. Argument definitions are identical to column definitions in `CREATE TABLE` statements.\n\n```sql\nCustomerByEmail(email STRING) := SELECT * FROM Customer WHERE email = :email;\n```\n\n#### Accessing JWT payload\n\nTo access the JWT payload included in the Authorization HTTP header, you can use the `METADATA` expression within the function definition. The text after `auth.` is the name of a claim in the JWT payload:\n\n* `'auth.val'` reads the top-level claim `val`.\n* `'auth.org.id'` reads the field `id` of the object claim `org`. A path can go to any depth, for example `'auth.org.location.zip'`.\n* A key can contain dots, at the top level and inside an object, for example the namespaced claim `https://example.com/org`. At each level, the server uses the longest key that it finds, and then follows the rest of the path. So `'auth.https://example.com/org_id'` reads a top-level claim, and `'auth.https://example.com/org.id'` reads the field `id` of the claim `https://example.com/org`. In the same way, `'auth.resource_access.com.example.app.roles'` reads the field `roles` of the key `com.example.app` inside the claim `resource_access`.\n* A path can end on an array. In the SQRL script, declare the function argument with an `ARRAY<...>` type, for example `roles ARRAY<STRING> NOT NULL METADATA FROM 'auth.realm_access.roles'`.\n* Array indexing does not work. For example, `'auth.realm_access.roles.0'` does not read the first role. The server treats it as a missing claim. To check for one item, read the full array and use `array_contains` in the query.\n* Give each segment of the path a name. A key with an empty segment, such as `'auth.org.'` or `'auth.org..id'`, stops the compile with an `Invalid metadata key` or `Unknown metadata key` error.\n* When the token has no claim at the path, a request fails with `403 Forbidden` for a `NOT NULL` argument. A nullable argument gets `null`.\n\nIn the example below, the JWT payload contains a val field, which is an integer.\n\n```sql\nAuthFilter(mySecretId BIGINT NOT NULL METADATA FROM 'auth.val') :=\n  SELECT c.* \n  FROM Customer c \n  WHERE c.customerId = :mySecretId;\n```\n\nA script that reads a claim needs an auth provider in `engines.vertx.config`. This applies to a function argument and to a mutation column. The provider is an `auth` block with at least one issuer. The deprecated `jwtAuth`, or `oauthConfig` with `oauth2Options.site`, also gives a provider. Without a provider, the server checks no token. The compile then fails with the error `The script reads JWT claims (...), but engines.vertx.config has no auth provider.` If you see that error, add an `auth` block with the `/configure-sqrl` skill, and keep the `METADATA FROM 'auth.<claim>'` columns. The check also covers a claim function that a custom GraphQL schema leaves out. If the API must not expose that function, start its name with `_`. The `/*+no_query*/` hint does not help here, because it works only on tables.\n\n### Relationship definition\n\n```\nParentTable.RelName(arg TYPE, ...) :=\n  SELECT ...\n  FROM Child c\n  WHERE this.id = c.parentId\n  [AND c.col = :arg ...] ;\n```\n\n`this.` is the alias for the parent table to reference columns from the parent row.\n\n```sql\nCustomer.highValueOrders(minAmount BIGINT) := SELECT * FROM Orders o WHERE o.customerid = this.id AND o.amount > :minAmount;\n```\n\n### Column-addition statement\n\n```\nTableName.new_col := expression;\n```\n\nMust appear **immediately after** the table definition it extends, and may reference previously added columns of the same table. Cannot be applied after `CREATE TABLE` statements.\n\n\n### Relation alias as ROW\n\nA relation alias is the alias of any `FROM` item: a table, a view, a subquery or a CTE. Used by itself in a `SELECT` list, it produces one `ROW` value holding every column of that relation. The API exposes the column as a nested object. \nThe compiler expands the alias to `CAST(ROW(c.col1, ...) AS ROW<...>)` from the relation's validated columns, so the alias replaces writing that cast by hand.\n\nExamples:\n```sql\nTableName := SELECT o.id, c AS customer FROM Orders o JOIN Customer c ON o.customerid = c.customerid;\n```\n\n```sql\n/** Orders with the customer as it was when the order was placed */\nOrderWithCustomer := SELECT o.id, o.amount, o.event_time, c AS customer\n  FROM Orders o\n  JOIN Customer FOR SYSTEM_TIME AS OF o.event_time AS c\n    ON o.customerid = c.customerid;\n```\n\nThe `FOR SYSTEM_TIME AS OF` clause selects the customer version valid at `o.event_time`. The alias itself packs whichever row the join produced.\n\n* The flink row carries every column of the relation, including its timestamp column. A `_`-prefixed column is stored inside the row and omitted from the API type.\n* A column named like the alias takes precedence, and the alias then resolves to that column. Give the alias a name no column uses when you want the row.\n* A bare alias, `SELECT customerid, c FROM Customer c`, names the column after the alias. `c AS customer` names it explicitly.\n* The alias combines with `o.*`, works inside CTEs and subqueries, and works with `LEFT JOIN`, where the row stays non-null and every field inside it becomes nullable.\n* Read a field back downstream with dot access: `SELECT x.id, x.customer.name FROM OrderWithCustomer x`.\n* Copy a field out as its own column as well, `c.tier AS customer_tier`, when the API filters or sorts by it. The nested value is one JSON column in the database and carries no relationships or filter arguments of its own.\n\nRead the [Stream Enrichment](guides/stream-enrichment.md) guide to choose between the whole-row alias, copied scalar columns, and a relationship.\n\n### Passthrough definitions\n\nPassthrough definitions allow you to bypass SQRL's analysis and translation, passing SQL queries directly to the underlying database engine.\nThis serves as a \"backdoor\" for SQL constructs that SQRL does not yet support natively.\n\nPassthrough table, function, or relationship definition have a `RETURNS` clause in their signature that defines the result type of the query.\n\n```\nTableName RETURNS (column TYPE [NOT NULL], ...) := \n  SELECT raw_sql_query;\n```\n\n**\u26a0\ufe0f Important considerations:**\n- SQL must be written in the exact syntax of the target database engine\n- SQRL will not validate, parse, or optimize the query\n- Only use when SQRL lacks native support for the required functionality\n- Return type must be explicitly declared using the `RETURNS` clause\n- Passthrough queries must be assigned to a database engine for execution\n\nThe following defines a relationship definition with a recursive CTE that is passed through to the\ndatabase engine for execution.\nUse `this` to reference parent fields in a relationship definition or `:name` to reference function\narguments as in standard definitions. The only thing that changes is that adding a `RETURNS` declaration\nbypasses the SQRL analysis, optimization, and query rewriting.\n\n```sql\nEmployees.allReports RETURNS (employeeid BIGINT NOT NULL, name STRING NOT NULL, level INT NOT NULL) :=\n  WITH RECURSIVE employee_hierarchy AS (\n    SELECT r.employeeid, r.managerid, 1 as level\n    FROM \"Reporting\" r\n    WHERE r.managerid = this.employeeid\n    \n    UNION ALL\n    \n    SELECT r.employeeid, r.managerid, eh.level + 1 as level\n    FROM \"Reporting\" r\n    INNER JOIN employee_hierarchy eh ON r.managerid = eh.employeeid\n  )\n  SELECT e.employeeid, e.name, eh.level\n  FROM employee_hierarchy eh\n  JOIN \"Employees\" e ON eh.employeeid = e.employeeid\n  ORDER BY eh.level, e.employeeid;\n```\n\n## Functions\n\nSQRL supports the Flink 2.3-compatible built-in functions plus its own scalar, aggregate, and table functions. [Look up the required function](functions.md).\n\n## Interfaces\n\nThe tables and functions defined in a SQRL script are exposed through an interface.\nThe term \"interface\" is used generically to describe a means by which a client, user, or external system can access the processed data.\nThe interface depends on the configured engines: API endpoints for servers, queries and views for databases, and topics for logs.\nAn interface is a sink in the data processing DAG that's defined by a SQRL script.\n\nHow a table or function is exposed in the interface depends on the access type. The access type is one of the following:\n\n| Access type              | How to declare               | Surface                                                                                              |\n|--------------------------|------------------------------|------------------------------------------------------------------------------------------------------|\n| **Query** (default)      | no modifier                  | GraphQL query / SQL view / log topic (pull)                                                          |\n| **Subscription**         | prefix body with `SUBSCRIBE` | GraphQL subscription / push topic                                                                    |\n| **No direct query**        | `/*+no_query*/` hint         | still **in** the interface, reachable through a relationship or an explicit function but cannot be queryable directly |\n| **Not in the interface but intermediate step** | object name starts with `_`  | not exposed at all                                                                                   |\n\nExample:\n\n```sql\nHighTempAlert := SUBSCRIBE\n                 SELECT * FROM SensorReading WHERE temperature > 50;\n```\nDefines a subscription endpoint that is exposed as a GraphQL subscription or Kafka topic depending on engine configuration.\nThe assignment operator comes first and the `SUBSCRIBE` keyword comes after it (`Name := SUBSCRIBE SELECT ...`).\n\n```sql\nHighTemperatures := SELECT * FROM SensorReading WHERE temperature > 50;\n```\nDefines a query table that is exposed as a query in the API or view in the database.\n\n```sql\nHighTemperatures(temp BIGINT NOT NULL) := SELECT * FROM SensorReading WHERE temperature > :temp;\n```\nDefines a query function that is exposed as a parametrized query in the API.\n\n```sql\n_HighTemps := SELECT * FROM SensorReading WHERE temperature > 50;\n```\nDefines an internal table that is not exposed in the interface.\n\n### `_` prefix vs. `/*+no_query*/` \u2014 different semantics, never interchangeable\n\n* **`_` prefix** \u2014 the object is **not part of the interface at all**: no endpoint, no generated type, unreachable from any client. This is what pipeline intermediates use (dedup, enrichment, filter and join steps).\n* **`/*+no_query*/`** \u2014 the object **is** part of the interface through relationship but it cannot be queryable directly. Use it for a table clients reach only through a relationship from its parent.\n\n```sql\n-- Clients reach Purchase only through Order, so it has no query endpoint of its own.\n/** A line of a purchase order, with its total price (quantity times unit price). */\n/*+no_query */\nPurchase := SELECT *, quantity * unit_price AS total_price FROM sources.Purchase;\nPurchase.offering := SELECT * FROM Offering o WHERE o.offering_id = this.offering_id LIMIT 1;\nPurchase.customer := SELECT * FROM Customer c WHERE c.customer_id = this.customer_id LIMIT 1;\n\n/** The lines of one purchase order, sorted by offering id. Empty when no order has this id. */\nOrder(order_id STRING NOT NULL) := SELECT * FROM Purchase WHERE order_id = :order_id ORDER BY offering_id ASC;\n```\n\nApplying `no_query` to a `_`-prefixed table is illogical. Pick one: `_` for a pipeline intermediate, `no_query` for an interface object that must not have its own query endpoint.\n\n### CREATE TABLE\n\nCREATE TABLE statements that define an internal data source are exposed as topics in the log, or GraphQL mutations in the server.\nThe input type is defined by mapping all column types to native data types of the interface schema. Computed and metadata columns are not included in the input type since those are computed on insert.\n\n## EXPORT statement\n\n```\nEXPORT source_identifier TO sinkPath.QualifiedName ;\n```\n\n* `sinkPath` maps to a connector table definition when present, or one of the **built-in** sinks:\n    * `print.*` \u2013 stdout\n    * `logger.*` \u2013 uses configured logger\n    * `log.*` \u2013 topic in configured log engine\n\n```sql\nEXPORT CustomerTimeWindow TO print.TimeWindow;\nEXPORT MyAlerts          TO log.AlertStream;\n```\n\nAn export may also target one table in another script, for example `EXPORT CustomerSubset TO connectors.sinks.CustomerExport;`. The target must be either an external connector table or an engine-managed internal table.\n\n\n## Hints\n\nHints live in a `/*+ ... */` comment placed **immediately before** the definition they apply to.\n\n| Hint                        | Form                                                                       | Applies to     | Effect                                                                                                                                                                             |\n|-----------------------------|----------------------------------------------------------------------------|----------------|------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------|\n| **primary_key**             | `primary_key(col, ...)`                                                    | table          | declare the key when the compile fails with `Could not determine primary key for table [...]`; does not deduplicate (see Primary key columns)                                                                                             |\n| **index**                   | `index(type, col [ASC\\|DESC], ...)` <br/> Multiple `index(...)` can be comma-separated | table          | replaces automatic index selection for this table. `type` \u2208 `HASH`, `BTREE`, `PBTREE`, `TEXT`, `VECTOR_COSINE`, `VECTOR_EUCLID`; `DESC` is supported only for `BTREE` and `PBTREE`. <br />`index` *alone* disables all automatic indexes, except the row-time index of a table behind a paginated query |\n| **partition_key**           | `partition_key(col, ...)`                                                  | table          | define partition columns for sinks that support partitioning                                                                                                                       |\n| **vector_dim**              | `vector_dim(col, 1536)`                                                    | table          | declare fixed vector length. This is required when using vector indexes.                                                                                                           |\n| **query_by_all**            | `query_by_all(col, ...)`                                                   | table          | generate interface with *required* filter arguments for all listed columns                                                                                                         |\n| **query_by_any**            | `query_by_any(col, ...)`                                                   | table          | generate interface with *optional* filter arguments for all listed columns                                                                                                         |\n| **no_query**                | `no_query`                                                                 | table          | prevent the table from being directly queryable but reachable through relationships and explicit functions (see *Interfaces*)                        |\n| **insert**                  | `insert(type)`                                                             | table          | controls the way how mutations will be written to their target sink. `type` \u2208 `SINGLE` (default), `BATCH`, `TRANSACTION`                                                           |\n| **ttl**                     | `ttl(duration)`                                                            | table          | specifies how long the records for this table are retained in the underlying data system before it can be discarded. Expects a duration string with a unit between minute and day, e.g. `30 min`, `36 hours`, `14 days`. Disabled by default. |\n| **cache**                   | `cache(duration)`                                                          | table          | how long the results retrieved from this table can be cached on the server before they are refreshed. Expects a duration string like `10 seconds`. Disabled by default.            |\n| **filtered_distinct_order** | flag                                                                       | DISTINCT table | eliminate updates on order column only before dedup                                                                                                                                |\n| **engine**                  | `engine(engine_id)`                                                        | table          | on a table definition, select the engine that computes the table, such as `flink` or `postgres` (see [Where a table runs](#where-a-table-runs)). On a `CREATE TABLE`, name the engine that manages the internal table, such as `kafka` (see [CREATE TABLE](#create-table-internal-vs-external)). `exec` is a deprecated alias of `engine` |\n| **maintenance**             | `maintenance(type)`                                                        | table          | table maintenance for engines that support it. `type` \u2208 `NONE`, `REGULAR`; `REGULAR` on an Iceberg table adds the `iceberg-maintenance` connector options |\n| **row_count**               | `row_count(count)` or `row_count(col, ..., count)`                         | table          | estimated total row count (e.g. `1e6`), or the number of distinct values for the listed column combination. Used for query optimization and index selection: a table with a total row count of at most 100 (`small-table-row-limit` of the `postgres` engine) gets no automatic index (see [Indexes for API Queries](guides/api-query-indexes.md)) |\n| **test**                    | `test` or `test(no_rows)`                                                  | table          | marks test case, only executed with `test` command.                                                                                                       |\n| **workload**                | `workload`                                                                 | table          | retained as sink for DAG optimization but hidden from interface                                                                                                                    |\n\nMultiple hints are comma-separated inside one comment. This example configures the vector length and a vector index for the `SensorTempByHour` table:\n\n```sql\n/*+vector_dim(embedding, 1536), index(VECTOR_COSINE, embedding) */\nSensorTempByHour := SELECT ... ;\n```\n\nSQL matches column names case-sensitively, but hints do not. A plain column name in a hint matches the column with the same name, ignoring case, so `primary_key(CUSTOMERID)` matches `customerId`. A name in backticks only matches the column with exactly that name. When a table has columns whose names differ only in case, such as `cnt` and `CNT`, a plain name fails the compile with `matches columns that differ only in case`: write the name in backticks, like ``index(BTREE, `CNT`)``, or rename one of the columns. The required columns of a tag in `compiler.tags` match the same way.\n\nFor choosing between `query_by_all` (required filter arguments) and `query_by_any` (optional filter arguments) when designing table access, invoke the `/design-api` skill (Table Hints for Table Access).\n\n### Where a table runs\n\nThe compiler runs each table in Flink or in the database, and picks the cheaper of the two. The `engine` hint replaces this choice for one table:\n\n- `/*+engine(flink) */`: Flink engine computes the rows when the data arrives. When the API reads the table, Flink writes the rows to a Postgres table, and the compiler can index its columns.\n- `/*+engine(postgres) */`: Postgres engine stores no rows for the table. When the API reads the table directly, the compiler creates a view with the query of the table. Otherwise, it copies the query into each served query that reads the table. Postgres computes the rows on every request.\n\nA table definition accepts only an enabled engine that can compute a table:\n\n| Engine     | Engine type |\n|------------|-------------|\n| `flink`    | `process`   |\n| `postgres` | `database`  |\n| `iceberg`  | `database`  |\n\nThe hint also accepts the engine type like `engine(database)`, but compiler selects the engine. Use the engine name. Other engines, such as `kafka`, `vertx`, `duckdb` or `snowflake`, cannot compute a table. For what each engine does and when to enable it, see the `/configure-sqrl` skill.\n\nLeave the choice to the compiler, unless a table needs an index that the compiler cannot give it. A served query can use an index only on rows that the database stores. A table that runs in Postgres stores no rows, so no index can serve a column that it computes, such as a `CONCAT_WS` text for `text_search` or a `CAST` value for a filter. In that case, add `/*+engine(flink) */` to the table: Flink computes the column ahead of time, and Postgres stores it in a table that can have an index. The hint also moves every table that this table reads into Flink, because a table in Flink can read only from Flink or Kafka. So the hint costs Flink state for this table and for each upstream table that ran in Postgres before, plus one more database table. Read the `Stage:` lines of the upstream tables after the compile.\n\nAfter compile, read the `Stage:` line of the table in `pipeline_explain.txt` in the build folder to see which engine computes it.\n\nPut the `engine` hint on a table definition. An API function always runs in the database, so `engine(flink)` on a function fails with `Provided execution stages could not be found or are not configured`.\nA table in Postgres cannot feed a table in Flink. Pinning such a table to `postgres` fails with `Could not find execution stage for [table ...]`.\n\n### Filters in API queries\n\nDataSQRL creates the database indexes for the tables that the API queries. The database (Postgres) can use an index only when the filtered column stands alone in the comparison, so write every served query in the following form:\n\n- Compare the bare column: `customer_id = :customerId`.\n- Do a type conversion or a derived value in a table that Flink computes, then filter on the result: add `/*+engine(flink) */` to the table, select `CAST(c.customer_id AS STRING) AS customer_id` in it, and filter on `customer_id = :customerId`. A table that runs in the database (an `engine(database)` hint, or the planner's choice) is copied into the served query, so its `CAST` ends up in the filter again. A function on the column in the filter, such as `CAST(customer_id AS STRING) = :customerId` or `LOWER(email) = :email`, makes the database read the whole table.\n- Put arithmetic on the parameter side: `day_index = :day - 1`.\n- In a `JOIN`, put the table that the `WHERE` clause filters with a parameter first. With the other order, the database reads every row of the table that the `WHERE` clause does not filter. Write `FROM AccountOwners o JOIN Orders c ON c.customer_id = o.customer_id WHERE o.account_id = :accountId`, not `FROM Orders c JOIN AccountOwners o ON o.customer_id = c.customer_id WHERE o.account_id = :accountId`.\n- To filter on another table, put `EXISTS (...)` or `IN (SELECT ...)` in the `WHERE` clause and combine it with the other conditions by `AND`: `FROM Orders c WHERE EXISTS (SELECT 1 FROM AccountOwners o WHERE o.account_id = :accountId AND o.customer_id = c.customer_id)`. When the subquery compares with the outer columns only by `=`, the compiler indexes both tables, so the database can start from either one. With `NOT EXISTS (...)`, `NOT IN (SELECT ...)`, or a subquery that is part of an `OR`, the database reads every row of the outer table that the other conditions leave.\n\nThe compiler creates no index for a filter that wraps its column in an expression, and warns `The filter ... cannot use an index on table ...`, with the fix. It does not warn about the order of the tables in a `JOIN`.\n\n### Indexes for API queries\n\nThe compiler selects the indexes for the tables that the API queries. An `index` hint replaces the automatic index selection for its whole table, so a hint that one query does not need can remove the indexes that other queries need. Leave the index selection to the compiler. Read [Indexes for API Queries](guides/api-query-indexes.md) and fix the query only in these cases:\n\n- The requirements, the plan or a review issue name a slow query or an index.\n- The compiler warns that query filter patterns of a table \"have no supporting index and require a full table scan\". Read the guide before you add the `index` hint that the warning suggests.\n\n\n### Constraints and mutual exclusions\n\n**Never combine `/*+no_query*/` with a `_`-prefixed name.** They are used for different purposes (see *Interfaces*): `_` removes the object from the interface entirely and it is used for intermediate processes. On the other hand, table with `no_query` hint cannot be queried directly while is accessible through relationship from other tables.\n\n**`query_by_all` / `query_by_any` need a queryable table.** They generate interface filter arguments, so they are meaningless on a `_`-prefixed table.\n\n\n\n[Showing lines 1-643 of 762 (50.0KB limit). Use offset=644 to continue.]"}], "details": {"truncation": {"content": "---\nname: implement-sqrl\ndescription: Use when writing or editing DataSQRL scripts (.sqrl) for data processing, transformation, aggregation, or serving logic. Use for any pipeline logic implementation. Contains SQRL language spec.\n---\n\n# Implement SQRL scripts\n\nSQRL is an extension of Flink SQL that adds support for table functions and convenience syntax to build reactive data processing and serving applications.  \nThe \u201cR\u201d in **SQRL** stands for *Reactive* and *Relationships*.\n\nThis document focuses only on features **unique to SQRL**; when SQRL accepts Flink SQL verbatim we simply refer to the upstream spec.\n\n## Reference Templates\n\nReview project examples in `/opt/datasqrl-examples/README.md` before implementing new features to identify related projects and copy features from those reference implementations.\n\n## Script Structure\n\nA SQRL script is an **ordered list** of statements separated by semicolons (`;`).  \nOnly one statement is allowed per line, but a statement may span multiple lines.\n\nTypical order of statements:\n\n```text\nIMPORT ...            -- import other SQRL scripts\nCREATE TABLE ...      -- define internal & external sources\nMyTable := SELECT ... -- define tables or functions (with hints)\nEXPORT MyTable TO ... -- write table data to sinks\n```\n\nAt compile time the statements form a *directed-acyclic graph* (DAG).  \nEach node is then assigned to an enabled execution engine according to the optimizer and the compiler generates the data processing code for that engine. See [Where a table runs](#where-a-table-runs).\n\n## Flink SQL\n\nSQRL inherits full Flink SQL grammar for\n\n* `CREATE {TABLE | VIEW | FUNCTION | CATALOG | DATABASE}`\n* `SELECT` queries inside any of the above\n* `USE ...`\n* `INSERT INTO`\n\nSQRL currently tracks Flink 2.3; use its compatible SQL syntax. Refer to the Flink SQL documentation for the detailed specification.\n\n## Type System\nIn SQRL, every table and function has a type based on how the table represents data.\nThe type determines the semantic validity of queries against tables and how data is processed by different engines.\n\nSQRL assigns one of the following types to tables based on the definition:\n- **STREAM**: Represents a stream of immutable records with an assigned timestamp (often referred to as the \"event time\"). Streams are append-only. Stream tables represent events or actions over time.\n- **VERSIONED_STATE**: Contains records with a natural primary key and a timestamp, tracking changes over time to each record, thereby creating a change-stream.\n- **STATE**: Similar to VERSIONED_STATE but without tracking the history of changes. Each record is uniquely identified by its natural primary key.\n- **LOOKUP**: Supports lookup operations using a primary key against external data systems but does not allow further processing of the data.\n- **STATIC**: For data that does not change over time, such as constants.\n\nThe table type determines what operators a table supports and how those operators are applied.\n\n## IMPORT Statement\n\nImports another SQRL script into the current script.\n```\nIMPORT qualifiedPath (AS identifier)?;\nIMPORT qualifiedPath.*;             -- wildcard\n```\n\n### Path resolution\n\nA `qualifiedPath` resolves in exactly one of three ways:\n\n* **Relative (default)** \u2014 against the directory of the importing script: `IMPORT my.custom.script` maps to `./my/custom/script.sqrl`.\n* **`root.` (reserved)** \u2014 resolves the rest of the path against the **build root of the top-level project being compiled**, no matter how deeply nested the importing script is. SQRL dot-paths have no `..`, so a script in a **subfolder** cannot climb upward relatively; `root.` is the only way for it to reach something at the project root (`IMPORT root.data_catalog.identity.customers;`, `IMPORT root.functions.my_func;`).\n* **`stdlib.` (reserved)** \u2014 resolves to compiler built-ins (e.g. `IMPORT stdlib.math.*;`), not the file system. Import a whole library with `.*` or a single function by name.\n\n\n- The path may continue one segment past a SQRL script to import a **single `CREATE TABLE`** from it. Standard-library paths may similarly select a function, e.g. `IMPORT stdlib.math.hypot AS hypotenuse`. Hyphenated segments are written as they are (`IMPORT connectors.kafka-source.*`); backticking a segment is also accepted (`` IMPORT `data_catalog`.`sources` ``). A `{{...}}` template variable in the path is substituted from `script.config` before the path is resolved (`IMPORT connectors.sources-{{environment}} AS sources;` \u2014 see [Config Templating](guides/templating.md)).\n- Imports that end in `.*` are imported inline which means that the statement from that script are executed verbatim in the current script.\nOtherwise, imports are available within a namespace that's equal to the name of the script or the optional `AS` identifier.\n\n### Examples\n\n* `IMPORT my.custom.script.*`: All table definitions from the script are imported inline and can be referenced directly as `MyTable` in `FROM` clauses.\n* `IMPORT my.custom.script`: Tables are imported into the `script` namespace and can be referenced as `script.MyTable`\n* `IMPORT my.custom.script AS myNamespace`: Tables are imported into the `myNamespace` namespace and can be referenced as `myNamespace.MyTable`\n* `IMPORT connectors.sources-{{environment}} AS sources`: Imports the connector file selected by the `environment` config variable (`sources-test.sqrl`, `sources-prod.sqrl`, \u2026) into the `sources` namespace\n* `IMPORT functions.*` / `IMPORT functions.my_func`: Imports Java UDFs from the project's `functions/` folder (invoke the `/implement-udf` skill); `IMPORT stdlib.math.*` imports built-in functions (see [functions.md](functions.md))\n\n### Import style controls API exposure\n\nBecause a wildcard import executes the statements verbatim in the current script (above), its tables become definitions of this script and follow the normal exposure rules (see *Interfaces*). A namespaced import keeps its tables **private**: they can be referenced in `FROM` clauses as `namespace.Table`, but they are not exposed in the interface directly.\n\n```sql\nIMPORT connectors.sources AS sources;   -- private: sources.Customer usable in FROM, absent from the API directly\nIMPORT connectors.enablement.*;         -- inline: these tables are exposed in the API\n```\n\nTo publish only what the API needs, import the sources aliased and re-declare the tables that should be exposed:\n\n```sql\nIMPORT connectors.sources AS sources;\n/** Purchases with computed line total. */\nPurchase := SELECT *, quantity * unit_price AS total_price FROM sources.Purchase;\n```\n\nWhen a single table must be a **mutation**, put it in its own connector file and wildcard-import that file, while the read-only sources stay aliased.\n\n### Included projects / multi-project (`script.include`)\n\nA project can import scripts from **another SQRL project**, e.g. a shared data catalog or a metrics layer reused by several pipelines, declared under `script.include` in the project's configuration file. To include another SQRL project, invoke the `/configure-sqrl` skill for configuration. What matters for the language is how the imports resolve:\n\n* At compile time the included project (the directory holding the top-level package file, together with all its subfolders, every `.sqrl` in them is loaded) is **copied into `build/<namespace>/`**, alongside the consumer's own scripts, where `<namespace>` is the key of its `script.include` entry in the configuration file. A script reaches it with a plain **relative** import, like `IMPORT <namespace>.sources AS sources;`, and that is the preferred form. Name include namespaces with underscores (`data_catalog`), because a dash has a different meaning in SQL. When the importing script is in a subdirectory (e.g. `./my-module/module-script.sqrl`), use `IMPORT root.<namespace>.sources;` (see *Path resolution*). Below the namespace the path follows the included project's own directory structure at any depth. Example:`IMPORT data_catalog.customer.customer_data.customer_master-{{environment}} AS cs;`.\n* `{{...}}` in the *consumer's* import statement is substituted from the consumer's own `script.config`; `{{...}}` inside the *included project's* scripts (e.g. a catalog's `{{environment}}` or a `{{^is_batch}}\u2026{{/is_batch}}` section) is rendered with the `script.config` of the package file named by `package`, overridden by `script.include.<namespace>.config`.\n* **Inside an included project, reference sibling scripts with *relative* imports**, so they travel with the copied files. A `root.` import inside an included project breaks once it is consumed: `root` then points at the consumer's build root, not the included project's.\n* A **`standalone`** include (see `/configure-sqrl`) is deployed on its own, so the consumer does not repeat what that deployment writes: the consumer's subscriptions on tables that the include's main script (or its inline imports) subscribes to read the include's topics, and the include's `EXPORT`/`INSERT` statements into the log, its internal Kafka tables and external tables do not run in the consumer (a NOTICE names each). Write your own subscriptions and exports in the consumer's scripts; those always run.\n\n## CREATE TABLE (internal vs external)\n\nSQRL understands the complete Flink SQL `CREATE TABLE` syntax, but distinguishes between **internal** and **external** source tables.\nExternal source tables are standard Flink SQL tables that connect to an external data source (e.g. database or Kafka cluster).\nInternal tables are managed by SQRL through an engine hint (`kafka` or `iceberg`). Kafka internal sources are exposed for data ingestion in the interface.\n\n| Feature           | Internal source (managed by SQRL)                                   | External Source (connector)    |\n|-------------------|---------------------------------------------------------------------|--------------------------------|\n| Connector options | **omitted**; other engine-specific `WITH (...)` options are allowed | **required**                   |\n| Engine hint       | **required**                                                        | Not used to select a connector |\n| Metadata columns  | `METADATA FROM 'uuid'`, `'timestamp'`, `'auth.<claim>'` only        | Passed through                 |\n| Watermark spec    | **generated**                                                       | **required**                   |\n| Primary key       | *Unenforced* upsert semantics                                       | Same as Flink                  |\n\nOn an internal table, use only the metadata keys `'uuid'`, `'timestamp'` and `'auth.<claim>'`. A `METADATA` column without `FROM` uses its column name as the key. Any other key stops the compile with an `Unknown metadata key` error, for example `'auht.sub'` or the Flink Kafka key `'offset'`. If you see that error, correct the key to one of the three supported keys.\n\nExample (internal): An internal table managed by DataSQRL as a Kafka topic carries the `engine(kafka)` hint (see the `/manage-connector` skill):\n\n```sql\n/*+engine(kafka) */\nCREATE TABLE Customer (\n  customerid BIGINT,\n  email STRING,\n  ts TIMESTAMP_LTZ(3) METADATA FROM 'timestamp',\n  PRIMARY KEY (customerid) NOT ENFORCED\n);\n```\n\nThe internal table does not need `WATERMARK` declaration. SQRL generates the watermark for it. \nDeclare a `WATERMARK` explicitely on an internal table only when the user asks for one.\n\nWith `engine(kafka)`, `PARTITIONED BY (col, ...)` on an internal table without a `PRIMARY KEY` keys each record by those columns, both the records the server writes for mutations and the records the pipeline exports into the table, so records with the same key stay on one Kafka partition in order.\nThe key columns can be `uuid` or `auth` metadata columns, but not the `timestamp` metadata column.\nThe Flink source ignores that key and reads every column from the message value, so adding `PARTITIONED BY` to an existing internal table is safe: records written before the table had a key are still read, also when the topic is read again from the earliest offset.\nThis relies on the default `kafka-safe` connector. Do not switch internal Kafka tables to the plain `kafka` connector, which drops records that have no key.\nUse `PARTITIONED BY` when records only need a Kafka key for partitioning and ordering. A `PRIMARY KEY` also keys the records, but it makes the table an upsert table (`VERSIONED_STATE`), and its upsert source drops records that were written without a key.\n\nExample (external): An external table connects to a data system through a `WITH (...)` clause and declares its own `WATERMARK`:\n\n```sql\nCREATE TABLE kafka_json_table (\n  user_id    INT,\n  name       STRING,\n  event_time TIMESTAMP_LTZ(3) NOT NULL METADATA FROM 'timestamp',\n  WATERMARK FOR event_time AS event_time - INTERVAL '1' SECOND\n) WITH (\n  'connector' = 'kafka-safe',\n  'topic'     = 'users',\n  'format'    = 'flexible-json'\n);\n```\n\n- Invoke the `/manage-connector` skill before writing or editing any table with a `WITH (...)` clause i.e. every external source and sink. This section covers the statement syntax only. Use that skill to decide which connector and format to use, the watermark rules for the source type, whether the schema belongs in a separate `_schema` table referenced with `LIKE`, and which values become `${VARIABLE}` references.\n- With the `_schema` + `LIKE` source pattern, the `WATERMARK`, any `METADATA FROM '...'` column, and any computed (`AS ...`) column belong to the **connector table**, never the `_X_schema` table. Invoke the `/manage-connector` skill for those rules.\n\n### File-based sources: watermarks & snapshot aggregation\n\nFile-based sources (`filesystem`, `iceberg`, `hudi`, `deltalake`) behave differently from Kafka streams.\n\n**(A) Watermark column.** A file-based source whose data timestamp is not quasi-monotonic, or whose files do not arrive frequently, watermarks a computed `ingestion_time AS now()` column instead of a data column. The one exception to \"prefer event time\". The rule that decides this belongs to the source table: invoke the `/manage-connector` skill (Event-Time Processing \u2192 Watermarks on production file-based sources).\n\n**(B) Complete-snapshot sources.** If a file source re-lists every object each cycle (e.g. S3 Inventory, full dumps), a global (non-windowed) `GROUP BY` **double-counts** \u2014 it counts each object once per snapshot. Aggregate each snapshot independently with a `SESSION` window over the `ingestion_time AS now()` column from (A), `PARTITION BY` the group key (read [SESSION Windows](guides/session-tvf.md) first): each snapshot's records arrive as one ingestion burst and form one session, so they are counted once. A short session gap (e.g. 1 minute) closes the window shortly after a snapshot finishes loading, while the much larger gap between snapshots keeps them in separate sessions.\n\n**Wrong fixes:** a `PRIMARY KEY` on a filesystem source does **not** dedup (the source is append-only); even a correct `DISTINCT`-dedup mishandles deletions (an object disappears by absence in the next snapshot) and grows unbounded state.\n\n## Definition statements\n\n### Table definition\n\n```\nTableName := SELECT ... ;\n```\n\nEquivalent to a `CREATE VIEW` in SQL.\n\n```sql\nValidCustomer := SELECT * FROM Customer WHERE customerid > 0 AND email IS NOT NULL;\n```\n\nA common pattern is stream enrichment with a temporal join:\n\n```sql\n-- Temporal join for stream enrichment \u2014 intermediate result uses _ prefix\n_EnrichedOrders := SELECT o.*, c.name, c.email\n  FROM Orders o\n  JOIN Customer FOR SYSTEM_TIME AS OF o.event_time AS c\n    ON o.customerid = c.customerid;\n\n-- If the enriched table is exposed directly in the API, use a public name:\n/** Orders enriched with customer details */\nEnrichedOrders := SELECT o.*, c.name, c.email\n  FROM Orders o\n  JOIN Customer FOR SYSTEM_TIME AS OF o.event_time AS c\n    ON o.customerid = c.customerid;\n```\n\n### Timestamp of a join result\n\nFor every join, decide the timestamp of the result: the time when the result row last changed. Choose it by the type of join:\n\n| Join | Timestamp of the result |\n|---|---|\n| Temporal join (`FOR SYSTEM_TIME AS OF`) or interval join | The timestamp of the stream side. Each result row is an event at that time, and the join never changes it later. |\n| Regular join (an inner or outer join without `FOR SYSTEM_TIME AS OF` or a time bound) | Reason about how the result row changes over time. In the common case, both sides change independently. The row then last changed at the later of the two times: `GREATEST(l.ts, r.ts)`. Give `GREATEST` one argument for each joined table that has a timestamp. A table without a timestamp, such as a table of fixed values, never changes, so it adds no argument. `GREATEST` returns `NULL` when one argument is `NULL`. In an outer join, wrap the timestamp of each side that can be missing in `COALESCE` with the timestamp of another side. For example, in a `LEFT JOIN`, write `GREATEST(l.ts, COALESCE(r.ts, l.ts))`. |\n\nA regular join emits a new version of a result row each time either side changes. A row that keeps the timestamp of one side only looks out of date when the other side changes. API clients that sort or filter by that timestamp then get wrong results.\n\nThe Postgres sink writes a new version of a `STATE` row only when this timestamp is not older than the stored one. `GREATEST` goes back to an older timestamp when the optional side of an outer join stops matching, for example because its row is deleted or filtered out. The sink then keeps the old joined values. For such a join, use only the timestamp of the preserved side, such as `l.ts` in a `LEFT JOIN`. It does not show changes of the optional side, but it never goes back.\n\nA `FULL JOIN` has no preserved side. If its sides can stop matching, `CAST` the result timestamp to its type, for example `CAST(GREATEST(...) AS TIMESTAMP_LTZ(3))`, to remove the row-time marker. The sink then writes every version without comparing timestamps.\n\n### DISTINCT operator\n\n```\nDistinctTbl := DISTINCT SourceTbl\n               ON pk_col [, ...]\n               ORDER BY ts_col [ASC|DESC] [NULLS LAST] ;\n```\n\n* Deduplicates a **STREAM** of changelog data into a **VERSIONED_STATE** table.\n* The SQRL `DISTINCT` statement is not SQL `SELECT DISTINCT`.\n* Hint `/*+filtered_distinct_order*/` (see hints) may precede the statement to push filters before deduplication for optimization.\n\n**Use `DISTINCT` when the source table is a `STREAM` of updates to an entity that needs to be converted to a state table, i.e. changelog.** A `DISTINCT` statement adds a stateful operator and changes the semantics of the table.\nCheck the type of the source table before you write one:\n\n| Source table | What to do |\n|---|---|\n| A `STREAM` that carries several records for the same key, for example an append-only change feed | Write the `DISTINCT` statement where a consumer needs a single version per entity, either the current one or the one valid at an event's timestamp in a temporal join. It turns the stream into `VERSIONED_STATE`. |\n| A table that already declares a `PRIMARY KEY` with upsert semantics, for example an `upsert-kafka` source or an internal table with an engine hint and a primary key | Read the table directly. It is `VERSIONED_STATE` already, so a `DISTINCT` on that same key returns the same rows and only costs state. |\n\nRead the `STREAM` directly where a consumer needs the changes themselves, such as a history endpoint, an aggregation over every update, an alert per change, or a stream-to-stream join. When both consumers exist, keep the `STREAM` and define the `DISTINCT` table, if needed, beside it, so each keeps its own semantics.\n\n```sql\n-- Intermediate dedup step (feeds into another table) \u2014 use _ prefix\n_DistinctProducts := DISTINCT Products ON id ORDER BY updated DESC;\n\n-- Final dedup result exposed directly in the API \u2014 use public name\n/** Latest version of each product, deduplicated by id */\nDistinctProducts := DISTINCT Products ON id ORDER BY updated DESC;\n```\n\n### Primary key columns\n\nA table gets a primary key from a `PRIMARY KEY` in its `CREATE TABLE`, or from a `DISTINCT ... ON` or `GROUP BY` on the key columns. Such a table has the type `VERSIONED_STATE` or `STATE` (see [Type System](#type-system)).\n\nClean the primary key columns before the first table that has that primary key, and select them unchanged in every table that reads from that table, directly or through other tables.\nFor example, when `Customer` has the primary key `customer_id`, a later table selects `customer_id`, and never `TRIM(customer_id) AS customer_id`.\n\nA function on a key column in such a later table (`TRIM`, `LOWER`, `REGEXP_REPLACE`, `CAST`, `NULLIF`) hides the key from the Flink planner. A function can turn two different keys into the same value, so the planner treats the result as a normal column, not as a key. Every join that reads the later table stores each full row in its state and finds a row by comparing all of its columns (`NoUniqueKey`), instead of finding it by its key. This makes the state larger and every update slower.\nColumns that are not part of the key can be cleaned in any table.\n\nThese rules apply to entity data (see the `/manage-connector` skill, Entity Data), where each new record replaces the previous version of the same entity, such as a customer or an account.\n\n**Writing entity data.** When the pipeline writes entity data into a table that other tables or projects read, clean the key before the `EXPORT`.\nSuch a table is a mutation table with a `PRIMARY KEY` (an internal table with an engine hint) or a Kafka sink with a `PRIMARY KEY`.\nEvery reader then receives the final key value and can select it unchanged.\nFollow these steps:\n\n1. Clean the key in a view, and keep only the rows whose cleaned key is not empty.\n2. Make the cleaned key unique with `DISTINCT ... ON` the cleaned key.\n3. Export the `DISTINCT` table into the table with the primary key.\n\nIn this example, `RawCustomerUpdate` is the source table the pipeline reads. It has no key, and its `customer_id` values can contain extra spaces or be empty.\n\n```sql\n/*+engine(kafka) */\nCREATE TABLE Customer (\n  customer_id STRING NOT NULL,\n  email STRING,\n  event_time TIMESTAMP_LTZ(3) NOT NULL METADATA FROM 'timestamp',\n  PRIMARY KEY (customer_id) NOT ENFORCED\n);\n\n_CleanCustomerUpdate := SELECT NULLIF(TRIM(REGEXP_REPLACE(customer_id, '\\s+', ' ')), '') AS customer_id,\n                               email, event_time\n                        FROM RawCustomerUpdate\n                        WHERE NULLIF(TRIM(REGEXP_REPLACE(customer_id, '\\s+', ' ')), '') IS NOT NULL;\n\n_LatestCustomerUpdate := DISTINCT _CleanCustomerUpdate ON customer_id ORDER BY event_time DESC;\n\nEXPORT _LatestCustomerUpdate TO Customer;\n```\n\nStep 2 is required.\nIt keeps the latest version of each key by `event_time`, and makes the cleaned key the upsert key of the exported query.\nAn `EXPORT` into a table declared with `CREATE TABLE` gets no generated `ON CONFLICT` clause, so when the upsert key of the exported query differs from the `PRIMARY KEY` of that table, Flink rejects the `EXPORT` with the error `The query has an upsert key that differs from the primary key of the sink table`.\nA view that only cleans and filters a source without a key has no upsert key at all, so exporting it directly fails with this error. Export the `DISTINCT` table instead.\n\n**Reading keys that arrive dirty.** When the writer is outside this project, for example an external client that calls a mutation endpoint, the pipeline cannot clean the key before it is stored.\nClean it in the first table after the mutation instead:\n\n1. Declare the mutation without a `PRIMARY KEY`, so that each write is stored as an event with the key value exactly as the client sent it.\n   A `PRIMARY KEY` on the raw key would make the raw value the key, and cleaning it in a later table would hide that key from the planner.\n2. Clean the key in a view, and keep only the rows whose cleaned key is not empty.\n3. Make the cleaned key unique with `DISTINCT ... ON` the cleaned key. Every later table reads this `DISTINCT` table.\n\n```sql\n/*+engine(kafka) */\nCREATE TABLE CustomerUpdate (\n  customer_id STRING NOT NULL,\n  email STRING,\n  event_time TIMESTAMP_LTZ(3) NOT NULL METADATA FROM 'timestamp'\n);\n\n_CleanCustomerUpdate := SELECT NULLIF(TRIM(REGEXP_REPLACE(customer_id, '\\s+', ' ')), '') AS customer_id,\n                               email, event_time\n                        FROM CustomerUpdate\n                        WHERE NULLIF(TRIM(REGEXP_REPLACE(customer_id, '\\s+', ' ')), '') IS NOT NULL;\n\n/** Current version of each customer, with the cleaned id as primary key */\nCustomer := DISTINCT _CleanCustomerUpdate ON customer_id ORDER BY event_time DESC;\n```\n\nFollow the same steps for an external source whose keys can arrive dirty.\nWhen an external source's keys always arrive clean, read its key unchanged and skip the cleaning.\n\nClean the key in a view, as shown above, and not inside the `CREATE TABLE`.\nFlink accepts a `PRIMARY KEY` only on physical columns, so a computed column such as `customer_id AS TRIM(raw_customer_id)` cannot be the key.\n\nThe `/*+primary_key(...)*/` hint does not fix this: it declares the key for DataSQRL, but does not deduplicate the data and is not visible to Flink.\nWhen the hint is placed on a state table whose rows the query does not keep unique on the hinted columns, the compiler warns with `PRIMARY_KEY_NOT_UNIQUE`. Do not ignore this warning: replace the hint with `DISTINCT ... ON` the cleaned key.\n\n### Function definition\n\n```\nFuncName(arg1 TYPE [NOT NULL] [, ...]) :=\n  SELECT ... WHERE col = :arg1 ;\n```\n\nArguments are referenced with `:name` in the `SELECT` query. Argument definitions are identical to column definitions in `CREATE TABLE` statements.\n\n```sql\nCustomerByEmail(email STRING) := SELECT * FROM Customer WHERE email = :email;\n```\n\n#### Accessing JWT payload\n\nTo access the JWT payload included in the Authorization HTTP header, you can use the `METADATA` expression within the function definition. The text after `auth.` is the name of a claim in the JWT payload:\n\n* `'auth.val'` reads the top-level claim `val`.\n* `'auth.org.id'` reads the field `id` of the object claim `org`. A path can go to any depth, for example `'auth.org.location.zip'`.\n* A key can contain dots, at the top level and inside an object, for example the namespaced claim `https://example.com/org`. At each level, the server uses the longest key that it finds, and then follows the rest of the path. So `'auth.https://example.com/org_id'` reads a top-level claim, and `'auth.https://example.com/org.id'` reads the field `id` of the claim `https://example.com/org`. In the same way, `'auth.resource_access.com.example.app.roles'` reads the field `roles` of the key `com.example.app` inside the claim `resource_access`.\n* A path can end on an array. In the SQRL script, declare the function argument with an `ARRAY<...>` type, for example `roles ARRAY<STRING> NOT NULL METADATA FROM 'auth.realm_access.roles'`.\n* Array indexing does not work. For example, `'auth.realm_access.roles.0'` does not read the first role. The server treats it as a missing claim. To check for one item, read the full array and use `array_contains` in the query.\n* Give each segment of the path a name. A key with an empty segment, such as `'auth.org.'` or `'auth.org..id'`, stops the compile with an `Invalid metadata key` or `Unknown metadata key` error.\n* When the token has no claim at the path, a request fails with `403 Forbidden` for a `NOT NULL` argument. A nullable argument gets `null`.\n\nIn the example below, the JWT payload contains a val field, which is an integer.\n\n```sql\nAuthFilter(mySecretId BIGINT NOT NULL METADATA FROM 'auth.val') :=\n  SELECT c.* \n  FROM Customer c \n  WHERE c.customerId = :mySecretId;\n```\n\nA script that reads a claim needs an auth provider in `engines.vertx.config`. This applies to a function argument and to a mutation column. The provider is an `auth` block with at least one issuer. The deprecated `jwtAuth`, or `oauthConfig` with `oauth2Options.site`, also gives a provider. Without a provider, the server checks no token. The compile then fails with the error `The script reads JWT claims (...), but engines.vertx.config has no auth provider.` If you see that error, add an `auth` block with the `/configure-sqrl` skill, and keep the `METADATA FROM 'auth.<claim>'` columns. The check also covers a claim function that a custom GraphQL schema leaves out. If the API must not expose that function, start its name with `_`. The `/*+no_query*/` hint does not help here, because it works only on tables.\n\n### Relationship definition\n\n```\nParentTable.RelName(arg TYPE, ...) :=\n  SELECT ...\n  FROM Child c\n  WHERE this.id = c.parentId\n  [AND c.col = :arg ...] ;\n```\n\n`this.` is the alias for the parent table to reference columns from the parent row.\n\n```sql\nCustomer.highValueOrders(minAmount BIGINT) := SELECT * FROM Orders o WHERE o.customerid = this.id AND o.amount > :minAmount;\n```\n\n### Column-addition statement\n\n```\nTableName.new_col := expression;\n```\n\nMust appear **immediately after** the table definition it extends, and may reference previously added columns of the same table. Cannot be applied after `CREATE TABLE` statements.\n\n\n### Relation alias as ROW\n\nA relation alias is the alias of any `FROM` item: a table, a view, a subquery or a CTE. Used by itself in a `SELECT` list, it produces one `ROW` value holding every column of that relation. The API exposes the column as a nested object. \nThe compiler expands the alias to `CAST(ROW(c.col1, ...) AS ROW<...>)` from the relation's validated columns, so the alias replaces writing that cast by hand.\n\nExamples:\n```sql\nTableName := SELECT o.id, c AS customer FROM Orders o JOIN Customer c ON o.customerid = c.customerid;\n```\n\n```sql\n/** Orders with the customer as it was when the order was placed */\nOrderWithCustomer := SELECT o.id, o.amount, o.event_time, c AS customer\n  FROM Orders o\n  JOIN Customer FOR SYSTEM_TIME AS OF o.event_time AS c\n    ON o.customerid = c.customerid;\n```\n\nThe `FOR SYSTEM_TIME AS OF` clause selects the customer version valid at `o.event_time`. The alias itself packs whichever row the join produced.\n\n* The flink row carries every column of the relation, including its timestamp column. A `_`-prefixed column is stored inside the row and omitted from the API type.\n* A column named like the alias takes precedence, and the alias then resolves to that column. Give the alias a name no column uses when you want the row.\n* A bare alias, `SELECT customerid, c FROM Customer c`, names the column after the alias. `c AS customer` names it explicitly.\n* The alias combines with `o.*`, works inside CTEs and subqueries, and works with `LEFT JOIN`, where the row stays non-null and every field inside it becomes nullable.\n* Read a field back downstream with dot access: `SELECT x.id, x.customer.name FROM OrderWithCustomer x`.\n* Copy a field out as its own column as well, `c.tier AS customer_tier`, when the API filters or sorts by it. The nested value is one JSON column in the database and carries no relationships or filter arguments of its own.\n\nRead the [Stream Enrichment](guides/stream-enrichment.md) guide to choose between the whole-row alias, copied scalar columns, and a relationship.\n\n### Passthrough definitions\n\nPassthrough definitions allow you to bypass SQRL's analysis and translation, passing SQL queries directly to the underlying database engine.\nThis serves as a \"backdoor\" for SQL constructs that SQRL does not yet support natively.\n\nPassthrough table, function, or relationship definition have a `RETURNS` clause in their signature that defines the result type of the query.\n\n```\nTableName RETURNS (column TYPE [NOT NULL], ...) := \n  SELECT raw_sql_query;\n```\n\n**\u26a0\ufe0f Important considerations:**\n- SQL must be written in the exact syntax of the target database engine\n- SQRL will not validate, parse, or optimize the query\n- Only use when SQRL lacks native support for the required functionality\n- Return type must be explicitly declared using the `RETURNS` clause\n- Passthrough queries must be assigned to a database engine for execution\n\nThe following defines a relationship definition with a recursive CTE that is passed through to the\ndatabase engine for execution.\nUse `this` to reference parent fields in a relationship definition or `:name` to reference function\narguments as in standard definitions. The only thing that changes is that adding a `RETURNS` declaration\nbypasses the SQRL analysis, optimization, and query rewriting.\n\n```sql\nEmployees.allReports RETURNS (employeeid BIGINT NOT NULL, name STRING NOT NULL, level INT NOT NULL) :=\n  WITH RECURSIVE employee_hierarchy AS (\n    SELECT r.employeeid, r.managerid, 1 as level\n    FROM \"Reporting\" r\n    WHERE r.managerid = this.employeeid\n    \n    UNION ALL\n    \n    SELECT r.employeeid, r.managerid, eh.level + 1 as level\n    FROM \"Reporting\" r\n    INNER JOIN employee_hierarchy eh ON r.managerid = eh.employeeid\n  )\n  SELECT e.employeeid, e.name, eh.level\n  FROM employee_hierarchy eh\n  JOIN \"Employees\" e ON eh.employeeid = e.employeeid\n  ORDER BY eh.level, e.employeeid;\n```\n\n## Functions\n\nSQRL supports the Flink 2.3-compatible built-in functions plus its own scalar, aggregate, and table functions. [Look up the required function](functions.md).\n\n## Interfaces\n\nThe tables and functions defined in a SQRL script are exposed through an interface.\nThe term \"interface\" is used generically to describe a means by which a client, user, or external system can access the processed data.\nThe interface depends on the configured engines: API endpoints for servers, queries and views for databases, and topics for logs.\nAn interface is a sink in the data processing DAG that's defined by a SQRL script.\n\nHow a table or function is exposed in the interface depends on the access type. The access type is one of the following:\n\n| Access type              | How to declare               | Surface                                                                                              |\n|--------------------------|------------------------------|------------------------------------------------------------------------------------------------------|\n| **Query** (default)      | no modifier                  | GraphQL query / SQL view / log topic (pull)                                                          |\n| **Subscription**         | prefix body with `SUBSCRIBE` | GraphQL subscription / push topic                                                                    |\n| **No direct query**        | `/*+no_query*/` hint         | still **in** the interface, reachable through a relationship or an explicit function but cannot be queryable directly |\n| **Not in the interface but intermediate step** | object name starts with `_`  | not exposed at all                                                                                   |\n\nExample:\n\n```sql\nHighTempAlert := SUBSCRIBE\n                 SELECT * FROM SensorReading WHERE temperature > 50;\n```\nDefines a subscription endpoint that is exposed as a GraphQL subscription or Kafka topic depending on engine configuration.\nThe assignment operator comes first and the `SUBSCRIBE` keyword comes after it (`Name := SUBSCRIBE SELECT ...`).\n\n```sql\nHighTemperatures := SELECT * FROM SensorReading WHERE temperature > 50;\n```\nDefines a query table that is exposed as a query in the API or view in the database.\n\n```sql\nHighTemperatures(temp BIGINT NOT NULL) := SELECT * FROM SensorReading WHERE temperature > :temp;\n```\nDefines a query function that is exposed as a parametrized query in the API.\n\n```sql\n_HighTemps := SELECT * FROM SensorReading WHERE temperature > 50;\n```\nDefines an internal table that is not exposed in the interface.\n\n### `_` prefix vs. `/*+no_query*/` \u2014 different semantics, never interchangeable\n\n* **`_` prefix** \u2014 the object is **not part of the interface at all**: no endpoint, no generated type, unreachable from any client. This is what pipeline intermediates use (dedup, enrichment, filter and join steps).\n* **`/*+no_query*/`** \u2014 the object **is** part of the interface through relationship but it cannot be queryable directly. Use it for a table clients reach only through a relationship from its parent.\n\n```sql\n-- Clients reach Purchase only through Order, so it has no query endpoint of its own.\n/** A line of a purchase order, with its total price (quantity times unit price). */\n/*+no_query */\nPurchase := SELECT *, quantity * unit_price AS total_price FROM sources.Purchase;\nPurchase.offering := SELECT * FROM Offering o WHERE o.offering_id = this.offering_id LIMIT 1;\nPurchase.customer := SELECT * FROM Customer c WHERE c.customer_id = this.customer_id LIMIT 1;\n\n/** The lines of one purchase order, sorted by offering id. Empty when no order has this id. */\nOrder(order_id STRING NOT NULL) := SELECT * FROM Purchase WHERE order_id = :order_id ORDER BY offering_id ASC;\n```\n\nApplying `no_query` to a `_`-prefixed table is illogical. Pick one: `_` for a pipeline intermediate, `no_query` for an interface object that must not have its own query endpoint.\n\n### CREATE TABLE\n\nCREATE TABLE statements that define an internal data source are exposed as topics in the log, or GraphQL mutations in the server.\nThe input type is defined by mapping all column types to native data types of the interface schema. Computed and metadata columns are not included in the input type since those are computed on insert.\n\n## EXPORT statement\n\n```\nEXPORT source_identifier TO sinkPath.QualifiedName ;\n```\n\n* `sinkPath` maps to a connector table definition when present, or one of the **built-in** sinks:\n    * `print.*` \u2013 stdout\n    * `logger.*` \u2013 uses configured logger\n    * `log.*` \u2013 topic in configured log engine\n\n```sql\nEXPORT CustomerTimeWindow TO print.TimeWindow;\nEXPORT MyAlerts          TO log.AlertStream;\n```\n\nAn export may also target one table in another script, for example `EXPORT CustomerSubset TO connectors.sinks.CustomerExport;`. The target must be either an external connector table or an engine-managed internal table.\n\n\n## Hints\n\nHints live in a `/*+ ... */` comment placed **immediately before** the definition they apply to.\n\n| Hint                        | Form                                                                       | Applies to     | Effect                                                                                                                                                                             |\n|-----------------------------|----------------------------------------------------------------------------|----------------|------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------|\n| **primary_key**             | `primary_key(col, ...)`                                                    | table          | declare the key when the compile fails with `Could not determine primary key for table [...]`; does not deduplicate (see Primary key columns)                                                                                             |\n| **index**                   | `index(type, col [ASC\\|DESC], ...)` <br/> Multiple `index(...)` can be comma-separated | table          | replaces automatic index selection for this table. `type` \u2208 `HASH`, `BTREE`, `PBTREE`, `TEXT`, `VECTOR_COSINE`, `VECTOR_EUCLID`; `DESC` is supported only for `BTREE` and `PBTREE`. <br />`index` *alone* disables all automatic indexes, except the row-time index of a table behind a paginated query |\n| **partition_key**           | `partition_key(col, ...)`                                                  | table          | define partition columns for sinks that support partitioning                                                                                                                       |\n| **vector_dim**              | `vector_dim(col, 1536)`                                                    | table          | declare fixed vector length. This is required when using vector indexes.                                                                                                           |\n| **query_by_all**            | `query_by_all(col, ...)`                                                   | table          | generate interface with *required* filter arguments for all listed columns                                                                                                         |\n| **query_by_any**            | `query_by_any(col, ...)`                                                   | table          | generate interface with *optional* filter arguments for all listed columns                                                                                                         |\n| **no_query**                | `no_query`                                                                 | table          | prevent the table from being directly queryable but reachable through relationships and explicit functions (see *Interfaces*)                        |\n| **insert**                  | `insert(type)`                                                             | table          | controls the way how mutations will be written to their target sink. `type` \u2208 `SINGLE` (default), `BATCH`, `TRANSACTION`                                                           |\n| **ttl**                     | `ttl(duration)`                                                            | table          | specifies how long the records for this table are retained in the underlying data system before it can be discarded. Expects a duration string with a unit between minute and day, e.g. `30 min`, `36 hours`, `14 days`. Disabled by default. |\n| **cache**                   | `cache(duration)`                                                          | table          | how long the results retrieved from this table can be cached on the server before they are refreshed. Expects a duration string like `10 seconds`. Disabled by default.            |\n| **filtered_distinct_order** | flag                                                                       | DISTINCT table | eliminate updates on order column only before dedup                                                                                                                                |\n| **engine**                  | `engine(engine_id)`                                                        | table          | on a table definition, select the engine that computes the table, such as `flink` or `postgres` (see [Where a table runs](#where-a-table-runs)). On a `CREATE TABLE`, name the engine that manages the internal table, such as `kafka` (see [CREATE TABLE](#create-table-internal-vs-external)). `exec` is a deprecated alias of `engine` |\n| **maintenance**             | `maintenance(type)`                                                        | table          | table maintenance for engines that support it. `type` \u2208 `NONE`, `REGULAR`; `REGULAR` on an Iceberg table adds the `iceberg-maintenance` connector options |\n| **row_count**               | `row_count(count)` or `row_count(col, ..., count)`                         | table          | estimated total row count (e.g. `1e6`), or the number of distinct values for the listed column combination. Used for query optimization and index selection: a table with a total row count of at most 100 (`small-table-row-limit` of the `postgres` engine) gets no automatic index (see [Indexes for API Queries](guides/api-query-indexes.md)) |\n| **test**                    | `test` or `test(no_rows)`                                                  | table          | marks test case, only executed with `test` command.                                                                                                       |\n| **workload**                | `workload`                                                                 | table          | retained as sink for DAG optimization but hidden from interface                                                                                                                    |\n\nMultiple hints are comma-separated inside one comment. This example configures the vector length and a vector index for the `SensorTempByHour` table:\n\n```sql\n/*+vector_dim(embedding, 1536), index(VECTOR_COSINE, embedding) */\nSensorTempByHour := SELECT ... ;\n```\n\nSQL matches column names case-sensitively, but hints do not. A plain column name in a hint matches the column with the same name, ignoring case, so `primary_key(CUSTOMERID)` matches `customerId`. A name in backticks only matches the column with exactly that name. When a table has columns whose names differ only in case, such as `cnt` and `CNT`, a plain name fails the compile with `matches columns that differ only in case`: write the name in backticks, like ``index(BTREE, `CNT`)``, or rename one of the columns. The required columns of a tag in `compiler.tags` match the same way.\n\nFor choosing between `query_by_all` (required filter arguments) and `query_by_any` (optional filter arguments) when designing table access, invoke the `/design-api` skill (Table Hints for Table Access).\n\n### Where a table runs\n\nThe compiler runs each table in Flink or in the database, and picks the cheaper of the two. The `engine` hint replaces this choice for one table:\n\n- `/*+engine(flink) */`: Flink engine computes the rows when the data arrives. When the API reads the table, Flink writes the rows to a Postgres table, and the compiler can index its columns.\n- `/*+engine(postgres) */`: Postgres engine stores no rows for the table. When the API reads the table directly, the compiler creates a view with the query of the table. Otherwise, it copies the query into each served query that reads the table. Postgres computes the rows on every request.\n\nA table definition accepts only an enabled engine that can compute a table:\n\n| Engine     | Engine type |\n|------------|-------------|\n| `flink`    | `process`   |\n| `postgres` | `database`  |\n| `iceberg`  | `database`  |\n\nThe hint also accepts the engine type like `engine(database)`, but compiler selects the engine. Use the engine name. Other engines, such as `kafka`, `vertx`, `duckdb` or `snowflake`, cannot compute a table. For what each engine does and when to enable it, see the `/configure-sqrl` skill.\n\nLeave the choice to the compiler, unless a table needs an index that the compiler cannot give it. A served query can use an index only on rows that the database stores. A table that runs in Postgres stores no rows, so no index can serve a column that it computes, such as a `CONCAT_WS` text for `text_search` or a `CAST` value for a filter. In that case, add `/*+engine(flink) */` to the table: Flink computes the column ahead of time, and Postgres stores it in a table that can have an index. The hint also moves every table that this table reads into Flink, because a table in Flink can read only from Flink or Kafka. So the hint costs Flink state for this table and for each upstream table that ran in Postgres before, plus one more database table. Read the `Stage:` lines of the upstream tables after the compile.\n\nAfter compile, read the `Stage:` line of the table in `pipeline_explain.txt` in the build folder to see which engine computes it.\n\nPut the `engine` hint on a table definition. An API function always runs in the database, so `engine(flink)` on a function fails with `Provided execution stages could not be found or are not configured`.\nA table in Postgres cannot feed a table in Flink. Pinning such a table to `postgres` fails with `Could not find execution stage for [table ...]`.\n\n### Filters in API queries\n\nDataSQRL creates the database indexes for the tables that the API queries. The database (Postgres) can use an index only when the filtered column stands alone in the comparison, so write every served query in the following form:\n\n- Compare the bare column: `customer_id = :customerId`.\n- Do a type conversion or a derived value in a table that Flink computes, then filter on the result: add `/*+engine(flink) */` to the table, select `CAST(c.customer_id AS STRING) AS customer_id` in it, and filter on `customer_id = :customerId`. A table that runs in the database (an `engine(database)` hint, or the planner's choice) is copied into the served query, so its `CAST` ends up in the filter again. A function on the column in the filter, such as `CAST(customer_id AS STRING) = :customerId` or `LOWER(email) = :email`, makes the database read the whole table.\n- Put arithmetic on the parameter side: `day_index = :day - 1`.\n- In a `JOIN`, put the table that the `WHERE` clause filters with a parameter first. With the other order, the database reads every row of the table that the `WHERE` clause does not filter. Write `FROM AccountOwners o JOIN Orders c ON c.customer_id = o.customer_id WHERE o.account_id = :accountId`, not `FROM Orders c JOIN AccountOwners o ON o.customer_id = c.customer_id WHERE o.account_id = :accountId`.\n- To filter on another table, put `EXISTS (...)` or `IN (SELECT ...)` in the `WHERE` clause and combine it with the other conditions by `AND`: `FROM Orders c WHERE EXISTS (SELECT 1 FROM AccountOwners o WHERE o.account_id = :accountId AND o.customer_id = c.customer_id)`. When the subquery compares with the outer columns only by `=`, the compiler indexes both tables, so the database can start from either one. With `NOT EXISTS (...)`, `NOT IN (SELECT ...)`, or a subquery that is part of an `OR`, the database reads every row of the outer table that the other conditions leave.\n\nThe compiler creates no index for a filter that wraps its column in an expression, and warns `The filter ... cannot use an index on table ...`, with the fix. It does not warn about the order of the tables in a `JOIN`.\n\n### Indexes for API queries\n\nThe compiler selects the indexes for the tables that the API queries. An `index` hint replaces the automatic index selection for its whole table, so a hint that one query does not need can remove the indexes that other queries need. Leave the index selection to the compiler. Read [Indexes for API Queries](guides/api-query-indexes.md) and fix the query only in these cases:\n\n- The requirements, the plan or a review issue name a slow query or an index.\n- The compiler warns that query filter patterns of a table \"have no supporting index and require a full table scan\". Read the guide before you add the `index` hint that the warning suggests.\n\n\n### Constraints and mutual exclusions\n\n**Never combine `/*+no_query*/` with a `_`-prefixed name.** They are used for different purposes (see *Interfaces*): `_` removes the object from the interface entirely and it is used for intermediate processes. On the other hand, table with `no_query` hint cannot be queried directly while is accessible through relationship from other tables.\n\n**`query_by_all` / `query_by_any` need a queryable table.** They generate interface filter arguments, so they are meaningless on a `_`-prefixed table.\n\n", "truncated": true, "truncatedBy": "bytes", "totalLines": 761, "totalBytes": 61477, "outputLines": 643, "outputBytes": 51198, "lastLinePartial": false, "firstLineExceedsLimit": false, "maxLines": 2000, "maxBytes": 51200}}, "isError": false, "durationMs": 5, "timestamp": 1795509905385}, {"role": "toolResult", "toolCallId": "call_01a20cbae7437a52a34f2a01", "toolName": "read", "content": [{"type": "text", "text": "---\nname: design-api\ndescription: Use when designing or modifying the API exposed by a DataSQRL data pipeline. Use for GraphQL, REST, or MCP endpoints, access control, or data serving requirements. Use for adjusting exposed GraphQL schema.\n---\n\nPrefer designing the API implicitly by defining tables, functions, and relationships in SQRL that map to the desired API. After compiling, the generated API schema is found in `build/inferred_schema.graphqls`.\nOnly configure an explicit schema in the `package.json` configuration if:\n- the schema needs to be static (e.g. to align with consumers of the API)\n- the user wants to adjust the schema (e.g. introduce enums, add interfaces, remove fields from result types, or rename/consolidate types). To remove an endpoint, change the SQRL script instead (see Schema Customization below)\n\nUse the `/configure-sqrl` skill to configure the API, which protocols to expose, and how the exposed API endpoints are generated.\n\n## Key Concepts\n\nDataSQRL generates APIs from SQRL scripts with support for **GraphQL**, **REST**, **MCP**, and **Data Products**.\n\n**Critical:** GraphQL is the authoritative model. All API requests (REST, MCP) are executed by the GraphQL query engine.\n\n## SQRL to GraphQL Mapping\n\n**Tables/Functions \u2192 Endpoints:**\n- Default: Query endpoints (name and arguments match)\n- With `SUBSCRIBE`: Subscription endpoints. **Before compiling any SUBSCRIBE statement, add `kafka` to `enabled-engines` in ALL package.json files.** Omitting kafka produces BUILD SUCCESS but the Subscription type will be silently absent from the generated schema.\n- `CREATE TABLE` with `+engine` hint: Mutations (input excludes computed/metadata columns)\n\n**IMPORTANT**: Only tables defined in the main script (or imported inline with `IMPORT otherscript.*`) are exposed in the API. \n\n**Schema Generation:**\n- Tables \u2192 GraphQL types (columns \u2192 fields, nested rows \u2192 child objects)\n- Relationships \u2192 relationship fields on types\n- Compiler infers base tables to avoid redundant result types\n- Hidden columns (starting with `_`) excluded from result types\n\n**Example:**\n```sql\nCustomer := SELECT customerId, email, name FROM RawCustomer WHERE email IS NOT NULL;\n```\nMaps to GraphQL query `Customer(limit: Int = 10, offset: Int = 0): [Customer!]` with type containing the three fields. Every query that returns multiple rows gets `limit`/`offset` pagination arguments; the `limit` default is the table's own `LIMIT` if it has one, otherwise `compiler.api.default-limit` (10).\n\n**Schema Customization (preserving object-relationship mapping):**\n- Change cardinalities, scalar types, mutation argument names, field types\n- Add enums and interfaces\n- Compiler validates compatibility with SQRL script(s)\n- Leaving a query, relationship, or subscription out of the schema does not stop the compiler from computing it. The compiler lists such endpoints in a warning, except those on Iceberg: an Iceberg table is a data product that other engines read from the catalog. A Postgres endpoint is listed even when something reads its view directly. `test` uses the inferred schema by default, so it does not warn: check the output of `compile`. To stop computing an endpoint that nothing in the schema reads, remove it or start its name with `_`. If the table has to stay, because it is a mutation table or a relationship or table function in the schema returns its rows, hint it `/*+no_query*/` instead (see [interface.md](interface.md)).\n- A relationship field resolves to `<GraphQL type name>.<field name>` or, if there is neither such a relationship nor a column with that name, to the relationship on the base table. All tables/functions that return a type must resolve its relationship fields the same way (see [interface.md](interface.md)).\n\n## REST and MCP Endpoints\n\n**Auto-generated from GraphQL:**\n- Queries \u2192 MCP tools with `Get` prefix, REST GET endpoints under `rest/queries`\n- Mutations \u2192 MCP tools with `Add` prefix, REST POST endpoints under `rest/mutations` (nested inputs become nested JSON tool arguments)\n- `@api(mcp: NONE)` on a query or mutation field omits its generated operation from MCP\n- Results follow relationships in GraphQL up to configured `max-result-depth`\n- Mutation input types are followed to the leaf input types to construct the expected request payload. \n- MCP apps (interactive HTML UIs for MCP tools) are self-contained `.html` files in the directory set by `script.api.<version>.mcp-apps`. A tool is linked to the app with its name, or to the one its `appName` names; names match regardless of case (see [interface.md](interface.md))\n- MCP is served over Streamable HTTP at `/<version>/mcp` (e.g. `/v1/mcp`) and supports MCP protocol versions `2024-11-05`, `2025-03-26`, `2025-06-18`, and `2025-11-25`. The server echoes the client's requested version if supported, otherwise it responds with `2025-11-25` (see [interface.md](interface.md)).\n\n### Custom Operations\n\nDefined in `.graphql` files and configured in `package.json` under `script.api.<version>.operations`. The top-level `script.operations` is deprecated.\n\n```graphql\n# Returns up to 10 people of the given age.\nquery GetPersonByAge($age: Int!)\n  @api(rest: GET, mcp: TOOL, uri: \"/queries/personByAge/{age}\") {\n  Person(age: $age, limit: 10, offset: 0) { name email }\n}\n```\n\n**`@api` Directive:**\n- `rest`: `NONE` | `GET` | `POST` (HTTP method or disable)\n- `mcp`: `NONE` | `TOOL` (not exposed, or MCP tool)\n- `uri`: RFC 6570 template (args in template = path params, others = payload requiring POST)\n- `appName`: links the tool to the MCP app of that name; `appName: \"\"` links none (see MCP Apps in [interface.md](interface.md))\n- `visibility`: `[MODEL]` | `[APP]` | `[MODEL, APP]` (who an MCP tool is for when MCP apps are used; default both; applied by the host, not an access restriction)\n\n**Rules:**\n- Operation name = MCP tool name = REST endpoint name (must be unique)\n- `compiler.api.endpoints: OPS_ONLY` to expose only custom operations and restrict a public GraphQL endpoint to those stored named operations. `GRAPHQL` keeps public GraphQL flexible while exposing only explicit REST/MCP operations; `FULL` is the default and adds generated operations.\n\n## API Descriptions\n\nAPI consumers read these descriptions in GraphQL, REST (OpenAPI) and MCP. Each one comes from a single source:\n\n| API part | Source of the description |\n|---|---|\n| Generated schema | The SQRL `/** ... */` doc-strings, with their `# Columns:` and `# Arguments:` sections (see `/implement-sqrl`, Comments & Doc-strings) |\n| Custom schema | The `\"...\"` or `\"\"\"...\"\"\"` descriptions in the schema file. A `#` line above a type, field, argument, input field or enum value without a `\"...\"` description also becomes its description. The SQRL doc-strings do not reach the API |\n| Custom operation | All `#` lines above the operation, back to the end of the previous operation or to the top of the file, joined with spaces into one text. So a `#` note between two operations, or in the file header, becomes part of the next operation's description. They describe the REST operation and the MCP tool. A `#` line above a variable describes that argument in MCP, and in the REST request body of a `POST` operation. A `\"\"\"` description before an operation fails the compile with `Invalid syntax` |\n\nWrite every description for the API consumer. Describe each field, argument, input field and enum value whose name does not show its full meaning. For a mutation field in a custom schema, state what it creates or changes and what it returns.\n\nExample from a custom schema:\n\n```graphql\n\"The status of an event or action item.\"\nenum UpdateStatus {\n  \"Not started or in progress. The default when no update has set a status.\"\n  open\n  \"Completed.\"\n  done\n}\n\ntype Query {\n  \"One event by its key, or null when it does not exist or the caller cannot see it.\"\n  Event(\n    \"Subject identifier of the event's author.\"\n    author_sub: String!,\n    \"Business time of the event in epoch seconds.\"\n    event_time: Long!\n  ): EventData\n}\n\ntype Mutation {\n  \"\"\"\n  Creates an event, or replaces the existing event with the same key, and returns the stored event.\n  \"\"\"\n  upsertEvent(event: upsertEventInput!): upsertEventResultOutput!\n}\n```\n\nPut maintainer notes where DataSQRL does not publish them. In an operations file, write them as `#` lines inside the operation body. For a custom schema, write them as `--` comments in the SQRL script.\n\n## API Entrypoints\n\nTo specify how the tables defined in the SQRL script are accessed you either use access hints or explicit table functions.\n\n### Table Hints for Table Access\n\nThe `query_by_*` hints add the listed columns as arguments to the table query endpoint.\n\n- `/*+query_by_all(col, ...)*/`: Required filter arguments: the argument must be supplied in every API call. Use it only when that column is always required to retrieve the data.\n- `/*+query_by_any(col, ...)*/`: Optional filter arguments. Use it when requirements say \"also by X\", \"queryable by X\", or \"filter by X\".\n- `/*+no_query*/`: no query endpoint of its own. The table stays in the API and is reached through a relationship or an explicit table function\n- `_` prefix: not in the API at all (pipeline intermediate). \n\nNote: Never use `_` prefix with `no_query` as they are used for different purposes. See the `/implement-sqrl` skill (SQRL Language Spec, Interfaces) for the distinction.\n\n### Explicit Table Function\n\nTable functions are exposed as separate query endpoints in the API.\n\n```sql\nCustomerByIdRange(fromId BIGINT NOT NULL, toId BIGINT NOT NULL) := SELECT * FROM Customer WHERE customerId >= :fromId AND customerId < :toId ORDER BY customerId;\n```\n\nThis definition maps to query endpoint `CustomerByIdRange(fromId: Long!, toId: Long!, limit: Int = 10, offset: Int = 0): [Customer!]`.\n\n### Authentication & Authorization\n\nDataSQRL authenticates JWT tokens as configured in the server engine and maps claims to function arguments with `METADATA FROM 'auth.[claim-name]'`. A dot in the claim name steps into a nested object claim: `'auth.org.id'` reads the field `id` of the claim `org`. A key can also contain dots, at the top level and inside an object. At each level, the server uses the longest key that it finds in the token, and steps into objects only for the rest of the path. For example, `'auth.https://example.com/org_id'` reads the top-level claim `https://example.com/org_id`, `'auth.https://example.com/org.id'` reads the field `id` of the claim `https://example.com/org`, and `'auth.resource_access.com.example.app.roles'` reads the field `roles` of the key `com.example.app` inside the claim `resource_access`.\n\n```sql\nMyUser(customerId BIGINT NOT NULL METADATA FROM 'auth.userId') :=\n  SELECT c.* FROM Customer c WHERE c.customerId = :customerId LIMIT 1;\n```\n\nMaps to query endpoint `MyUser: Customer`; `customerId` is populated from the `userId` claim and is not a caller-supplied API argument.\n\nRead [authorization configuration](authorization.md) to configure authentication with the `auth` block and to generate test tokens.\n\n## API Versioning and OpenAPI\n\nTop-level `script.graphql` and `script.operations` configure one `v1` API.\nUse `script.api` to serve multiple versions concurrently; version names are `v` followed by a number.\nA version can configure a schema, operations, or an OpenAPI compatibility baseline; SQRL infers the schema when one is not configured.\nWhen `script.api` is present, it defines the API versions and the top-level API fields do not apply.\n\nSQRL generates OpenAPI from the REST-exposed GraphQL operations for every compiled API version.\nIt is a generated description, not a second API definition.\nConfigure `script.api.<version>.openapi` with a prior generated document only to have compilation reject backwards-incompatible REST changes.\n\n## Testing\n\nUse the `/test-sqrl` skill to implement tests against the API.\n\n## More Information\n\nReview the [reference documentation](interface.md) for additional details:\n\n* how SQRL table/function/relationship definitions map to GraphQL\n* how REST/MCP endpoints are derived from GraphQL\n* how to define explicit operations to explicitly defined REST/MCP API\n* how API requests are executed\n"}], "isError": false, "durationMs": 3, "timestamp": 1795509905388}, {"role": "assistant", "content": [{"type": "thinking", "thinking": "I should read the authorization reference and configure-sqrl and from-api skills. Also test-sqrl and monitor-pipeline. Let me read the authorization.md referenced.", "thinkingSignature": "reasoning_content"}, {"type": "toolCall", "id": "call_01a20cbaecc57a119527cc10", "name": "read", "arguments": {"path": "/opt/agent/skills/design-api/authorization.md"}}, {"type": "toolCall", "id": "call_01a20cbaecf47981a1011318", "name": "read", "arguments": {"path": "/opt/agent/skills/configure-sqrl/SKILL.md"}}], "api": "openai-completions", "provider": "together", "model": "deepseek-ai/DeepSeek-V4.1-Flash", "usage": {"input": 14465, "output": 127, "cacheRead": 42112, "cacheWrite": 0, "reasoning": 34, "totalTokens": 56704, "cost": {"input": 0.0043395, "output": 0.0001524, "cacheRead": 0.000252672, "cacheWrite": 0, "total": 0.004744571999999999}}, "stopReason": "toolUse", "timestamp": 1795509905392, "responseId": "584fe2b37dc843e9ad353d73e3705c51-aws_ec1", "rawStopReason": "tool_calls", "durationMs": 1448, "thinkingLevel": "high"}, {"role": "toolResult", "toolCallId": "call_01a20cbaecc57a119527cc10", "toolName": "read", "content": [{"type": "text", "text": "## Authentication Configuration\n\nConfigure authentication in the `vertx` engine with the `auth` block: the list of trusted token issuers, each with its\nown audiences and signing keys. A token is accepted only when its `iss`, `aud` and signature all match the same issuer.\nThe full reference, including the deprecated `jwtAuth` and `oauthConfig` blocks, is in the `/configure-sqrl` skill\n([vertx.md](../configure-sqrl/vertx.md#authentication)).\n\n## Testing Authorization\n\nYou can test record filtering, data masking, and other types of authorization based data access control with DataSQRL's automated test runner via the `test` command (see the `/test-sqrl` skill).\n\n### Generating Tokens\n\nTest tokens are generated with the container's built-in **`jwt`** helper \u2014 a\nsmall, dependency-free CLI available on `PATH` inside the agent. For testing, the\n`HS256` (shared-secret) algorithm is simplest and is what these examples use.\n\nA single secret string is the signing key, and it relates to the config two ways:\n\n- **`--secret`** passed to `jwt encode` is the **raw** secret string.\n- **`k`** of an `oct` key in `auth` is that same secret, **base64url-encoded**\n  without padding. Encode it with `printf` \u2014 not `echo`, which appends a trailing\n  newline that changes the key and makes every token fail to validate \u2014 and strip\n  the line breaks `base64` inserts into long output:\n\n```sh\nprintf '%s' 'mySuperSecretSignerStringThatIsLongEnough' | base64 | tr '+/' '-_' | tr -d '=\\n'\n# -> bXlTdXBlclNlY3JldFNpZ25lclN0cmluZ1RoYXRJc0xvbmdFbm91Z2g\n```\n\nSet it as the `k` of an `oct` key, which verifies `HS256` tokens:\n\n```json\n\"auth\": {\n  \"issuers\": [\n    {\n      \"issuer\": \"<jwt-issuer>\",\n      \"audiences\": [\"<jwt-audience>\"],\n      \"keys\": [{ \"kty\": \"oct\", \"k\": \"bXlTdXBlclNlY3JldFNpZ25lclN0cmluZ1RoYXRJc0xvbmdFbm91Z2g\" }]\n    }\n  ]\n}\n```\n\nA project still on the deprecated `jwtAuth` uses the same secret as `buffer`, which is standard **Base64** with\npadding, in `pubSecKeys`:\n\n```sh\nprintf '%s' 'mySuperSecretSignerStringThatIsLongEnough' | base64 | tr -d '\\n'\n# -> bXlTdXBlclNlY3JldFNpZ25lclN0cmluZ1RoYXRJc0xvbmdFbm91Z2g=\n```\n\nThen mint a token by passing the **raw** secret and the claims (shaped to your\ntest's needs; `iss` / `aud` must match an `auth.issuers` entry, or the deprecated `jwtOptions`):\n\n```sh\njwt encode --secret 'mySuperSecretSignerStringThatIsLongEnough' --alg HS256 \\\n  '{\"iss\": \"<jwt-issuer>\", \"aud\": [\"<jwt-audience>\"], \"exp\": 9999999999, \"customerId\": 6, \"roles\": [\"user\"]}'\n```\n\nInspect or verify an existing token with `jwt decode` (pass `--secret` to also\ncheck the signature):\n\n```sh\njwt decode --secret 'mySuperSecretSignerStringThatIsLongEnough' <token>\n```\n\n### Default Test Runner Token\n\nWe can set one token directly to the `test-runner` configuration that the deployed test server will pick up by default.\nAny valid HTTP headers can be defined in `headers` if necessary, but in this context the important one is `Authorization`.\nThese headers will be added to any request that will be executed during the test.\n\n```json\n{\n  \"test-runner\": {\n    \"headers\": {\n      \"Authorization\": \"Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJteS10ZXN0LWlzc3VlciIsImF1ZCI6WyJteS10ZXN0LWF1ZGllbmNlIl0sImV4cCI6OTk5OTk5OTk5OSwidmFsIjoxfQ.cvgte5Lfhrsr2OPoRM9ecJbxehBQzwHaghANY6MvhqE\"\n    }\n  }\n}\n```\n\n### Test Specific Token\n\nTo be able to test different scenarios, it is mandatory to be able to provide different tokens that simulate them.\nTo achieve this, we can define any new test case under the project's `test-folder`, the test execution will pick them up and also compare it with their respective snapshots.\nA custom JWT test case will require two files, which share the same name that will function as the name of the test case:\n* A `.graphql` file that should define a query, mutation, or subscription.\n* A `.properties` file if the test case requires a different token than the one defined in `test-runner\n\nA sample test case structure with three different test cases looks like the below file tree.\n\n```\n\u251c\u2500\u2500 tests/\n\u2502   \u251c\u2500\u2500 mutationWithSameToken.graphql\n\u2502   \u251c\u2500\u2500 subscriptionWithSameToken.graphql\n\u2502   \u251c\u2500\u2500 differentUserQuery.graphql\n\u2502   \u251c\u2500\u2500 differentUserQuery.properties\n\u2502   ...\n```\n\nThe content of the `.properties` override the applied `headers` tor the matching `.graphql` requests, making it possible to define different scenarios.\nA simple JWT override header properties file would look like this:\n\n```properties\nAuthorization: Bearer <test-specific-jwt>\n```\n"}], "isError": false, "durationMs": 4, "timestamp": 1795509906846}, {"role": "toolResult", "toolCallId": "call_01a20cbaecf47981a1011318", "toolName": "read", "content": [{"type": "text", "text": "---\nname: configure-sqrl\ndescription: Use when configuring a DataSQRL project's `*-package.json` files. Use for engine selection (Flink, Postgres, Kafka, Iceberg and its query engines DuckDB, Snowflake, Spark SQL, Redshift, Trino), API protocols, compiler options, runtime settings, or deployment/infrastructure settings.\n---\nUpdate the configuration of a DataSQRL project by editing its `*-package.json` files or creating new ones. Read **Configuration Files** first (how the files are split and layered), then look up the key you need under **Configuration Content**.\n\nThe configuration supports environment placeholders in the configuration fields that process them. Read **Environment Variables** before adding credentials or tokens: the normal and secret forms have different compile-time behavior, and support is not universal across every configuration field.\n\n# Configuration Files\n\n## Base Config and Environment Overlays\n\nFor projects that need multiple deployment profiles, split configuration into a **base** (shared) and thin **per-environment overlays** to reduce duplication. This is a recommended project convention: SQRL accepts any ordered list of package JSON files and has no special meaning for the filenames or environment names.\n\n- **`<project>-shared-package.json`** is the base config file that includes common settings to every environment which could be `version`, `enabled-engines`, `script.main`, `script.api`, and the `engines`/`compiler` settings.\n- **`<project>-<env>-package.json`** (one per environment `-test`, `-prod`, `-local`, `-dev`) \u2014 add or overwrite ONLY what differs from the base configuration file (e.g. `script.config.environment`, `test-runner`, an engine override). Note that `-dev` is a local development environment, like `-local`.\n\nExample for the base config and environment overlays:\nThe `lending360` project with a test and a production environment:\n\n**`lending360-shared-package.json`** \u2014 the base: everything both environments share.\n\n```json\n{\n  \"version\": \"1\",\n  \"enabled-engines\": [\"flink\", \"postgres\", \"kafka\", \"vertx\"],\n  \"script\": {\n    \"main\": \"lending360.sqrl\",\n    \"api\": {\n      \"v1\": {\n        \"schema\": \"lending360-api/schema.v1.graphqls\",\n        \"operations\": [\"lending360-api/operations.v1.graphql\"]\n      }\n    }\n  },\n  \"engines\": {\n    \"flink\": {\n      \"config\": {\n        \"execution.runtime-mode\": \"STREAMING\",\n        \"table.exec.source.idle-timeout\": \"30 s\"\n      }\n    }\n  },\n  \"compiler\": {\n    \"api\": { \"protocols\": [\"GRAPHQL\", \"REST\", \"MCP\"], \"endpoints\": \"FULL\" }\n  }\n}\n```\n\n**`lending360-test-package.json`** the test overlay: ONLY what test changes.\n\n```json\n{\n  \"script\": {\n    \"config\": { \"environment\": \"test\" }\n  },\n  \"engines\": {\n    \"flink\": {\n      \"config\": { \"table.exec.source.idle-timeout\": \"0 s\" } // Disabling source idleness is advised for tests, see the `/test-sqrl` skill\n    }\n  },\n  \"test-runner\": {\n    \"delay-sec\": -1,\n    \"required-checkpoints\": 1,\n    \"snapshot-folder\": \"snapshots/lending360/\",\n    \"test-folder\": \"lending360-api/tests\"\n  }\n}\n```\n\n**`lending360-prod-package.json`** the production overlay.\n\n```json\n{\n  \"script\": {\n    \"config\": { \"environment\": \"prod\" }\n  },\n  \"engines\": {\n    \"flink\": {\n      \"deployment\": {\n        \"jobmanager-size\": \"small\",\n        \"taskmanager-size\": \"large.mem\",\n        \"taskmanager-count\": 3\n      }\n    }\n  }\n}\n```\n\nRules for writing the configuration files:\n\n* **Merging is per field, last file wins.** In the example above, the test overlay's `table.exec.source.idle-timeout: \"0 s\"` replaces the base's `\"30 s\"`, while `execution.runtime-mode: \"STREAMING\"` from the base is kept. An overlay does not replace the whole `engines.flink.config` object.\n* **`test-runner` belongs only in the `-test` overlay**.\n* **Every independently compiled or tested project and sub-project MUST have a named package file for each environment it uses:** `<project-or-sub-project>-<env>-package.json` (for example, `fraud_store-test-package.json`). Do not use an unqualified standalone package file for a deployable sub-project. The name lets the agent's package-discovery fallback identify the package that belongs to each build.\n* If settings are common across environments or sibling sub-projects, share them through a `*-shared-package.json` base; keep only environment- or sub-project-specific settings in the named package files.\n* **Fix duplicated configuration:** move common settings to `<project>-shared-package.json` and retain only differing fields in `<project>-<env>-package.json`.\n* **Give every compiled combination an auth provider when the script reads a claim.** The compiler checks the merged files of each compile. A script with `METADATA FROM 'auth.<claim>'` fails to compile when the merged `engines.vertx.config` has no `auth` block. So put `auth` in the shared base, or in each overlay that compiles the script. Use `${...}` placeholders for values that differ per environment. This also applies when a deployment mounts its own `vertx-config.json`.\n\n## Sub-projects (multiple deployments in one project)\n\nOne project folder may hold several **sub-projects**, meaning separate deployments over the same source files, each with its own configuration.\n\nEvery sub-project has **its own per-environment overlays** and layers them under a base. The base is either **its own** or **shared with sibling sub-projects**. Never combine sub-project specific configurations from different sub-projects.\n\n| File | Role |\n|------|------|\n| `<sub-project>-shared-package.json` | own base \u2014 `enabled-engines`, `script.main`, `script.api`, settings common to all of this sub-project's environments. Use one base per sub-project when the settings the sub-projects share differ (e.g. different engine sets). |\n| `<project>-shared-package.json` | shared base \u2014 only what is common to **every** sub-project layering under it (`version`, common `engines`/`compiler` settings, `enabled-engines` if identical). Whatever differs \u2014 at least `script.main` \u2014 is declared in the sub-project's own files, so the base stays valid for each of them. |\n| `<sub-project>-test-package.json` | test overlay \u2014 `test-runner` with its **own** `snapshot-folder`, plus test-only overwrites |\n| `<sub-project>-prod-package.json` | production overlay \u2014 production `script.config`, API protocols, deployment sizing and prod-only overwrites |\n\nAn available examples directory may include a useful multi-deployment reference. For example, `healthcare-study/` in `datasqrl-examples` illustrates separate stream, API, and analytics deployments alongside a shared data catalog; use it only when it is present and relevant.\n\n```\nfraud_store-shared-package.json      fraud_training-shared-package.json\nfraud_store-test-package.json        fraud_training-test-package.json\nfraud_store-prod-package.json\n```\n\nExample with **one shared base** for two sub-projects that differ only in their main script and snapshot folder:\n\n```\nfraud-shared-package.json            # version, enabled-engines, common engines/compiler settings \u2014 no script.main\nfraud_store-test-package.json        # \"script\": { \"main\": \"fraud_store.sqrl\" }, test-runner with snapshots/fraud_store/\nfraud_store-prod-package.json        # \"script\": { \"main\": \"fraud_store.sqrl\" }, prod settings\nfraud_training-test-package.json     # \"script\": { \"main\": \"fraud_training.sqrl\" }, test-runner with snapshots/fraud_training/\nfraud_training-prod-package.json     # \"script\": { \"main\": \"fraud_training.sqrl\" }, prod settings\n```\n\n```bash\n/opt/agent/cmd.sh test -r . fraud-shared-package.json fraud_store-test-package.json -b fraud_store\n/opt/agent/cmd.sh test -r . fraud-shared-package.json fraud_training-test-package.json -b fraud_training\n```\n\nEach sub-project's `-test-package.json` is its own test run. To setup a test and run, invoke the `/test-sqrl` skill.\n\n## How to Compile/Test\n\n**Compile**\n\nCompile by layering base then overlay (merged last-wins):\n\n```bash\n/opt/agent/cmd.sh compile -r . lending360-shared-package.json lending360-test-package.json -b lending360\n```\n\nThe `-b <sub-project>` flag gives each sub-project its own build folder *inside* `build/`, so a compile keeps sub-project's build artifacts intact.\n\n**Test**\nInvoke the `/test-sqrl` skill for which test packages to run and how.\n\n# Configuration Content\n\n## Engines (`enabled-engines`, `engines`)\n\n**Enable the minimal set of engines the project actually uses \u2014 nothing more.** Enabled engines determine what pipeline and deployment artifacts SQRL produces; some engines also provision or run services. Start from `flink` and add an engine only when a concrete capability below requires it.\nAt the end of the implementation, **always** check your engine set whether if is minimal or not, and prune engines that are no longer used.\n\n```json\n{\n  \"enabled-engines\": [\"flink\", \"postgres\", \"vertx\"]\n}\n```\n\nEnable each engine **only if** its trigger is present:\n\n| Engine                                 | Enable ONLY IF                                                                                             | Omit when                                                                   |\n|----------------------------------------|------------------------------------------------------------------------------------------------------------|-----------------------------------------------------------------------------|\n| **flink**                              | always \u2014 streaming/batch data processor                                                                    | never omit                                                                  |\n| **postgres**                           | the API serves data from database-backed tables (query/point-lookup endpoints, full-text or vector search) | there is no served DB query \u2014 e.g. the only output is a data-lake or EXPORT |\n| **kafka**                              | there is a `SUBSCRIBE` subscription or a CREATE TABLE annotated with `/*+engine(kafka)*/` hint             | the API is plain request/response with no subscriptions or mutations        |\n| **iceberg**                            | a table is written to a data lake \u2014 must be paired with at least one Iceberg query engine (the two rows below) | there is no data-lake output                                                |\n| **duckdb**                             | iceberg is enabled and the project serves an API, runs tests or runs locally over the Iceberg tables \u2014 the only *full* query engine, the one the server queries | iceberg is not used \u2014 never enable duckdb on its own                        |\n| **snowflake, sparksql, redshift, trino**      | iceberg is enabled and the project needs to query Iceberg tables through that external engine( shallow query engines): the compiler only generates that engine's table definitions and views | iceberg is not used, or the project does not use that external engine |\n| **vertx**                              | the project exposes a GraphQL/REST/MCP API                                                                 | it is a pure ETL/export pipeline with no served API                         |\n\nCommon minimal recipes (pick the smallest that fits, then adjust):\n* **API over a database, no streaming pub/sub** \u2192 `[\"flink\", \"postgres\", \"vertx\"]`\n* **API with subscriptions or mutations** \u2192 `[\"flink\", \"postgres\", \"kafka\", \"vertx\"]`\n* **Data lake queried from Snowflake, no API** \u2192 base `[\"flink\", \"iceberg\", \"duckdb\"]` for tests and local runs, prod overlay `[\"flink\", \"iceberg\", \"snowflake\"]`\n* **API over a data lake** \u2192 `[\"flink\", \"iceberg\", \"duckdb\", \"vertx\"]`\n* **API over a data lake that Redshift also queries** \u2192 `[\"flink\", \"iceberg\", \"duckdb\", \"redshift\", \"vertx\"]`\n* **Catalog / schema test** \u2192 `[\"flink\", \"postgres\", \"vertx\"]`\n\nOnly enable iceberg plus query engines and postgres if both high-volume & high latency and low latency querying is needed in the same project.\n\nIceberg query engines come in two kinds. `duckdb` is the full engine: it is connected to the server and runs the API queries and the tests. `snowflake`, `sparksql`, `redshift` and `trino` are shallow engines: the compiler generates table definitions and query SQL to run separately in those external engines, and they are not integrated with the DataSQRL server. Read [iceberg-query.md](iceberg-query.md) before choosing between them.\n\n### Configuring the selected engines\n\nEnabled engines are configured under the `engines` field. Engine settings that hold for every environment go in the base `<project>-shared-package.json`; only the ones that differ go in an environment overlay, checkout [Base Config and Environment Overlays](#base-config-and-environment-overlays).\n\n**Before writing the configuration for an engine, ALWAYS read its reference file below.** Option names, nesting and value formats are engine-specific and are not guessable. Read the file for **every** engine in your set first, then write the `engines` block. \n\n| Engine in your set | Read this before configuring it |\n|--------------------|---------------------------------|\n| `flink` | [flink.md](flink.md) |\n| `vertx` | [vertx.md](vertx.md) |\n| `kafka` | [kafka.md](kafka.md) |\n| `postgres` | [postgres.md](postgres.md) |\n| `iceberg` | [iceberg.md](iceberg.md) |\n| `duckdb`, `snowflake`, `sparksql`, `redshift`, `trino` | [iceberg-query.md](iceberg-query.md) |\n\nImportant rules:\n* An enabled engine with **no** entry under `engines` runs on its defaults. Add a setting only when a requirement, a connector, or the engine's reference file calls for it.\n* Keep `engines` entries aligned with `enabled-engines`. SQRL removes a configuration for a disabled engine and warns when that configuration came from a user package; delete it yourself when pruning the engine.\n* Compulsory Slow-query logging (required with `vertx`): Every project that enables `vertx` must enable slow-query logging. Read [Slow-Query Logging](vertx.md#slow-query-logging) in vertx.md, then set `engines.vertx.config.graphQLTailSampleTracingConfig` in the base config (project base `<project>-shared-package.json`, or the own base of each sub-project `<sub-project>-shared-package.json` that enables `vertx`) with thresholds you chose for this API.\n\n### Deployment (`engines.<engine>.deployment`)\n\nThe `deployment` section under each `engines` configuration specifies what resources (i.e. instance type and number of instances) to use for deploying a DataSQRL pipeline in DataSQRL Cloud.\n\nAlways read [Cloud Deployment Configuration](cloud-deployment.md) when configuring deployment size and resources, or when upgrading an existing deployment to a new DataSQRL version.\n\n## Script (`script`)\n\n```json\n{\n  \"script\": {\n    \"main\": \"my-project.sqrl\", // Main SQRL script for pipeline\n    \"api\": {\n      \"v1\": { //default API version\n        \"schema\": \"fraud_store-api/schema.v1.graphqls\", // GraphQL schema defines the API\n        \"operations\": [\"fraud_store-api/operations.v1.graphql\"], //List of GraphQL queries that define operations which are exposed as API endpoints\n        \"openapi\": \"fraud_store-api/openapi.v1.json\", //Optional OpenAPI baseline. See the /from-api skill\n        \"mcp-apps\": \"fraud_store-api/apps-v1\" //Optional directory of MCP apps (HTML UIs for MCP tools). See the /design-api skill\n      }\n    },\n    \"config\": { //Arbitrary JSON object used by the mustache templating engine to instantiate SQRL file templating variables\n      \"environment\": \"kafka\" \n    }\n  }\n}\n```\n\n### API Versioning and Compatibility\n\n`script.api` serves one or more versioned APIs. Version keys must be `v` followed by a number (`v1`, `v2`); each version requires a `schema`, `operations`, an `openapi` compatibility specification, or an `mcp-apps` directory. SQRL infers the schema from the SQRL script when one is not configured, and generates an OpenAPI specification for every version. Set `openapi` to a previously generated specification when compilation must reject backward-incompatible API changes. Set `mcp-apps` to the directory with the self-contained `.html` files of the version's MCP apps; there is no top-level `script.mcp-apps`.\n\nFor one `v1` API only, the legacy top-level fields are also supported. The top-level `operations` field is deprecated, so configure operations under `script.api` in new projects:\n\n```json\n{\n  \"script\": {\n    \"main\": \"my-project.sqrl\",\n    \"graphql\": \"api/schema.v1.graphqls\",\n    \"operations\": [\"api/operations.v1.graphql\"],\n    \"database\": \"my-mutation-database.json\"\n  }\n}\n```\n\nUse **either** top-level `graphql`/`operations` or `script.api`, never both. `script.database` is an optional mutation-database JSON emitted by a previous compile; keeping it in the config makes SQRL check mutation-schema backward compatibility.\n\n### Included Projects (`script.include`)\n\nReuse scripts from **another SQRL project** (e.g. a shared data catalog) by declaring it under `script.include`. \nEach key under `script.include` is the **namespace** the consumer imports it under; `package` is the path, **relative to the current project root**, to **any package JSON file at the included project's top level** (`package.json`, `<name>-shared-package.json`, \u2026). DataSQRL takes that file's parent directory as the include root and walks it and all its subfolders, loading every `.sqrl` script under the namespace.\n\n```json\n\"script\": {\n  \"main\": \"consumer.sqrl\",\n  \"include\": {\n    \"<namespace>\": { \"package\": \"../other-project/package.json\", \"config\": { } }\n  }\n}\n```\n\nExample:\n```json\n{\n  \"script\": {\n    \"main\": \"consumer.sqrl\",\n    \"include\": {\n      \"data_catalog\": {                                                   // namespace \u2192 IMPORT data_catalog.<script>\n        \"package\": \"../other-project/other-project-shared-package.json\",  // path; relative from this project's root to the other project's TOP-LEVEL package file (its <name>-shared-package.json, or package.json); that file's folder + all subfolders is the include root\n        \"config\": { \"environment\": \"prod\" }                               // optional mustache overrides for that project's {{...}} template vars\n      }\n    }\n  }\n}\n```\n\n* The **key** (`<namespace>`) is the import namespace. Name it with **underscores** (`data_catalog`), because a dash has a different meaning in SQL. `package` is the path **relative to the current project** to the other project's top-level package JSON file \u2014 its parent directory is the include root, and the SQRL files in that directory and its subdirectories are loaded; `config` supplies Mustache override values for that project's `script.config` template variables (`{{...}}`).\n- **Template values for the included scripts.** An included project's scripts may use `{{...}}` placeholders \u2014 variables such as `{{environment}}`, sections such as `{{#is_batch}}\u2026{{/is_batch}}`. DataSQRL renders them from two sources: the `script.config` of the package file named in `package`, and the include entry's own `config`, which overrides it. Add `config` only when you have values to pass: it must hold at least one property, so an empty `{}` is rejected (`must have at least 1 properties at location [/script/include/<namespace>/config]`).\n- **Declare `script.include` in the config that declares `script.main`** \u2014 the base config (or, with a base shared by several sub-projects, each sub-project's file that declares its `script.main`). Overlays that only add engine or test-runner settings need no `script.include`.\n- **Declare only the projects this project actually needs**, not everything the repository happens to contain: every declared project is copied into `build/` at compile time, so an unnecessary declaration are expensive.\n- **`standalone` includes.** By default the consumer owns the included project's internal tables like its own. Set `\"standalone\": true` on the include entry only when the included project has its own deployment; it can go in the deployment's package file alone, but that entry must repeat the include's `package`, because every include entry requires it. Then the included project owns its internal **Kafka** tables, and its deployment writes what the statements it plans write: the compiler follows the imports of the `script.main` in the include's `package` file, so point `package` at the file that sets the deployment's `script.main`, not at a `<name>-shared-package.json` without one (the compiler then warns, and the consumer writes everything itself). The consumer reads the topics of the subscriptions that deployment exposes (`SUBSCRIBE` tables and the tables `SUBSCRIBE` functions read, in its main script and inline imports) instead of writing them, and skips the include's `EXPORT`/`INSERT` statements into the log, its internal Kafka tables and external tables, with a notice per statement. `kafka.json` lists the topics the consumer uses by name under `includedTopics`; their settings, such as the partition count, belong in the included project's own package files. Both projects must resolve the same topic names and key/value formats, and the `kafka` topic template must not use `${sqrl:table-id}`. Internal Iceberg tables are not covered yet. See *Standalone Includes* in the configuration docs.\n- At compile time the included project is **copied into `build/<namespace>/`** from which IMPORT statements are resolved. Invoke the `/implement-sqrl` skill (SQRL Language Spec \u2192 IMPORT Statement \u2192 Included projects / multi-project).\n\n## Test Runner (`test-runner`)\n\nPut test-runner settings in a test overlay when using base/overlay packages. For streaming pipelines, prefer `required-checkpoints` with `delay-sec: -1`; otherwise use a wall-clock `delay-sec`.\n\n```json\n{\n  \"test-runner\": {\n    \"snapshot-folder\": \"snapshots/myproject/\",\n    \"test-folder\": \"api/tests/\",\n    \"use-inferred-schema\": true,\n    \"delay-sec\": -1,\n    \"mutation-delay-sec\": 0,\n    \"required-checkpoints\": 1,\n    \"create-topics\": [\"input-topic\"],\n    \"headers\": { \"Authorization\": \"Bearer <test-token>\" }\n  }\n}\n```\n\nDefaults are `./snapshots`, `./tests`, `true`, `30`, `0`, and `0` respectively for the first six fields. `create-topics` and `headers` are optional, non-empty values. Header values are sent literally: environment placeholders such as `${TEST_TOKEN}` are not resolved in `test-runner`, so put a test-only token in the test package (or in per-query `.properties` header files).\n\n## Connector Templates (`connectors`)\n\nThe `connectors` field holds the templates that decide how the engines in the pipeline exchange table data with each other: the Kafka topic for a mutation table, the Postgres table behind a materialized query, the Iceberg table for a lake sink, the log/print sink.\n**No `connectors` field result in default usage.** Add or overwrite a template only when a requirement forces it: a fixed topic naming scheme, a non-default format, extra Kafka client properties, or credentials that do not come from the standard environment variables. **Before any change, ALWAYS read [connector-templates.md](connector-templates.md) first.** It lists every default template in full and the fields that can be overwritten. An overwritten template replaces only the fields you name.\n\nNote that these connector templates apply to table definition managed by DataSQRL are different from the source/sink connectors explicitly defined in SQRL (`CREATE TABLE ... WITH ('connector' = ...)`). For those, invoke the `/manage-connector` skill.\n\n## Compiler (`compiler`)\n\n```json\n{\n  \"compiler\": {\n    \"logger\": \"print\",\n    \"compile-flink-plan\": true,\n    \"extended-scalar-types\": true,\n    \"cost-model\": \"DEFAULT\",\n    \"predicate-pushdown-rules\": \"LIMITED_RULES_NO_SOURCE\",\n    \"explain\": {\n      \"sql\": false,\n      \"logical\": false,\n      \"physical\": false,\n      \"sorted\": true\n    },\n    \"api\": {\n      \"protocols\": [\"GRAPHQL\", \"REST\", \"MCP\"],\n      \"endpoints\": \"FULL\",\n      \"add-prefix\": true,\n      \"max-result-depth\": 3,\n      \"default-limit\": 10,\n      \"paginated-results\": false\n    }\n  }\n}\n```\n\n`logger` is `print` or `none`. `extended-scalar-types` enables extended generated GraphQL scalars. `compile-flink-plan` controls Flink physical-plan generation and is not supported for batch pipelines. `cost-model` is `DEFAULT`, `READ`, or `WRITE`, and the default is `DEFAULT`. `DEFAULT` favors Flink unless joins make Flink too expensive, `WRITE` always favors Flink, and `READ` always favors the database. The compiler assigns each table to the cheapest engine. An `/*+ engine(...) */` hint limits the engines that the compiler can pick. With `DEFAULT`, Flink and the database can have the same cost for a table. Then the compiler assigns the table to Flink. To see the engine of each table, read its `Stage:` line in `build/pipeline_explain.txt`.\n\n`explain` controls plan output under `build/`: use `sql`, `logical`, or `physical` to include each representation, and `sorted` for deterministic order. Although the current schema accepts `text` and `visual`, the current compiler configuration interface does not consume them; do not rely on those keys.\n\n### Optimizer configuration\n\n`predicate-pushdown-rules` applies only to Flink streaming when `compile-flink-plan` is enabled:\n\n* `DEFAULT` uses the normal Flink optimizer rules.\n* `LIMITED_RULES_NO_SOURCE` strips downstream predicate-pushdown rules to maximize subgraph elimination.\n* `LIMITED_RULES` additionally strips table-source pushdown rules.\n* `LIMITED_TABLE_SOURCE_RULES` is also accepted by the configuration schema; use it only when a specific SQRL version/workload requires it, as it's deprecated.\n\n### API protocol configuration\n\nDataSQRL's authoritative API model is GraphQL; REST and MCP are generated from it. `protocols` may contain `GRAPHQL`, `REST`, and/or `MCP` and defaults to all three. `endpoints` is one of:\n\n* `FULL`: generated REST/MCP operations for schema queries and mutations, plus explicit operations.\n* `GRAPHQL`: flexible GraphQL but only explicit operations for other protocols.\n* `OPS_ONLY`: explicit GraphQL operations only.\n\n`add-prefix` prefixes generated operation names to avoid collisions. `max-result-depth` controls generated REST/MCP result traversal depth, `default-limit` is the generated query limit, and `paginated-results: true` wraps multi-row query results in a page with pagination metadata.\n\n### Tags (`compiler.tags`)\n\nConfigure tags only when the requirements ask the compiler to enforce data classification or similar tags, and use the tag names and values they define. When `compiler.tags` is present, the compiler validates the `@name` and `@name=value` tags in doc strings and propagates them from the tables a query reads to the table it defines. Without it, doc strings are plain text.\n\n```json\n{\n  \"compiler\": {\n    \"tags\": {\n      \"classification\": { \"values\": [\"unclassified\", \"secret\", \"top_secret\"] },\n      \"gdpr\": {},\n      \"jurisdiction\": { \"required-columns\": { \"jurisdiction\": \"STRING\" } }\n    }\n  }\n}\n```\n\nEach key is a tag name. `values` lists the allowed values from lowest to highest; a tag without `values`, like `gdpr`, is a boolean tag that is written `@gdpr`. `required-columns` maps each column that every table carrying the tag must have to its type. Tag names and values may only contain letters, digits, underscores and dashes, and are case-insensitive. A required column name matches a column ignoring case, unless it is in backticks, such as ``\"`jurisdiction`\": \"STRING\"``, which only matches the column with exactly that name. A plain name that matches several columns whose names differ only in case is a compile error. Values must be unique within a tag, also ignoring case, and so must required column names, unless both are in backticks. Put the tags in the shared base: combined package files merge them per tag. To write tags and `declassify` hints in scripts, invoke the `/implement-sqrl` skill (Tags in doc-strings). The compiler lists the tags of every table in `build/pipeline_explain.txt` and in the deployment plans of the database and Kafka.\n\n## Environment Variables (`${VAR}`)\n\n`${NAME}` is a normal environment-variable template; `${NAME:-fallback}` and `${NAME:=fallback}` both use `fallback` when `NAME` is absent. In supported compile-time fields, a present value is resolved and can be written into `build/` or `build/deploy/`; otherwise the normal template remains for runtime resolution. Do not use this form for a credential that must stay out of compile artifacts.\n\n`${{NAME}}` is a secret template and accepts only a variable name. Even if `NAME` is available at compile time, SQRL does not read it: in supported paths it rewrites `${{NAME}}` to `${NAME}` in the generated artifact for runtime resolution. This conversion applies only to user `connectors` configuration and Flink `CREATE TABLE ... WITH (...)` properties\u2014not arbitrary JSON, including `engines.vertx.config`.\n"}], "isError": false, "durationMs": 3, "timestamp": 1795509906846}, {"role": "assistant", "content": [{"type": "thinking", "thinking": "Now let me read the vertx.md auth section, the from-api skill, test-sqrl skill, monitor-pipeline skill, and maybe init-sqrl. Also inspect the data-catalog test data for observation. Let me read these.\n\nGiven the scale, let me be efficient. Read from-api, test-sqrl, monitor-pipeline, init-sqrl. And the vertx auth section.", "thinkingSignature": "reasoning_content"}, {"type": "toolCall", "id": "call_01a20cbaf2bf76a1a071dacc", "name": "read", "arguments": {"path": "/opt/agent/skills/from-api/SKILL.md"}}, {"type": "toolCall", "id": "call_01a20cbaf2f475f2a6e4322b", "name": "read", "arguments": {"path": "/opt/agent/skills/test-sqrl/SKILL.md"}}, {"type": "toolCall", "id": "call_01a20cbaf3297182aa345e43", "name": "read", "arguments": {"path": "/opt/agent/skills/monitor-pipeline/SKILL.md"}}], "api": "openai-completions", "provider": "together", "model": "deepseek-ai/DeepSeek-V4.1-Flash", "usage": {"input": 8300, "output": 218, "cacheRead": 56576, "cacheWrite": 0, "reasoning": 84, "totalTokens": 65094, "cost": {"input": 0.00249, "output": 0.00026159999999999996, "cacheRead": 0.000339456, "cacheWrite": 0, "total": 0.003091056}}, "stopReason": "toolUse", "timestamp": 1795509906849, "responseId": "18c36f45c34f4569b705c14f1d0f6cb9-aws_ec1", "rawStopReason": "tool_calls", "durationMs": 1956, "thinkingLevel": "high"}, {"role": "toolResult", "toolCallId": "call_01a20cbaf2bf76a1a071dacc", "toolName": "read", "content": [{"type": "text", "text": "---\nname: from-api\ndescription: Use when requirements define an API schema or specification that the resulting DataSQRL pipeline should expose. Use when requirements (partially) define GraphQL schema, REST endpoints (e.g. Swagger or OpenAPI), or MCP tools with interface or result schema (JSON).\n---\n\nWhen the requirements specify an API contract (partial or complete) it is critical that the implemented DataSQRL project exposes that API exactly or as closely as possible.\n\nThis inverts the default workflow. `/design-api` builds the API *forward* from SQRL: define tables, let the compiler infer the schema. Here you work *backwards* \u2014 the contract is fixed and the SQRL must be shaped to produce it. Follow this derivation chain and do not skip ahead:\n\n```\nAPI spec \u2192 GraphQL schema \u2192 result types \u2192 tables & columns \u2192 source data\n   (1)          (1)              (2)           (2)              (2)\n```\n\nEach arrow constrains the next step and they must always be followed in this exact sequence.\n\n## 1. Create GraphQL Schema (and operations)\n\nDefine the complete GraphQL schema in the file `{project-name}-api/schema.v1.graphqls` and register it under `script.api` in the project's package.json files (in the shared package.json if there are multiple per environment).\n\nReview `/opt/datasqrl-examples/customer360/customer360-api/schema.v1.graphqls` as reference for supported GraphQL scalars, required directives, and suggested structure. A custom schema must declare custom scalars and directives it uses.\n\n### Mapping spec types to schema types\n\nPick the SQRL column type that produces the scalar the spec requires:\n\n| Spec type (JSON/OpenAPI)      | SQRL column type          | GraphQL scalar                          |\n|-------------------------------|---------------------------|-----------------------------------------|\n| `string`                      | `STRING`                  | `String`                                |\n| `integer`                     | `BIGINT` / `INT`          | `Long` (`Int` is an accepted narrowing) |\n| `number`                      | `DECIMAL(p,s)` / `DOUBLE` | `Float`                                 |\n| `boolean`                     | `BOOLEAN`                 | `Boolean`                               |\n| `string`, `format: date-time` | `TIMESTAMP_LTZ(3)`        | `DateTime`                              |\n| free-form object              | `RAW_JSON`                | `JSON`                                  |\n| nested object                 | `ROW<...>`                | child object type                       |\n| array of objects              | `ARRAY<ROW<...>>`         | list of a child object type             |\n\nThe compiler accepts *compatible* substitutions (widening/narrowing scalars, changing cardinalities), so this table is a starting point, not a strict contract \u2014 confirm the result by compiling.\n\nName each object type that has relationship fields after the SQRL table that owns those relationships. Step 2, \"Name types for relationships\", gives the rule.\n\n### From GraphQL\n\nIf the requirements specify the API in GraphQL schema or as example GraphQL queries, design the GraphQL schema directly from those requirements.\n\nNote that SQRL has some limitations you may need to work around:\n- Mutations must have a single InputType argument and the ResultType is identical plus (optional) fields for uuid, timestamp or JWT claim values.\n- SQRL supports all GraphQL scalars but only Long, DateTime, JSON extended scalars.\n- Unions are not supported.\n\nNote that standard GraphQL directive like `@oneOf` are supported and enforced by the server.\n\n### From REST (e.g. Swagger or OpenAPI)\n\nIf the requirements specify a REST endpoint (e.g. via Swagger, OpenAPI, or JSON), map those requirements back to GraphQL schema.\n\nDataSQRL uses GraphQL schema as the authoritative API interface and generates REST endpoints either implicitly from the queries and mutations in the schema, or from explicit operations in `{project-name}-api/operations.v1.graphql`. Invoke the `/design-api` skill for that forward mapping \u2014 your job is to invert it.\n\nPrefer the implicit definition of REST endpoints by following queries and mutations. Use explicit operation definitions if the specified endpoints cannot be mapped implicitly, or when the spec fixes the URI, HTTP method, endpoint name, or result body shape.\n\nWhen inverting, note specifically that complex/nested response bodies map to GraphQL relationship fields with referenced types and - similarly - complex/nested request payloads map to GraphQL input type relationships to inner input types.\n\nFollow best practices in defining the GraphQL schema as much as possible while meeting the requirements. Matching the user provided spec as closely as possible takes priority.\n\nIdentify the simplest, normalized GraphQL schema to support all required REST endpoints. For example, if the requirements specify \"a REST endpoint called `UsersByHandles` that takes a username and phone number as URL parameters and returns two fields `byName` and `byPhone` which are arrays of all user records that match by the respective argument\", canonicalize the GraphQL schema to:\n```graphql\ntype User {\n  id: String!\n  username: String!\n  phoneNumber: String\n  email: String\n}\n\ntype Query {\n  \"\"\"\n  Look up users by personal information. Supplied filters are ANDed; omitted\n  arguments are ignored rather than matched against `null`.\n  \"\"\"\n  usersByPersonalInformation(\n    username: String\n    phoneNumber: String\n    limit: Int = 20\n    offset: Int = 0\n  ): [User!]\n}\n```\n\nAnd define an explicit operation:\n```graphql\nquery UsersByHandles($username: String!, $phoneNumber: String!, $limit: Int)\n  @api(rest: GET, uri: \"/queries/usersByHandles{?username,phoneNumber,limit}\") {\n  byName: usersByPersonalInformation(username: $username, limit: $limit) {\n    id\n    username\n    phoneNumber\n    email\n  }\n  byPhone: usersByPersonalInformation(phoneNumber: $phoneNumber, limit: $limit) {\n    id\n    username\n    phoneNumber\n    email\n  }\n}\n```\n\n**Every argument of a `GET` operation must appear in the `uri` template.** Any argument missing from the template is treated as request payload, which forces the method to `POST`. Use RFC 6570 form-style query expansion (`{?a,b,c}`) for arguments the spec passes as URL query parameters, and simple expansion (`/{a}`) for those it passes as path segments \u2014 `$limit` above has to be in the template too, or the endpoint could not be `GET`.\n\n`POST` operations support path parameters together with a JSON body of GraphQL variables. A variable supplied in both the path and body must agree or the server returns HTTP 400. POST query-string parameters are ignored; do not use them to satisfy required arguments. The REST bridge supports GET and POST, so document requirements for other HTTP methods as discrepancies.\n\nDeclare `limit`/`offset` arguments only where the spec exposes paging; a query field may also return a single object rather than a list when the spec demands it.\n\nIf a clean mapping from REST to GraphQL schema is not possible, approximate the required API specification as closely as possible and clearly document the discrepancies in the README.\n\n### OpenAPI contract validation and artifacts\n\nPackage.json files support an `openapi` reference for each `script.api` version. When requirements provide an OpenAPI document, retain it as the compatibility baseline and register it alongside the GraphQL schema and any operations:\n\n```json\n\"script\": {\n  \"api\": {\n    \"v1\": {\n      \"schema\": \"{project-name}-api/schema.v1.graphqls\",\n      \"operations\": [\"{project-name}-api/operations.v1.graphql\"],\n      \"openapi\": \"{project-name}-api/openapi.v1.json\"\n    }\n  }\n}\n```\n\nOmit `operations` when using only implicit endpoints. Keep the baseline as a JSON file in the project and reference its project-relative path. Convert a supplied YAML document to JSON without changing its contract.\n\nThe compiler compares the supplied baseline with its generated OpenAPI document. An incompatible change or a failure to read/compare the baseline fails compilation. This checks **backwards compatibility**, not exact equality: compatible additions can pass. The baseline is a validation contract; continue deriving the GraphQL schema and operations from it, and do not weaken it just to make compilation pass.\n\nInspect the generated specification at `deploy/plan/vertx-<version>-openapi.json` under the build folder (`build/` for a plain compile, `build/<sub-project>/` when compiling with `-b`). With REST and OpenAPI serving enabled, it is also available at `/v1/openapi`, with Swagger UI at `/v1/swagger-ui` by default.\n\nAccount for the REST `{\"data\": ...}` envelope when matching the required response. Generated response schemas can be incomplete for operations with multiple root fields (such as `UsersByHandles` above), fragments, or custom result formats, and do not capture response requiredness/nullability. Verify actual REST bodies separately; a passing compatibility check cannot establish an exact response contract.\n\n### From MCP\n\nIf the requirements specify an MCP tool with (optional) arguments and JSON result body you must first map those requirements back to GraphQL schema.\n\nFollow the same steps as for REST APIs above, using explicitly defined operations only when needing to customize the tool name or payload body structure.\n\nAuto-generated tools are named with a `Get` (queries) or `Add` (mutations) prefix. If the spec fixes exact tool names, either define explicit operations (operation name = tool name) or set `\"add-prefix\": false` under `compiler.api` to drop the prefixes.\n\n### Partial specifications\n\nWhen the spec covers only part of the API, treat the specified part as frozen, invoke the `/design-api` skill, and design the rest with its conventions. Do not silently widen a specified endpoint (extra arguments, extra result fields) \u2014 a specified endpoint must match exactly. Decide deliberately whether unspecified endpoints should be exposed at all (see step 3) and record that decision in the README.\n\n## 2. Map GraphQL schema to Tables & Relationships\n\nDefine the tables and relationships in SQRL so that they map to the GraphQL schema by name.\n\nFollow these rules:\n- For queries with no arguments (other than limit & offset which are handled automatically) or simple AND/OR filters, define a table with the same name and add a `query_by_all` or `query_by_any` hint with those arguments as column names.\n- For queries with more complex retrieval logic or claims-based authorization, define a table function with required arguments (other than limit & offset) and implement the retrieval logic in SQL. Use `METADATA FROM 'auth.claim-name'` to annotate arguments that are injected from authorized JWT claims. A script that reads a claim compiles only with an auth provider in `engines.vertx.config`. Invoke the `/configure-sqrl` skill and add the `auth` block.\n- Define SQRL relationships for GraphQL relationship fields with arguments defined like above.\n- For mutations, define a `CREATE TABLE` statement with an `/*+engine(kafka)*/` hint and **no connector `WITH` clause**, where the columns match the mutation InputType definition. If the InputType has relationships to other InputTypes, define nested columns types via `ROW<column definitions...>` or `ARRAY<ROW<columns...>>` depending on multiplicity.\n- For each ResultType field that is not in the InputType, add a metadata column: `METADATA FROM 'uuid'` for a generated id, `'timestamp'` for the time of the call, and `'auth.<claim>'` for a JWT claim. Take the caller identity, such as the owner of the record, from a claim column, so that a caller cannot write a record for somebody else. A mutation table accepts only these three metadata keys. Any other key stops the compile with an `Unknown metadata key` error. Use the `/implement-sqrl` skill (Accessing JWT payload) for the claim rules.\n  In this spec, `ticket_id` and `customer_id` are in `Ticket` but not in `TicketInput`, and the caller is the JWT claim `sub`:\n\n  ```graphql\n  type Mutation { OpenTicket(event: TicketInput!): Ticket! }\n  input TicketInput { subject: String!  body: String! }\n  type Ticket { ticket_id: String!  customer_id: String!  subject: String!  body: String! }\n  ```\n\n  ```sql\n  /*+no_query, engine(kafka) */\n  CREATE TABLE OpenTicket (\n    ticket_id   STRING NOT NULL METADATA FROM 'uuid',\n    customer_id STRING NOT NULL METADATA FROM 'auth.sub',\n    subject     STRING NOT NULL,\n    body        STRING NOT NULL\n  );\n  ```\n- For subscriptions, define the table with the `SUBSCRIBE` keyword. This also requires kafka (see below).\n\n### Name types for relationships\n\nThe compiler matches each schema field by name, and the name it looks up depends on the kind of field:\n\n| Schema field | SQRL item the compiler looks up | Role of the GraphQL type name |\n|---|---|---|\n| Field of `type Query` (or `Subscription`) | Table or table function with the field name | None |\n| Field that is a column | Column with the field name in the rows of the parent table or function | None, so any type name works |\n| Field that is a relationship | Relationship with the full name `<GraphQL type name>.<field name>` | It is the first half of that full name |\n\nGive every object type that has relationship fields the name of the SQRL table that owns those relationships.\nA table function cannot own a relationship, so define the relationships on its base table and use that table name as the function's result type.\nThis also applies to every nested type that has relationship fields: name it after the table that owns its relationships.\n\n```sql\n/*+no_query */\nOrderRecord := DISTINCT Orders ON id ORDER BY ts DESC;\nOrderRecord.items := SELECT sku, qty FROM Items i WHERE i.order_id = this.id;\n\nOrderById(id BIGINT NOT NULL, caller STRING NOT NULL METADATA FROM 'auth.sub') :=\n  SELECT o.* FROM OrderRecord o WHERE o.id = :id AND o.customer = :caller;\n```\n\n```graphql\ntype Query {\n  OrderById(id: Long!): OrderRecord\n}\n\ntype OrderRecord {\n  id: Long!\n  items: [Item!]\n}\n```\n\nThe query field `OrderById` matches the function by name. The field `items` matches the relationship `OrderRecord.items` because the type is named `OrderRecord`.\nWith `type Order`, the compiler looks for `Order.items`, finds no such relationship, and fails with `Unknown field at location items. Possible scalars are [...]`.\nThe compatible substitutions in step 1 cover field types and cardinalities. A relationship lookup always uses the exact type name.\n\nA nested type can have its own relationship fields only when its parent field is a relationship.\nIf the parent field is a column with nested data (`ROW<...>` or `ARRAY<ROW<...>>`), the compiler looks only at the values inside that column. It does not look for relationships there.\nExample: `OrderRecord.items` is a relationship to the table `Item`, and the table `Item` has the relationship `Item.supplier`. Then the field `supplier` in `type Item` works.\nIf `items` is an `ARRAY<ROW<sku STRING, qty INT>>` column instead, the field `supplier` fails with `Unknown field at location supplier`.\n\nWhen the compiler reports `Unknown field at location <field>` for a field that you defined as a relationship, compare the GraphQL type name with the table name in the relationship definition `<Table>.<field> :=`.\nRename the GraphQL type to that table name, and keep the SQRL script as it is.\n\n### Mutation shape\n\nThe generated mutation shape follows a fixed convention. For `/*+no_query, engine(kafka)*/ CREATE TABLE Clickstream (event_id STRING NOT NULL METADATA FROM 'uuid', url STRING NOT NULL, userid STRING NOT NULL, event_time TIMESTAMP_LTZ(3) NOT NULL METADATA FROM 'timestamp');`:\n\n```graphql\ntype Mutation {\n  Clickstream(event: ClickstreamInput!): ClickstreamResultOutput!\n}\ninput ClickstreamInput { url: String!  userid: String! }\ntype ClickstreamResultOutput { event_id: String! url: String!  userid: String!  event_time: DateTime! }\n```\n\nInput type is `{Table}Input` (metadata and computed columns excluded), result type is `{Table}ResultOutput` (input fields plus the metadata columns), and the argument is named `event`. The argument name and the type names are customizable in the schema; the structure is not.\n\nThree things are required for a mutation to appear at all, and omitting any of them yields a successful compile with the mutation silently missing:\n1. the `/*+engine(kafka)*/` hint (add `no_query` hint if the table should not also be a query, and always when the table holds the records of all callers),\n2. `kafka` in `enabled-engines` in package.json files,\n3. the table must be visible in the main script \u2014 wildcard-import it (`IMPORT connectors.clickstream.*;`); an aliased import keeps it private.\n\nThe same `kafka` requirement applies to any `SUBSCRIBE` statement.\n\n### Reconciling with available source data\n\nOnce the tables are derived, check each required column against the data the project actually has. Where a specified field has no source:\n- if it can be computable from existing sources, derive it (e.g. aggregate, join, computed column) in existing or separate table joined back in;\n- otherwise invoke the `/manage-connector` skill and add the source it needs, if requirements ask to add a source;\n- otherwise fill column with placeholder content and document the missing data.\n\n## 3. Configure the Exposed Surface\n\nThe schema decides what *can* be served; `compiler.api` decides what is actually exposed. Set these deliberately \u2014 the defaults rarely match a fixed spec:\n\n```json\n\"compiler\": {\n  \"api\": {\n    \"protocols\": [\"REST\", \"MCP\", \"GRAPHQL\"],\n    \"endpoints\": \"OPS_ONLY\",\n    \"add-prefix\": false,\n    \"max-result-depth\": 3\n  }\n}\n```\n\n- **`protocols`** must include every protocol the spec requires (defaults to all).\n- **`endpoints`**: `FULL` (default) auto-generates an endpoint for *every* query and mutation in the schema *in addition to* the explicit operations \u2014 so a spec-exact surface almost always needs `OPS_ONLY`. Use `FULL` only when the spec's endpoints are exactly the schema's queries and mutations.\n- **`add-prefix`**: `false` to suppress the `Get`/`Add` MCP tool-name prefixes when the spec fixes tool names.\n- **`max-result-depth`**: relationship traversal depth when building REST/MCP result bodies implicitly from schema (does not apply to explicitly specified ops). \n\nInvoke the `/configure-sqrl` skill for the full configuration reference.\n\n## 4. Verify Against the Spec\n\n1. Add one test operation per spec'd endpoint under `{project-name}-api/tests/` and run the tests (invoke the `/test-sqrl` skill,read `Projects with a Custom GraphQL Schema` section). Set `\"use-inferred-schema\": false` in the test package, so that these tests exercise the actual contract. With the default `true`, the tests run against the inferred schema instead. Snapshot the response bodies and check their *shape* against the spec, not just their values.\n2. For OpenAPI requirements, compile with the per-version `openapi` baseline registered and compare the generated specification against the required paths (including the configured REST prefix), methods, parameter locations, request bodies, response envelopes, and schemas. Check for extra endpoints explicitly because backwards-compatible additions may pass compilation. Exercise REST requests to verify HTTP behavior and response shape, especially POST path/body handling and operations affected by the response-schema limitations above.\n3. Check that the SQRL script adds no endpoint to the spec. A public table that you define for the mapping in step 2, such as the base table of a table function, gives a query of its own unless it has the `no_query` hint. Run the `compile` command and look for the warning `No GraphQL schema uses these endpoints, but they are still computed and written to the database or log: <names>`. It names each query, relationship and subscription that the SQRL script defines and the GraphQL schema does not have. Fix each name as the `/design-api` skill says (Schema Customization). The `test` command prints this warning only with `\"use-inferred-schema\": false`.\n4. Document every remaining discrepancy in the README: what the spec asked for, what is exposed instead, and why.\n\n## Critical Points\n\n* Always invoke the `/design-api` skill to retrieve the mappings from SQRL->GraphQL->REST/MCP and adhere to those mappings \u2014 this skill only tells you how to invert them.\n* If the compiler fails because it cannot map the tables & relationships in SQRL to the GraphQL schema, try to adjust the table/relationship definitions first. Only if that doesn't work, modify the GraphQL schema.\n* A provided GraphQL schema is static: a column added to a table later does **not** appear in the API until it is added to the schema file too.\n* If you remove the API schema and operations from `script.api` the compiler generates the GraphQL schema in `build/inferred_schema.graphqls`. Use this to partially generate schema from the SQRL files and to discover discrepancies when the compiler fails to match the provided schema.\n* Exactly match the specified API unless DataSQRL limitations require modifications or workarounds. Clearly document discrepancies from the requirements in the README.\n"}], "isError": false, "durationMs": 3, "timestamp": 1795509908810}, {"role": "toolResult", "toolCallId": "call_01a20cbaf2f475f2a6e4322b", "toolName": "read", "content": [{"type": "text", "text": "---\nname: test-sqrl\ndescription: Use when adding or updating tests for a DataSQRL pipeline. Use after implementing features to verify correctness.\n---\n\nAlways implement test coverage for all major features or complex data transformations implemented in SQRL.\nWithout a custom GraphQL schema, prefer table tests. Use API tests for complex interaction patterns (mutation followed by query/subscription) or authorization.\nWith a custom GraphQL schema, follow [Projects with a Custom GraphQL Schema](#projects-with-a-custom-graphql-schema).\n\n# Writing Tests\n\n## Test Types\n\nDataSQRL supports two snapshot test types (run via `test` command):\n1. **Table tests**: SQRL tables annotated with `/*+test */` hint\n2. **API tests**: GraphQL operations (queries/mutations/subscriptions) in configured test folder.\n\nBoth write snapshots to the configured snapshot folder and pass when the new output is identical to the stored snapshot \u2014 see [Snapshot Lifecycle](#snapshot-lifecycle) under Running Tests.\n\n## Table Tests\n\nAdd `/*+test */` hint to any table definition:\n\n```sql\n-- Tests that the query returns an identical snapshot of data\n/*+test */\nCustomerRetrievalTest := SELECT customerid, name, email FROM Customer\n  WHERE name = 'John' ORDER BY customerid;\n\n-- Tests an invariant and returns failing records\n/*+test(no_rows) */\nInvalidCustomersTest := SELECT * FROM Customer\n  WHERE name = '' OR email IS NULL;\n```\n\n**Requirements:**\n- Use `/*+test(no_rows) */` hint to test invariants\n- Snapshot results must have deterministic order (use `ORDER BY`)\n- Only select predictable columns and exclude non-deterministic ones (e.g. columns computed via `rand()` or `now()`)\n- Table tests do not include relationships\n- Every column in `ORDER BY` must also appear in `SELECT`. To sort by a column without including it in snapshot output, alias it with a `_` prefix: `event_time AS _event_time`. Omitting an ORDER BY column from SELECT causes: `All sort columns must be part of the SELECT clause for table definitions, missing: [col]`.\n\n## API Tests\n\nPlace `.graphql` files in the configured test folder, **one operation definition per file**. The file name (without extension) is the test name and the snapshot name: every `query`/`mutation`/`subscription` block in a file is registered under that name, so a second block in the same file is compared against the first one's snapshot and fails on every run. One block may still query several root fields at once (use aliases: `byOrg: alerts(...) {...}  byDeployment: alerts(...) {...}`); that is a single operation and a single snapshot.\n\n`GetAllCustomers.graphql`:\n```graphql\nquery GetAllCustomers {\n  Customer { customerid name email }\n}\n```\n\n`AddCustomer.graphql`:\n```graphql\nmutation AddCustomer {\n  Customer(event: {customerid: 123, email: \"test@example.com\", name: \"Test\"}) {\n    customerid\n  }\n}\n```\n\n**Test Execution Order:**\n1. Subscribe to all subscriptions (must be triggered by mutation)\n2. Execute mutations sequentially (alphabetical filename order) with `mutation-delay-sec` between\n3. Wait for configured timeout, then drain the Flink job\n4. Execute queries\n5. Collect subscription results\n\n**Testing SUBSCRIBE tables:**\nIf your implementation adds or modifies a `SUBSCRIBE` statement, complete all three steps before compiling:\n1. Add `kafka` to `enabled-engines` in the test `*-package.json` \u2014 subscriptions are backed by Kafka topics even in test mode. Omitting kafka produces BUILD SUCCESS but the Subscription type will be absent from the generated schema.\n2. Create a `.graphql` API test file in the test folder containing the subscription query.\n3. Ensure test data includes records that trigger the subscription.\n\nIf no mutation exists to trigger the subscription, document why testing is not feasible and add a table test validating the subscription's data source instead.\n\n## Test Data Sources\n\n**Setup Pattern:**\nIf project does not currently follow recommended setup:\n1. Move the production `CREATE TABLE` statements to `connectors/sources-prod.sqrl`\n2. Import the connector file through a template variable: `IMPORT connectors.sources-{{environment}} AS sources;`\n3. Set the variable per environment in the `<env>-package.json` overlays (invoke the `/configure-sqrl` skill, Base Config and Environment Overlays).\n4. Create `connectors/sources-test.sqrl` with the same table names with static test data (invoke the `/manage-connector` skill, Connector Definitions)\n5. Create test config file (See /configure-sqrl` skill)\n\n**Test Source Definition:**\n```sql\nCREATE TABLE MyTable (\n    -- Same columns as prod, but METADATA \u2192 regular columns with static values\n    my_timestamp TIMESTAMP_LTZ(3),\n    WATERMARK FOR `my_timestamp` AS `my_timestamp` - INTERVAL '1' SECOND\n) WITH (\n    'format' = 'flexible-json',\n    'flexible-json.timestamp-format.standard' = 'ISO-8601',\n    'path' = '${DATA_PATH}/my_table.jsonl',\n    'connector' = 'filesystem'\n);\n```\n\nThe `timestamp-format.standard` option is required for ISO-8601 timestamps (`2024-01-01T10:00:00.000Z`) in the data file; the format's default is `SQL` (`2024-01-01 10:00:00.000`), and timestamps in the other notation fail to parse.\n\n**Test Data Guidelines:**\n- Use realistic data covering relationships and joins\n- Cover edge cases and failure scenarios\n- For any filter that excludes records (e.g. `enabled = false`, reading out of bounds), include at least one record that should be excluded and verify it is absent from the output snapshot. Tests containing only passing records cannot detect broken filter logic.\n- Use jsonl for data with `flexible-json` format in connector\n- For CSV sources, the header data only lives in the schema: the column names go into the `CREATE TABLE` statement, and the CSV file contains only data rows. Write CSV fixtures without a header row and read them with `'format' = 'csv'`. Flink's `csv` format reads every line as data, so a header row becomes a bad record, and the compiler warns `CSV file [...] seems to start with a header row`. If a provided CSV file starts with a header row, note the column names first, then remove the line: `tail -n +2 data.csv > data.csv.tmp && mv data.csv.tmp data.csv`, or for a compressed file `zcat data.csv.gz | tail -n +2 | gzip > data.csv.gz.tmp && mv data.csv.gz.tmp data.csv.gz`. Declare the columns in the `CREATE TABLE` statement in the order of the removed header. CSV files have no schema discovery, so `` LIKE `data.csv` `` fails at compile time (see the `/manage-connector` skill, `formats/csv.md`).\n- Set static event timestamps for determinism, make sure: a) timestamps are monotonically increasing and b) align across multiple test datasets\n- Convert METADATA columns to regular columns with static values\n- Convert non-deterministic columns (e.g., `NOW()`) to regular columns with static values\n- Use data files for streaming tests as well. A `datagen` source fills random fields and timestamps with new values on every run, so snapshot tests over them fail.\n- Reuse an existing test source or connector configuration when it already supplies the required data and semantics.\n\n**Critical Test Setup:**\n- Before taking snapshots, the `test` command drains the Flink job, which advances all watermarks to the end. Fixtures therefore need no dummy sentinel records to close windows or temporal joins.\n- Keep `table.exec.source.idle-timeout` at `\"0 s\"` in the test package, because the test runner disables idleness. If a base package sets it, override it with `\"0 s\"` in the test overlay. With idleness enabled, the drain can drop the last events behind chained temporal joins.\n- The `test` command runs in UTC, so snapshots show `TIMESTAMP_LTZ` values and time-zone-dependent results (e.g. casting a `TIMESTAMP_LTZ` to a string) in UTC. Write fixture timestamps with an explicit offset (e.g. `2025-10-13T12:11:26.575Z`) so they are independent of the time zone. When the logic depends on a different session time zone, set `table.local-time-zone` in the Flink configuration of the package (`/configure-sqrl` skill) instead of changing the container's `TZ`.\n\n## Authentication Testing\n\nConfigure custom headers per query using `.properties` file (same name as `.graphql` file):\n```text\nAuthorization: Bearer XYZ\n```\n\nA script that reads a claim (`METADATA FROM 'auth.<claim>'`) compiles only with an auth provider in `engines.vertx.config`, and the `test` command compiles the test configuration. Put the `auth` block in the `<project>-shared-package.json` base, or in the `<project>-test-package.json` overlay (invoke the `/configure-sqrl` skill, Authentication in `vertx.md`). With the `auth` block only in the `<project>-prod-package.json` overlay, the `test` command fails with `The script reads JWT claims (...), but engines.vertx.config has no auth provider.` To generate a test token that matches the `auth` block, invoke the `/design-api` skill (Generating Tokens in `authorization.md`).\n\n## Projects with a Custom GraphQL Schema\n\nA project has a custom schema when its package configuration names a schema file under `script.api.<version>.schema` or `script.graphql`.\n`sqrl test` starts one API server with one schema. `test-runner.use-inferred-schema` in the test package chooses that schema:\n\n| `use-inferred-schema` | Schema of the test server | Table tests (`/*+test*/` tables in the `.sqrl` file) |\n|---|---|---|\n| `true` (default) | the inferred schema. The custom schema is not read | run |\n| `false` | the custom schema | do not run, and `sqrl test` reports no message |\n\nNotes:\n- API tests (the `.graphql` files in `test-runner.test-folder`) run with `use-inferred-schema` both values.\n- With `use-inferred-schema=true`, an API test gives a wrong result where the two schemas differ: a request with an enum value, a renamed argument or a custom type fails validation, and a field that the custom schema hides still returns data.\n\n### Choose the kind of test\n\nA custom schema holds changes that matter to the project, so the tests check the custom schema. Choose the tests by the condition that applies to the project:\n\n| Condition | Tests |\n|---|---|\n| **Default.** Every project with a custom schema, with or without mutations | Only API tests, in `<(sub-)project>-test-package.json`. No `/*+test*/` table in the `.sqrl` file. |\n| **Exception.** The requirements or the plan ask for a test that must not be in the API, for example a data integrity check or a validation query on data that users must not see | API tests in `<(sub-)project>-api-test-package.json`, and table tests for the requested checks in `<(sub-)project>-table-test-package.json`. Follow [Table tests in a second test package](#table-tests-in-a-second-test-package). |\n\nIn both cases:\n\n- Write each test that reads data the API returns as an API test, also when the project already has a `/*+test*/` table for it.\n- Keep API tests and table tests in separate test packages, because each test package uses one schema (see the table above).\n- Add a field to the custom schema only when users need that field. A field that exists only for a test is part of the deployed API, so every user can read that data. When the requirements or the plan ask for a test on such data, follow the exception above.\n\n### Rules for every project with a custom schema\n\n1. Set `\"use-inferred-schema\": false` in the test package that runs the API tests, so that the API tests check the custom schema. Name it `<(sub-)project>-test-package.json`, or `<(sub-)project>-api-test-package.json` when the (sub-)project also requires separate table tests (`<(sub-)project>-table-test-package.json`).\n2. Write each API test with the fields, arguments, enum values and types of the custom schema. For example, write an enum value without quotes (`genre: fantasy`). The test server rejects a request that does not fit the custom schema, and `sqrl test` saves that error as the expected result and still reports success.\n3. Keep exactly one schema file. A copy of the schema for tests looks like a way to run table tests with the custom schema, but the tests then read only the copy. An error in the real schema then stays hidden from the tests, and every schema change must be made in two files.\n\n### Table tests in a second test package\n\nFollow these steps only for the exception in [Choose the kind of test](#choose-the-kind-of-test): the requirements or the plan ask for a test that must not be in the API. In the default case, the project has one test package and no table tests, so skip this section.\n\n1. Rename `<(sub-)project>-test-package.json` to `<(sub-)project>-api-test-package.json`, so that each name says which tests it runs. Update its suite line in `run-tests.sh` such that each test exists.\n2. Create `<(sub-)project>-table-test-package.json` with `\"use-inferred-schema\": true`, its own `snapshot-folder`, and a `test-folder` that holds no `.graphql` file. A folder that does not exist works.\n3. In `run-tests.sh`, add `<(sub-)project>_table_test` to `SUBPROJECTS`, and add the suite line `<(sub-)project>_table_test/test) echo \"<(sub-)project>-shared-package.json <(sub-)project>-table-test-package.json\" ;;`.\n4. If the project has no mutation table, stop here. The table tests read the same test data files as the API tests.\n5. If the project has a mutation table, the table tests need the test data without the mutations, because the mutation test files do not fit the inferred schema:\n   1. Set `\"script\": { \"config\": { \"environment\": \"table_test\" } }` in `<(sub-)project>-table-test-package.json`.\n   2. Create `connectors/sources_table_test.sqrl`. Define each mutation table there as a filesystem table with the same name and columns.\n   3. Create a `.jsonl` file for each of these tables with the same records as the mutation test files.\n\nSee `/opt/datasqrl-examples/support_tickets/` for the default: a mutation table and API tests only.\nSee `/opt/datasqrl-examples/library_loans/` for a mutation table, API tests, and table tests in a second test package.\n\n## Test Configuration\n\n```json5\n{\n  \"test-runner\": {\n    \"snapshot-folder\": \"snapshots/myproject/\", // Snapshots output directory (default: \"./snapshots\")\n    \"test-folder\": \"api/tests/\",               // Directory containing test GraphQL queries (default: \"./tests\")\n    \"use-inferred-schema\": true,               // true: tests use the inferred schema and ignore a configured schema. false: tests use the schema under \"script.api.<version>.schema\" or \"script.graphql\" (default: true)\n    \"delay-sec\": 30,                           // Max wait in sec for the job to finish before taking snapshots; ends early when the job terminates. -1 = wait until all operators are idle and required-checkpoints completed (streaming) or until the job completes (batch) (default: 30)\n    \"mutation-delay-sec\": 0,                   // Pause(s) between mutation queries (default: 0)\n    \"required-checkpoints\": 0,                 // Minimum completed Flink checkpoints before taking snapshots (requires delay-sec = -1)\n    \"create-topics\": [\"topic1\", \"topic2\"],     // Kafka topics to create before tests start\n    \"headers\": {                               // Any HTTP headers to add during the test execution. For example, JWT auth header\n      \"Authorization\": \"Bearer <token>\"\n    }\n  }\n}\n```\n\n# Running Tests\n\n## Project Test Script\n\nEvery project root must hold a test runner script, **`run-tests.sh`**, that is the entry point for the project's tests: you as the code agent run it, CI runs it and developer can run it. It owns the whole test process (setup, every suite, teardown) and returns exit code 0 ONLY if all tests pass. It also *reports* what the project contains.\n\nExamples:\n```bash\n./run-tests.sh                                          # every suite, env=test default\n./run-tests.sh fraud_store                              # only the named sub-project(s)\n./run-tests.sh --compile --env dev                      # compiles the dev config\n./run-tests.sh --list-envs                              # Example output: test dev prod\n./run-tests.sh --list-subprojects                       # Example output: fraud_store fraud_training\n./run-tests.sh --list-invocations --compile --env dev   # print what would run, run nothing\n```\n\n### The script contract\n\n- **No arguments runs every suite**; sub-project names select suites.\n- **Sub-project names are single words**: letters, digits, `_`, `-`, `.` and nothing else. They are carried in a space-separated list and reported one per line as `SQRL_INVOCATION <sub-project-name> <verb> <config...> -b <build-dir>`, so a name containing a space is read as two names and the report cannot be parsed. `fraud_store` and `fraud-store` are fine; `fraud store` is not.\n- **Setup and teardown live in the script** and run on every invocation, e.g. test-data generation or download (data too large for git), fixture start, cleanup. This is the only place complex test setup can live. Guard them with `$LIST` so listing stays side-effect free.\n- Every selected suite runs even after one fails, and the script exits non-zero when any of them failed.\n- **Declare, do not detect.** `SUBPROJECTS`, `ENVS` and the `suite` table are written out; a name or environment the project does not have is an error (exit 2), never a silent no-op that runs nothing and reports success.\n- **Declare every environment.** `ENVS` names every environment that has a `<sub-project>-<env>-package.json` overlay, and the `suite` table has a line for each of them. The verification compile and the README commands use only the environments that `ENVS` names.\n- **The `suite` table names configs literally**, in merge order \u2014 base first, environment config last, because a later configuration file overrides an earlier one.\n- **Every sub-project gets its own build folder.** Every invocation (compile or test) carries\n  `-b <sub-project>`, so one suite never overwrites a sibling's artifacts and after a single run\n  every sub-project's build is still on disk. The flag names a **subfolder of `build/`**: `-b fraud_store` writes to `<project-root>/build/fraud_store`.\n- **`-b` requires `-r`.** Pointing `-b` inside `build/` makes the compiler resolve `script.main`\n  against the wrong root unless the project root is given too: `-r .` for a project that is the\n  mount root, `-r <project-dir>` when it sits inside a repository. With `-r`, config paths are\n  relative to that root and carry no prefix.\n- **Keep it in sync**: a new sub-project means a new entry in `SUBPROJECTS` and a `suite` line per environment it supports.\n- `chmod +x run-tests.sh` after writing it.\n\n**Scope:** While iterating, pass the names of the sub-projects you are working on as arguments of `run-tests.sh` so only their suites run. Your run must cover everything that changed: every sub-project newly generated or edited, plus every sub-project affected by an edit to shared code or configuration. Before running the script, list the generated, edited and affected sub-projects, and pass exactly that list as the arguments.\n\n**DataSQRL CLI version.**  Currently used DataSQRL CLI version: 0.12.5. The code agent container runs specific DataSQRL version. The test shell scrip pins `SQRL_VERSION` to the same default so a CI or local run compiles and snapshots with the version the project was built against.\n\n### The script\n\nThis skill comes with a [run-tests.sh](run-tests.sh) template that follows the contract above. Copy it into the project root and make the copied file executable.\n\nThen edit only the three blocks marked `EDIT FOR YOUR PROJECT`: the `ENVS` and `SUBPROJECTS` declarations, the `suite` table, and the optional setup and teardown hooks. Keep everything else unchanged.\n\nAfter completing the script, verify the script. First run `./run-tests.sh --list-invocations` and check that every sub-project appears with the configs you expect. Then run `./run-tests.sh` for only the sub-projects you changed (see **Scope** above).\n\nFor an example with two sub-projects (one of them has no prod config), see `/opt/datasqrl-examples/feature_store/run-tests.sh`.\n\n## One Invocation per Test Package\n\nA project folder may hold several **sub-projects** (deployments), each with its own\n`*-test-package.json`. The `suite` table in `run-tests.sh` carries one entry per\n(sub-project, environment), naming that combination's configs in merge order:\n\n```bash\n    <sub-project>/<env>) echo \"<base config> <env config>\" ;;\n```\n\nThe driver runs one `cmd.sh` invocation per selected sub-project per selected environment from those entries.\n\n- Multiple package arguments to one invocation always result in a merged configuration (last file overwrites). That is what makes base + overlay work.\n- Drop the `<project>-shared-package.json` argument only for a project that has no base config. Invoke the `/configure-sqrl` skill (Base Config and Environment Overlays, Sub-projects) while setting the config files.\n- Listing two different sub-projects' test packages in one invocation merges them into one configuration and fails the build.\n- Keep the `-r <root> \u2026 -b <sub-project>` form on every direct invocation too, matching the suite's build folder, so a hand-run compile lands where the framework and the next suite run expect it.\n- Give each test package its own `test-runner.snapshot-folder`, set in its `-test-package.json` overlay (for example `snapshots/fraud_store/`, `snapshots/fraud_training/`); sharing one folder makes the runs clobber each other's snapshots.\n\n**Project inside a repository.** Package paths resolve at the compiler's mount root. When the project is a subdirectory of the repository (the compiler mounts the repository root), every package path carries the project directory as a prefix. The suite lines pick that prefix up from `SQRL_PACKAGE_PREFIX` (`${P}`), and the `sqrl()` function adds `-r <project-dir>` on the CI/local docker path. As a fallback, when you call `/opt/agent/cmd.sh` directly, qualify the paths yourself. The same form applies to `compile` and `run`:\n\n```bash\n/opt/agent/cmd.sh test -r {your-project-dir} {project}-shared-package.json {project}-test-package.json -b {sub-project}\n# equivalently\n/opt/agent/cmd.sh test -r . {project}-shared-package.json {project}-test-package.json -b {sub-project}   # project IS the mount root\n```\n\nThe `-b` value stays **un-prefixed**: it is resolved against the root given by `-r`, so `-r {your-project-dir} \u2026 -b x` writes `{your-project-dir}/build/x`.\n\nWhen the project *is* the repository root, the plain `/opt/agent/cmd.sh test {package.json}` form applies.\n\n**Direct CLI fallback.** When the script is broken, fix it. As a fallback, call `/opt/agent/cmd.sh test -r <root> <base config> <overlay config> -b <sub-project>`; `run-tests.sh` stays the command of record and the layering rules above apply to the direct call unchanged.\n\nExample: `/opt/datasqrl-examples/feature_store/` ships two sub-projects (deployments) over one shared feature computation (`fraud_features.sqrl`): a realtime feature store with an API (`fraud_store`) and a batch training run (`fraud_training`).\n\n```bash\n/opt/agent/cmd.sh test -r . fraud_store-shared-package.json fraud_store-test-package.json -b fraud_store\n/opt/agent/cmd.sh test -r . fraud_training-shared-package.json fraud_training-test-package.json -b fraud_training\n```\n\n**Edge case: `-r` must match what is mounted at `/workspace`.**: \n* Wrong `-r`: If a compile fails with:\n\n```\nProject root does not exist or not a directory: /workspace/<path>\n```\n\nthe `-r` value points at the wrong place. `-r` is resolved against `/workspace`, and the mount at `/workspace` is fixed for the whole run, so the fix is to correct `-r`:\n\n- The project itself is mounted at `/workspace` (single-project run): use `-r .` and pass the package files without a prefix.\n- The repository is mounted at `/workspace` (the project sits in a subdirectory of the repo): use `-r <project-dir>` or prefix every package path with `<project-dir>/` too.\n\nThis error comes from a direct `cmd.sh` call. `run-tests.sh` script derives the root from `SQRL_PACKAGE_PREFIX` when it is provided.\n\n\n## Snapshot Lifecycle\n\n- **The first run of a new test always reports BUILD FAILURE** and prints `Snapshot created for test: <name> \u2014 Rerun to verify.` \u2014 this is expected, not an error. Re-run the same test immediately; the second run compares against the created snapshots and reports BUILD SUCCESS if the output is consistent.\n- After snapshot creation, read each snapshot file to verify the captured data is correct before accepting it.\n- Snapshots are generated compiled output, so never edit them by hand. When SQRL code, test data, or a `/*+test*/` table's name or output schema changes, delete the affected snapshot files and re-run the tests to regenerate them; then verify the new snapshots as above.\n\n# Test Automation (CI)\n\nAfter `run-tests.sh` works, you MUST read [github-test-automation.md](github-test-automation.md) and follow its steps to set up the CI workflow.\n"}], "isError": false, "durationMs": 3, "timestamp": 1795509908811}, {"role": "toolResult", "toolCallId": "call_01a20cbaf3297182aa345e43", "toolName": "read", "content": [{"type": "text", "text": "---\nname: monitor-pipeline\ndescription: Use when reviewing a DataSQRL pipeline's monitoring needs or implementing data-quality captures and observability statistics. Decide which data quality and monitoring tables are useful and how to build them.\n---\n\n\n# Monitor the pipeline: data quality and observability tables\n\nMonitor things that matter to the result of this particular job. Balance the benefit against performance, storage cost, and noise. \n\n## Two kinds of monitoring tables\n\n**Data-quality table (`DQ_` prefix).** Collect unexpected records that matter to this job's processing or result. Use aggregate counters instead when individual records are unnecessary or too numerous to retain.  Examples include a transaction with no matching customer at event time, an address with a start date after its end date, or an event from an unknown sender. Each row should describe a problem that someone can investigate or fix.\n\n**Observability statistics table (`OB_` prefix).** Count records over time at a level that platform metrics do not show. Examples include hourly counts by sender, source table, or partition. Counts can also be split by valid records and rejection reason. A missing row or a lower count can indicate a problem.\n\n## Decide whether a table is needed for data quality or observability\n\n1. **Treat catalog assertions as guarantees.** Assertions such as `/*+test(no_rows) */` document what downstream jobs can rely on. Do not turn them into production checks because they run only in tests. Treat an assertion as unenforced only when the catalog or source explicitly documents that it is not enforced on source data and must be evaluated downstream.\n2. **Only put DQ on sources when both conditions hold:** invalid data would break this job's processing or intended result, and the invalid data can reach this job because the relevant upstream guarantee is absent or explicitly unenforced. Use cleaned catalog tables by default. A job whose purpose is cleaning or enriching raw records can read the raw layer and capture rejected records or counters. Shared cleanup and monitoring belong in the catalog or an upstream job.\n3. **Failures in this job that matter to consumers or downstream.** Inspect joins, filters, and derived results for credible failures. A missing customer at transaction time warrants a capture only when it can happen and silently dropping the transaction harms the result. Skip intentional exclusions and acceptable defaults.\n4. **Observe critical blind spots.** Add statistics/metrics only when they help assess the job's health. Do not count every source by default. Example: A department-level count is useful when independent departments send critical input and aggregate metrics would hide one department stopping. \n5. **Require an action and consider cost.** Before adding a table, state what it detects, how it affects this job, why existing guarantees or monitoring do not cover it, and who will act. Consider state, storage, retention, cardinality, and noise; use counters when keeping individual invalid records would be too expensive. An upstream source check may not cover a failure introduced by this job's own processing.\n\n\n## Use the patterns as examples\n\nApply a pattern only after it meets the rules above. These examples are not a checklist of tables to create. Investigate the actual sources and processing for the job-specific decision.\n\n## Pattern 1: collect events with missing master data\n\nIn this example, each transaction needs a matching customer record at event time, the catalog does not guarantee that temporal match, and losing a transaction would make the job's result incomplete. Operations needs the individual records to reconcile them. Use a LEFT temporal join so unmatched transactions remain available to a DQ table. Classify the result once, then use that classification for the main processing and the DQ table.\n\n```sql\n_Customer := DISTINCT cat.Customer ON customer_id ORDER BY source_updated_at DESC;\n\n_TransactionClassified := SELECT t.*,\n    CASE\n      WHEN c.customer_id IS NULL THEN 'unknown_customer'\n      ELSE 'valid'\n    END AS ingestion_status\n  FROM cat.Card_Transaction t\n  LEFT JOIN _Customer FOR SYSTEM_TIME AS OF t.event_time AS c\n    ON t.customer_id = c.customer_id;\n\n-- The main processing reads only transactions with a matching customer.\nTransaction := SELECT * FROM _TransactionClassified WHERE ingestion_status = 'valid';\n\n/** DQ: Transactions with no matching customer version at event time.\n    These records are excluded from the main processing and remain available for investigation. */\n/*+query_by_any(customer_id) */\nDQ_Transaction_Unknown_Customer := SELECT transaction_id, customer_id, amount_cents, event_time\n  FROM _TransactionClassified WHERE ingestion_status = 'unknown_customer'\n  ORDER BY event_time DESC, transaction_id ASC;\n```\n\nUse this pattern when a missing match is a problem. If discarding the record or using a default is acceptable, document that choice. Do not add a DQ table for an intentional, harmless exclusion. If several rejection reasons are useful, extend the classification and explain how a record that fails several checks is handled.\n\n## Pattern 2: capture rejected records in a cleaning job\n\nPattern only in a job responsible for cleaning raw address records whose effective windows are not guaranteed valid. Invalid windows would break that job's intended output, and rejected records are needed for repair.\n\n```sql\n/** DQ: Address records with invalid effective window (effective_from > effective_to).\n    Raw records rejected by this cleaning job, retained for repair. */\nDQ_Address_Window_Issues := SELECT customer_id, address_type, effective_from, effective_to,\n    source_updated_at, ingested_at\n  FROM cat.Customer_Address_raw\n  WHERE effective_to IS NOT NULL AND effective_from > effective_to\n  ORDER BY source_updated_at DESC, customer_id ASC, address_type ASC;\n```\n\n## Pattern 3: find missing or inconsistent derived state\n\nA pipeline can keep a record even when related data is missing. Inspect derived tables for conditions that need attention, including conditions that affect compliance.\n\nHere, `_Customer` is the latest customer table from Pattern 1. `_CustomerRiskRating` contains the latest rating marked as current for each customer. Follow the actual source's rules for representing current ratings when adapting this example.\n\n```sql\n_CurrentRiskRating := SELECT * FROM cat.Customer_Risk_Rating WHERE is_current = true;\n_CustomerRiskRating := DISTINCT _CurrentRiskRating ON customer_id ORDER BY source_updated_at DESC;\n\n/** DQ: Active customers without a current AML risk rating \u2014 compliance-sensitive.\n    Rows require investigation by this job's risk operations team. */\n/*+query_by_any(customer_id) */\nDQ_Unrated_Active_Customers := SELECT c.customer_id, c.customer_status,\n    c.source_updated_at, c.ingested_at\n  FROM _Customer c\n  LEFT JOIN _CustomerRiskRating r ON c.customer_id = r.customer_id\n  WHERE c.customer_status = 'ACTIVE' AND r.customer_id IS NULL\n  ORDER BY c.source_updated_at DESC, c.customer_id ASC;\n```\n\nThis table reports a current condition. A customer should leave the result when a current rating becomes available or the customer is no longer active.\n\n## Pattern 4: count received records by source\n\nCombine source records and count them by source and hour before filtering or deduplication.\n\n```sql\n_SourceRecords := SELECT 'Customer' AS source_name, ingested_at FROM cat.Customer\n  UNION ALL SELECT 'Customer_Address' AS source_name, ingested_at FROM cat.Customer_Address\n  UNION ALL SELECT 'Card_Transaction' AS source_name, ingested_at FROM cat.Card_Transaction;\n\n/** OB: Hourly counts of received records for each source.\n    Changes in counts or missing hours can indicate an input problem. */\n/*+query_by_any(source_name) */\nOB_SourceIngestionStats := SELECT source_name, window_start, window_time AS window_end,\n    COUNT(*) AS record_count\n  FROM TABLE(TUMBLE(TABLE _SourceRecords, DESCRIPTOR(ingested_at), INTERVAL '1' HOUR))\n  GROUP BY source_name, window_start, window_end, window_time\n  ORDER BY window_time DESC, source_name ASC;\n```\n\nWhen a source has independent senders, also group by a sender field, such as department or partner, where useful. Count the raw source records by arrival time in the same way. This helps users notice when one sender stops while others continue.\n\n\n## Names, API access, and documentation\n\n- Name DQ tables `DQ_<Subject>_<Condition>`. Name observability statistics tables `OB_<Subject>Stats`, for example `OB_SourceIngestionStats`. Both kinds are exposed, so do not start their names with `_`. Start intermediate table names with `_`.\n- Give each exposed table a deterministic `ORDER BY` and a `/*+query_by_any(...) */` hint for the columns users filter by. If a DQ table can grow without limit, serve it from Iceberg through a table function with a `from_time` argument. Follow `/design-api`.\n- Start each table's documentation comment by explaining what a row or count means. Explain what problem it helps detect.\n- Add a \"Data quality and observability\" section to the README. List the tables, explain what a row or missing row means, and link to tables in other projects that provide existing coverage. Follow `/write-documentation`.\n\n## Testing\n\nGive every DQ table and every observability statistics table its own `/*+test */` snapshot.\n\nIf the pipeline owns its test data, prepare it according to the project's data quality tables and observability metrics. Choose test cases that exercise what each table checks or measures. Adapt the cases to the project's logic.\n\nIf the pipeline reads clean test data from a catalog connector, expect empty DQ snapshots and record this expectation in the plan. OB snapshots should still contain the counts expected from that data. State which cases the available data does not cover. An empty DQ snapshot alone does not show that invalid records would be detected.\n```sql\n/*+test */\nDQTransactionUnknownCustomerTest := SELECT transaction_id, customer_id, event_time\n  FROM DQ_Transaction_Unknown_Customer ORDER BY event_time ASC, transaction_id ASC;\n\n/*+test */\nDQAddressWindowIssuesTest := SELECT * FROM DQ_Address_Window_Issues;\n\n/*+test */\nDQUnratedActiveCustomersTest := SELECT * FROM DQ_Unrated_Active_Customers;\n\n/*+test */\nOBSourceIngestionStatsTest := SELECT * FROM OB_SourceIngestionStats;\n```\n\n## Script layout\n\nAfter the main processing definitions, group DQ tables, observability statistics tables, and tests under the following comments, in this order. This makes them easier for readers and later repository surveys to find.\n\n```sql\n-- ============================================================\n-- DATA QUALITY TABLES\n-- ============================================================\n\n-- ============================================================\n-- OBSERVABILITY\n-- ============================================================\n\n-- ============================================================\n-- TEST QUERIES\n-- ============================================================\n```\n"}], "isError": false, "durationMs": 2, "timestamp": 1795509908811}, {"role": "assistant", "content": [{"type": "thinking", "thinking": "Now let me read the vertx auth reference and init-sqrl briefly, and examine test data. Let me also check the requirements file to be sure the prompt matches. Actually the prompt already contains the full requirements. But the file must be referenced.\n\nLet me read the vertx auth section. And check the requirements file exists. Let me also glance at the test data to understand structure (data-observation). Given plan only, I don't need to compute expected values (the planner computes? Actually the plan says \"The planner computes the expected values from the test data.\" Hmm, but the plan just references requirements; downstream implementation computes. I'll leave it.\n\nLet me read the vertx.md auth and check test data files.", "thinkingSignature": "reasoning_content"}, {"type": "toolCall", "id": "call_01a20cbafbe876a3b27a07bb", "name": "bash", "arguments": {"command": "sed -n '1,200p' /opt/agent/skills/configure-sqrl/vertx.md | grep -n \"auth\\|Authentication\\|issuer\\|audience\\|keys\\|engine\\|graphQLTail\" | head -60; echo \"===FIND TESTDATA===\"; ls -la /workspace/data-catalog/lending/cards_consumer_credit/testdata/ 2>/dev/null; echo \"===HEAD PERSONAL===\"; head -2 /workspace/data-catalog/lending/cards_consumer_credit/testdata/consumer_loans-personal_loan.jsonl; echo \"===WC===\"; wc -l /workspace/data-catalog/lending/cards_consumer_credit/testdata/consumer_loans-*.jsonl"}}, {"type": "toolCall", "id": "call_01a20cbafcfc7e11a38f114d", "name": "read", "arguments": {"path": "/opt/agent/skills/init-sqrl/SKILL.md"}}], "api": "openai-completions", "provider": "together", "model": "deepseek-ai/DeepSeek-V4.1-Flash", "usage": {"input": 13192, "output": 393, "cacheRead": 65024, "cacheWrite": 0, "reasoning": 149, "totalTokens": 78609, "cost": {"input": 0.0039575999999999995, "output": 0.00047159999999999997, "cacheRead": 0.000390144, "cacheWrite": 0, "total": 0.004819344}}, "stopReason": "toolUse", "timestamp": 1795509908814, "responseId": "130806eb03834e77b5b4af1cca3fc0a1-aws_ec1", "rawStopReason": "tool_calls", "durationMs": 2183, "thinkingLevel": "high"}, {"role": "toolResult", "toolCallId": "call_01a20cbafbe876a3b27a07bb", "toolName": "bash", "content": [{"type": "text", "text": "5:| `authKind` | **array**  | `[]`      | Not read by the server; `auth` needs no `authKind`    |\n6:| `config`   | **object** | see below | Vert.x-specific configuration including auth settings |\n10:The compiler generates the full server configuration from a built-in template and deep-merges `engines.vertx.config` over it, so any server setting can be overridden, not just authentication. Nested objects are merged key by key, while arrays replace the default array. Commonly overridden settings:\n25:  \"engines\": {\n41:For all settings and their effective values, compile the project and read the generated `deploy/plan/vertx-config.json` under the build directory (`build/` normally or `build/<sub-project>/` when compiling with `-b`). It contains the full server configuration with the overrides from `engines.vertx.config` applied.\n51:  \"engines\": {\n54:        \"graphQLTailSampleTracingConfig\": {\n64:All keys go under `engines.vertx.config.graphQLTailSampleTracingConfig`:\n90:All keys go under `engines.vertx.config.jdbcStatementLogConfig.largeResults`. `jdbcStatementLogConfig` holds the logs about individual database queries, and each has its own `enabled` flag:\n97:## Authentication\n99:Configure `auth` with the list of trusted token issuers. Each issuer carries its own audiences and signing keys, and a\n100:token is accepted only when its `iss`, `aud` and signature all match the same issuer.\n104:  \"engines\": {\n107:        \"auth\": {\n108:          \"issuers\": [\n110:              \"issuer\": \"https://login.example.com/\",\n111:              \"audiences\": [\"https://app.example.com\", \"https://admin.example.com\"]\n114:              \"issuer\": \"https://<tenant>.us.auth0.com/\",\n115:              \"audiences\": [\"https://api.example.com/\"]\n128:| `issuers`                 | Yes      |                                  | Non-empty array of trusted issuers                                               |\n129:| `leeway`                  | No       | `60`                             | Clock skew in seconds; resolution order is `issuers[].leeway`, `leeway`, 60      |\n130:| `algorithms`              | No       | no restriction                   | Allowed signature algorithms; an issuer's own `algorithms` overrides it          |\n133:| `issuers[].issuer`        | Yes      |                                  | Exact `iss` value, including a trailing slash; unique                            |\n134:| `issuers[].audiences`     | Yes      |                                  | Non-empty; the token's `aud` must contain one of them                            |\n135:| `issuers[].keys`          | No       |                                  | Inline JWKs (RFC 7517); cannot rotate, so prefer discovery                       |\n136:| `issuers[].jwksUri`       | No       |                                  | JWK Set URL; set at most one of `keys` and `jwksUri`                             |\n137:| `issuers[].leeway`        | No       | `auth.leeway`                    | Per-issuer leeway; negative values are rejected                                  |\n138:| `issuers[].algorithms`    | No       | `auth.algorithms`                | Per-issuer allowed algorithms                                                    |\n140:With neither `keys` nor `jwksUri`, keys come from OIDC discovery at `<issuer>/.well-known/openid-configuration`, so\n141:`issuer` must then be an absolute http(s) URL. Keys are fetched once at startup; the server fails to start if they cannot\n144:any other algorithm are rejected. Set `algorithms` to restrict this, or to use keys without `alg` for other algorithms:\n146:example `\"algorithms\": [\"PS256\"]` for an RSA key without `alg` that signs `PS256`). Compilation fails if none of an issuer's inline\n147:`keys` can verify signatures, because it would accept unsigned tokens; for keys from a `jwksUri` or discovery, the server\n148:does not start. Unknown keys, duplicate issuers, unsupported algorithms and the other invalid\n151:The MCP discovery endpoint `/.well-known/oauth-protected-resource` advertises the issuers without inline `keys` whose\n152:`issuer` is a URL as `authorization_servers`. Issuers with inline `keys` sign their own tokens and are not advertised;\n153:when no issuer is advertised, the endpoint is not served and MCP `401` responses carry no `WWW-Authenticate` header.\n155:For a shared secret (tests), use inline `\"keys\": [{ \"kty\": \"oct\", \"k\": \"<base64url secret>\" }]`; the `/design-api` skill's\n156:[authorization.md](../design-api/authorization.md#generating-tokens) shows how to encode it.\n158:String values can reference environment variables, e.g. `\"issuer\": \"${AUTH_ISSUER}\"`. They are resolved when the\n161:Package layers merge objects key by key but replace arrays whole: a later layer can patch `auth.leeway` alone, but a\n162:layer that sets `auth.issuers` must list every issuer of its environment. `auth` cannot be combined with `jwtAuth` or\n163:`oauthConfig`, even across layers; set the old block to `null` in the layer that introduces `auth`.\n165:## JWT Authentication (deprecated)\n167:`jwtAuth` is deprecated; use `auth`. Its field names map to Vert.x Java POJOs and are case-sensitive. Compilation fails if it has no key that can verify signatures (for example with no `pubSecKeys`, `jwks` or `keyStore`). If none of the keys `oauthConfig` discovers can verify signatures, the server does not start.\n171:  \"engines\": {\n180:            \"issuer\": \"https://issuer.example\",\n181:            \"audience\": [\"my-api\"],\n194:## OAuth 2.0 Authentication (deprecated)\n196:`oauthConfig` is deprecated because it checks neither `iss` nor `aud`; use `auth`. OAuth enables MCP clients to discover the authorization server at `/.well-known/oauth-protected-resource`.\n200:  \"engines\": {\n===FIND TESTDATA===\ntotal 12244\ndrwxr-xr-x 17 root root     544 Nov 24 08:27 .\ndrwxr-xr-x 13 root root     416 Nov 24 08:27 ..\n-rw-r--r--  1 root root  157145 Nov 24 08:27 consumer_loans-auto_loan.jsonl\n-rw-r--r--  1 root root   38474 Nov 24 08:27 consumer_loans-consumer_loan_delinquency_event.jsonl\n-rw-r--r--  1 root root  312922 Nov 24 08:27 consumer_loans-loan_application.jsonl\n-rw-r--r--  1 root root 1149330 Nov 24 08:27 consumer_loans-loan_payment.jsonl\n-rw-r--r--  1 root root  142600 Nov 24 08:27 consumer_loans-personal_loan.jsonl\n-rw-r--r--  1 root root   45087 Nov 24 08:27 credit_cards-card_delinquency_event.jsonl\n-rw-r--r--  1 root root  229821 Nov 24 08:27 credit_cards-credit_card_account.jsonl\n-rw-r--r--  1 root root  188425 Nov 24 08:27 credit_cards-credit_card.jsonl\n-rw-r--r--  1 root root 1040770 Nov 24 08:27 credit_cards-credit_card_payment.jsonl\n-rw-r--r--  1 root root 1511049 Nov 24 08:27 credit_cards-credit_card_statement.jsonl\n-rw-r--r--  1 root root  206287 Nov 24 08:27 credit_cards-credit_limit_history.jsonl\n-rw-r--r--  1 root root 1236995 Nov 24 08:27 credit_risk_signals-credit_utilization.jsonl\n-rw-r--r--  1 root root 3174132 Nov 24 08:27 credit_risk_signals-customer_credit_exposure.jsonl\n-rw-r--r--  1 root root  378776 Nov 24 08:27 credit_risk_signals-delinquency_rollforward.jsonl\n-rw-r--r--  1 root root 2689373 Nov 24 08:27 credit_risk_signals-payment_behavior.jsonl\n===HEAD PERSONAL===\n{\"loan_id\":\"PL-011\",\"application_id\":\"LAPP-023\",\"primary_borrower_customer_id\":\"CUST-066\",\"loan_number\":\"PL-2020-28229\",\"loan_status\":\"PAID_OFF\",\"loan_purpose\":\"MAJOR_PURCHASE\",\"original_amount_cents\":1740000,\"current_balance_cents\":0,\"interest_rate\":0.1566,\"rate_type\":\"FIXED\",\"original_term_months\":24,\"remaining_term_months\":0,\"monthly_payment_cents\":84913,\"funding_date\":\"2020-09-11\",\"first_payment_date\":\"2020-10-11\",\"maturity_date\":\"2022-09-11\",\"next_payment_due_date\":null,\"paid_off_date\":\"2022-09-04\",\"origination_fee_cents\":34800,\"credit_score_at_origination\":644,\"dti_at_origination\":24.62,\"autopay_enrolled\":true,\"disbursement_account_id\":\"ACCT-140\",\"payment_account_id\":\"ACCT-140\",\"origination_channel\":\"BRANCH\",\"source_system\":\"CONSUMER_LENDING\",\"source_updated_at\":\"2022-09-04T12:40:57Z\",\"ingested_at\":\"2022-09-04T12:44:22Z\"}\n{\"loan_id\":\"PL-014\",\"application_id\":\"LAPP-026\",\"primary_borrower_customer_id\":\"CUST-392\",\"loan_number\":\"PL-2020-51718\",\"loan_status\":\"PAID_OFF\",\"loan_purpose\":\"HOME_IMPROVEMENT\",\"original_amount_cents\":910000,\"current_balance_cents\":0,\"interest_rate\":0.1032,\"rate_type\":\"FIXED\",\"original_term_months\":24,\"remaining_term_months\":0,\"monthly_payment_cents\":42126,\"funding_date\":\"2020-11-08\",\"first_payment_date\":\"2020-12-08\",\"maturity_date\":\"2022-11-08\",\"next_payment_due_date\":null,\"paid_off_date\":\"2022-10-26\",\"origination_fee_cents\":18200,\"credit_score_at_origination\":733,\"dti_at_origination\":28.97,\"autopay_enrolled\":true,\"disbursement_account_id\":\"ACCT-450\",\"payment_account_id\":\"ACCT-450\",\"origination_channel\":\"ONLINE\",\"source_system\":\"CONSUMER_LENDING\",\"source_updated_at\":\"2022-10-26T14:59:04Z\",\"ingested_at\":\"2022-10-26T15:01:21Z\"}\n===WC===\n    135 /workspace/data-catalog/lending/cards_consumer_credit/testdata/consumer_loans-auto_loan.jsonl\n     56 /workspace/data-catalog/lending/cards_consumer_credit/testdata/consumer_loans-consumer_loan_delinquency_event.jsonl\n    382 /workspace/data-catalog/lending/cards_consumer_credit/testdata/consumer_loans-loan_application.jsonl\n   1942 /workspace/data-catalog/lending/cards_consumer_credit/testdata/consumer_loans-loan_payment.jsonl\n    170 /workspace/data-catalog/lending/cards_consumer_credit/testdata/consumer_loans-personal_loan.jsonl\n   2685 total\n"}], "isError": false, "durationMs": 23, "timestamp": 1795509911022}, {"role": "toolResult", "toolCallId": "call_01a20cbafcfc7e11a38f114d", "toolName": "read", "content": [{"type": "text", "text": "---\nname: init-sqrl\ndescription: Use when starting a new DataSQRL project or initializing an empty pipeline. Use for greenfield implementations, project scaffolding, or setting up the folder structure.\nmodes: [planning, implementation, setup, question]\n---\n\nFollow these steps to initialize a DataSQRL project:\n1. When an available examples directory contains a useful starting point, review its `README.md` and relevant projects. Treat its contents as optional reference material, not required templates.\n2. Adapt relevant example files into the working directory only when they fit the task. Don't overwrite existing files. If no example fits, scaffold the project with `/opt/agent/cmd.sh init <type> <name>` instead (it creates the `<name>/` folder; see `CLI_REFERENCE.md`). Pick the type by the pipeline's output:\n   * `api`: data served through a GraphQL API (Flink, PostgreSQL, Kafka, Vert.x). The production source `connectors/sources-prod.sqrl` is an internal Kafka table (`/*+ engine(kafka) */`), exposed as a mutation.\n   * `stream`: results written to Kafka topics (Flink, Kafka). The production source is an internal Kafka table, and the script exports its result with `EXPORT HelloWorld TO log.HelloWorld;`. Without an API, only exported tables are written anywhere: export each result the user needs, and the script must have at least one `EXPORT` to compile.\n   * `dataset`: results written to Iceberg and queried through DuckDB (Flink, Iceberg, DuckDB). The production source is an existing Iceberg table (`'connector' = 'iceberg'`): set its catalog options (`catalog-type`, `catalog-name`, `warehouse`, `catalog-table`) to the user's lakehouse.\n   * The test package of every type reads the sample data in `connectors/test-data/` and compiles and tests out of the box. Replace the `Messages` sources and the sample data with the real sources (step 4).\n3. Review provided source/sink table definitions in sub-folders to identify the sqrl files that define the sources and sinks required for the implementation. If the requirements reference a provided data catalog, include that catalog and delete copied connectors unless the requirements specifically ask to create additional sources/sinks outside the catalog.\n4. Update copied files to match user requirements by:\n   * **ALWAYS** invoke the relevant skill before updating or implementing anything\n   * Use user-provided source/sink definitions from sub-folders or an included data catalog if they exist (include/import them, reusing what exists), otherwise update the template connectors. Invoke the `/manage-connector` skill (Connector Organization) before writing or editing any source/sink definition.\n   * Updating the SQRL files to use those sources & sinks and adjust implementation by matching the code to the updated table schemas and removing features that are not required. Invoke the `/implement-sqrl` skill before writing or significantly modifying any SQRL logic during this step.\n   * When renaming the main `.sqrl` script, update `script.main` key in the (sub-)project's base config so every package.json reference matches the actual filename before the first compile. When creating or updating any configuration, invoke `/configure-sqrl` skill.\n   * Update the project configuration if necessary.\n   * Update the GraphQL API definition and defined operations to match the new schema.\n   * Create or update the configuration files: a `*-shared-package.json` base plus `*-<env>-package.json` thin per-environment overlays. Invoke the `/configure-sqrl` skill (Base Config and Environment Overlays).\n   * Add `/*+test */` annotated SQL test queries at the end of the main SQRL script(s) for each exposed table. These test queries should SELECT from the table with a WHERE filter on a known test data value and produce deterministic results. Invoke the `/test-sqrl` skill (Writing Tests) for the test and test-data rules, then delete the template's existing snapshots and run the tests to generate fresh ones (Running Tests, Snapshot Lifecycle).\n   * Create or update the test runner script `run-tests.sh` which is the entry point for the project's tests. Invoke the `/test-sqrl` skill for details.\n   * Update `README.md` with user requirements and project description. Add a list of features that are required by the user but not part of the template and need to be implemented\n"}], "isError": false, "durationMs": 8, "timestamp": 1795509911022}, {"role": "assistant", "content": [{"type": "thinking", "thinking": "I now have enough context. Let me also look at the run-tests.sh template and the customer project's package for another reference. Let me also check the requirements file is present. And check the data-catalog's run-tests.sh template. Actually the test-sqrl skill ships run-tests.sh. Let me read that template so the plan can reference it correctly.\n\nAlso, I should check the lending README for project structure and the customer project's approach. But I think I have enough.\n\nLet me read the test-sqrl run-tests.sh template briefly, and the lending README.", "thinkingSignature": "reasoning_content"}, {"type": "toolCall", "id": "call_01a20cbb0401796083f4d4d9", "name": "read", "arguments": {"path": "/opt/agent/skills/test-sqrl/run-tests.sh"}}, {"type": "toolCall", "id": "call_01a20cbb042a7e90b06f258b", "name": "read", "arguments": {"path": "/workspace/lending/README.md"}}], "api": "openai-completions", "provider": "together", "model": "deepseek-ai/DeepSeek-V4.1-Flash", "usage": {"input": 3672, "output": 210, "cacheRead": 78592, "cacheWrite": 0, "reasoning": 123, "totalTokens": 82474, "cost": {"input": 0.0011015999999999999, "output": 0.000252, "cacheRead": 0.000471552, "cacheWrite": 0, "total": 0.001825152}}, "stopReason": "toolUse", "timestamp": 1795509911024, "responseId": "5818e4b3010448c3b06d2504a2f1c7fb-aws_ec1", "rawStopReason": "tool_calls", "durationMs": 1745, "thinkingLevel": "high"}, {"role": "toolResult", "toolCallId": "call_01a20cbb0401796083f4d4d9", "toolName": "read", "content": [{"type": "text", "text": "#!/usr/bin/env bash\n# This project's suites \u2014 one command, deterministic exit code.\n# Used by the DataSQRL agent and by CI.\n#\n# USAGE\n#   ./run-tests.sh [options] [<sub-project> ...]\n#\n#   <sub-project>       zero or more names, in any order, selecting which suites run.\n#                       Give none to run them all. Options may appear before, after or\n#                       between the names.\n#\n#   --compile           compile instead of running tests\n#   --test              run tests (the default)\n#   --env <name>        which environment's configs to use (default: test).\n#                       `--env=<name>` is accepted too.\n#   --list-envs         print the environments this project declares, one line\n#   --list-subprojects  print the sub-projects this project ships, one line\n#   --list-invocations  print what would run and run nothing, one\n#                       `SQRL_INVOCATION <sub-project> <verb> -r <root> <config...> -b <name>`\n#                       line per suite \u2014 exactly the arguments a real run would use\n#\n# EXAMPLES (using this project's own sub-project, event_audit)\n#   ./run-tests.sh                                     test every suite, env test\n#   ./run-tests.sh event_audit                         test just that sub-project\n#   ./run-tests.sh --compile --env dev                 compile every suite as dev\n#   ./run-tests.sh --compile --env prod event_audit    compile just that one, as prod\n#   ./run-tests.sh --list-invocations --compile --env dev     show what would run\n#\n#   A project with several sub-projects names as many as it likes:\n#   ./run-tests.sh <sub-project> <sub-project>\n#\n# An unknown sub-project name, or an environment this project does not declare, is an error\n# (exit 2) \u2014 never a silent no-op that runs nothing and reports success.\n#\n# WRITING THIS FILE FOR A PROJECT\n#   Three blocks below are marked \"EDIT FOR YOUR PROJECT\": the ENVS/SUBPROJECTS declarations,\n#   the `suite` table, and the optional setup/teardown hooks. Everything else is boilerplate \u2014\n#   copy it verbatim.\n#\n#   The `suite` table is the ONE place a project's config layering is written down: for each\n#   sub-project and each environment, the exact configs to layer, in merge order.\n#\nset -uo pipefail\n# `set -e` (exit on the first error) is not used to allow for more granular error handling.\n\ncd \"$(dirname \"$0\")\"\n\n# Where this project sits relative to the compiler's mount root. Inside the DataSQRL agent the mount\n# root is the repository, so a project in a subdirectory is reached with the prefix the\n# orchestrator exports; empty everywhere else, meaning the project IS the mount root.\n#\n# It is passed as `-r <root>` rather than glued onto every config path. Both forms are equivalent\n# to the compiler, but `-r` is REQUIRED once `-b` points inside build/: without it the compiler\n# resolves script.main against the wrong root and fails with \"Could not find main SQRL script\".\nP=\"${SQRL_PACKAGE_PREFIX:-}\"\nif [ -n \"$P\" ]; then\n  ROOT=\"${P%/}\"                                   # the DataSQRL agent told us where we are\nelif ROOT=\"$(git rev-parse --show-prefix 2>/dev/null)\"; then\n  ROOT=\"${ROOT%/}\"; ROOT=\"${ROOT:-.}\"             # a repo checkout: our path within it\nelse\n  ROOT=\".\"                                        # not in a repo: this project is the root\nfi\n\n# The DataSQRL CLI version the DataSQRL agent container ships; CI and local runs default to the same\n# one so snapshots match. Override with SQRL_VERSION.\nSQRL_VERSION=\"${SQRL_VERSION:-0.12.5}\"\n# Fallback tag for when that version is not published yet (a release in flight). Resolved once,\n# on the first docker invocation, and never inside the DataSQRL agent \u2014 the container has its own CLI.\nSQRL_FALLBACK_IMAGE=\"${SQRL_FALLBACK_IMAGE:-datasqrl/cmd:dev}\"\nIMAGE=\"\"\n\nresolve_image() {\n  [ -n \"$IMAGE\" ] && return 0\n  local want=\"datasqrl/cmd:${SQRL_VERSION}\"\n  if docker image inspect \"$want\" >/dev/null 2>&1 || docker pull -q \"$want\" >/dev/null 2>&1; then\n    IMAGE=\"$want\"\n    return 0\n  fi\n  IMAGE=\"$SQRL_FALLBACK_IMAGE\"\n  # Worth a warning, not a failure: snapshots were generated with the pinned version, so a\n  # different CLI can legitimately produce different output and fail tests that are fine.\n  printf 'warning: datasqrl/cmd:%s is not available; falling back to %s\\n' \\\n    \"$SQRL_VERSION\" \"$IMAGE\" >&2\n}\n\n# \u2500\u2500 EDIT FOR YOUR PROJECT \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n# The environments this project's configs cover, and the sub-projects it ships. Both are\n# declared rather than discovered, so that asking for something this project does not have\n# fails loudly instead of matching nothing, running zero suites and still exiting 0.\nENVS=\"test dev prod\"\nSUBPROJECTS=\"event_audit\"\n# \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\nVERB=test\nENV=test\nLIST=\"\"\nSELECTED=\"\"\nwhile [ $# -gt 0 ]; do\n  case \"$1\" in\n    --compile)   VERB=compile ;;\n    --test)      VERB=test ;;\n    --env)       ENV=\"${2:-}\"; shift ;;\n    --env=*)     ENV=\"${1#--env=}\" ;;\n    --list-invocations) LIST=1 ;;\n    --list-envs) echo \"$ENVS\"; exit 0 ;;\n    --list-subprojects) echo \"$SUBPROJECTS\"; exit 0 ;;\n    -*)          echo \"unknown option: $1\" >&2; exit 2 ;;\n    *)           SELECTED=\"$SELECTED $1\" ;;\n  esac\n  shift\ndone\ncase \" $ENVS \" in\n  *\" $ENV \"*) ;;\n  *) echo \"unknown env '$ENV' \u2014 this project declares: $ENVS\" >&2; exit 2 ;;\nesac\n\nfor s in $SELECTED; do\n  case \" $SUBPROJECTS \" in\n    *\" $s \"*) ;;\n    *) echo \"unknown sub-project '$s' \u2014 this project ships: $SUBPROJECTS\" >&2; exit 2 ;;\n  esac\ndone\n\nselected() {\n  [ -z \"$SELECTED\" ] && return 0\n  case \" $SELECTED \" in *\" $1 \"*) return 0 ;; esac\n  return 1\n}\n\n# Each suite writes its own build folder (the -b flag in the driver loop below), so one suite's\n# artifacts never overwrite a sibling's. `-b <name>` names a subfolder of build/: DataSQRL\n# resolves `-b fraud_store` to <project-root>/build/fraud_store\n\nsqrl() {\n  local verb=\"$1\"; shift\n  # Every named config must exist. A missing one means the suite line and this environment\n  # disagree, and compiling a partial argument list would quietly review the wrong thing.\n  local a missing=0\n  for a in \"$@\"; do\n    case \"$a\" in\n      *.json) [ -f \"$a\" ] || { echo \"missing config: $a\" >&2; missing=1; } ;;\n    esac\n  done\n  [ \"$missing\" = 1 ] && return 1\n  # List mode: report what would run and return. Bash has already expanded the environment and\n  # the path prefix, so the caller reads the real argument list without parsing this file. The\n  # sub-project is named first so each line stands on its own.\n  if [ -n \"$LIST\" ]; then\n    printf 'SQRL_INVOCATION %s %s -r %s %s\\n' \"$SUITE\" \"$verb\" \"$ROOT\" \"$*\"\n    return 0\n  fi\n\n  if [ -x /opt/agent/cmd.sh ]; then\n    /opt/agent/cmd.sh \"$verb\" -r \"$ROOT\" \"$@\"     # inside the DataSQRL agent container\n    return\n  fi\n  # CI / local developer machine: run the DataSQRL CLI image. Mount the REPOSITORY root at\n  # /workspace (not just this project) so a sibling shared module this project consumes exists\n  # inside the container too; `-r <project>` then points the compiler at this project.\n  local root\n  root=\"$(git rev-parse --show-toplevel 2>/dev/null)\" || root=\"$PWD\"\n  # The image runs in UTC, and every template's snapshots are generated in UTC. The container's\n  # default is left alone. TZ passes through only when set explicitly.\n  resolve_image\n  docker run --rm ${TZ:+-e TZ=\"$TZ\"} -v \"$root\":/workspace \\\n    \"$IMAGE\" \"$verb\" -r \"$ROOT\" \"$@\"\n}\n\n# \u2500\u2500 EDIT FOR YOUR PROJECT (optional): setup \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n# Anything the suites need first \u2014 generating or downloading test data too large for git,\n# starting a fixture. Guard it with $LIST so listing stays instant and side-effect free.\n# [ -n \"$LIST\" ] || ./scripts/generate-testdata.sh || exit 1\n# \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\n# \u2500\u2500 EDIT FOR YOUR PROJECT: the suite table \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n# One line per (sub-project, environment), naming that combination's configs in merge order \u2014\n# base first, environment config last, since a later file overrides an earlier one. Write the\n# filenames out literally; any names work. Cover every pair of SUBPROJECTS x ENVS that this\n# project actually has, and leave out the ones it does not: asking for a pair that is missing\n# reports an error rather than compiling something half-declared.\n#\n#   <sub-project>/<env>) echo \"<base config> <env config>\" ;;\n#\nsuite() {\n  case \"$1/$2\" in\n    event_audit/test)  echo \"event_audit-shared-package.json event_audit-test-package.json\"  ;;\n    event_audit/dev)   echo \"event_audit-shared-package.json event_audit-dev-package.json\"   ;;\n    event_audit/prod)  echo \"event_audit-shared-package.json event_audit-prod-package.json\"  ;;\n    *) return 1 ;;\n  esac\n}\n\n# \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n# Every selected sub-project runs even after one fails, so a single run reports every failure.\nfail=0\nSUITE=\"\"\nfor sub in $SUBPROJECTS; do\n  selected \"$sub\" || continue\n  SUITE=\"$sub\"\n  args=\"$(suite \"$sub\" \"$ENV\")\" || {\n    echo \"no '$ENV' configs declared for sub-project '$sub'\" >&2\n    fail=1\n    continue\n  }\n  # shellcheck disable=SC2086  # the declaration is a space-separated argument list, on purpose\n  sqrl \"$VERB\" $args -b \"$sub\" || fail=1\ndone\n\n# \u2500\u2500 EDIT FOR YOUR PROJECT (optional): teardown \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n# [ -n \"$LIST\" ] || ./scripts/teardown.sh\n# \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\nexit $fail\n"}], "isError": false, "durationMs": 3, "timestamp": 1795509912775}, {"role": "toolResult", "toolCallId": "call_01a20cbb042a7e90b06f258b", "toolName": "read", "content": [{"type": "text", "text": "# Lending 360\n\nA customer-facing data application that provides a unified view of all lending instruments a customer holds, including mortgages, consumer loans (personal and auto), and credit cards. Customers can see active balances, terms, and a consolidated payment history across all products.\n\n## Features\n\n- **Mortgage**: Active mortgage loans with key terms (rate, balance, payment, maturity)\n- **CreditCard**: Active credit card accounts with balance, credit limit, APR, and rewards\n- **ConsumerLoan**: Active personal and auto loans in a unified view\n- **Customer**: Basic customer profile without sensitive PII (no SSN, TIN, or date of birth)\n- **ConsolidatedLoanPayments**: All payments across mortgages, consumer loans, and credit cards in one table\n\n## Data Sources\n\nData is sourced from the shared [`data-catalog`](../data-catalog) submodule at the repository root, wired in via `script.include` in `lending360-shared-package.json`:\n- `data-catalog/lending/mortgages` \u2014 mortgage originations and servicing\n- `data-catalog/lending/cards_consumer_credit` \u2014 consumer loans and credit cards\n- `data-catalog/customer/customer_data` \u2014 customer master records\n\n## Project Structure\n\n```\nlending/\n\u251c\u2500\u2500 lending360.sqrl                  # Main processing logic\n\u251c\u2500\u2500 lending360-shared-package.json   # Shared configuration between all environments\n\u251c\u2500\u2500 lending360-test-package.json     # Test configuration\n\u251c\u2500\u2500 lending360-prod-package.json     # Prod configuration\n\u251c\u2500\u2500 lending360-api/\n\u2502   \u251c\u2500\u2500 schema.v1.graphqls           # GraphQL API schema\n\u2502   \u251c\u2500\u2500 operations.v1.graphql        # API endpoints (GraphQL, REST, MCP)\n\u2502   \u2514\u2500\u2500 tests/                       # GraphQL test queries\n\u2502       \u251c\u2500\u2500 customer-lending.graphql\n\u2502       \u2514\u2500\u2500 payment-history.graphql\n\u251c\u2500\u2500 snapshots/lending360/            # Test snapshots (auto-generated)\n\u2514\u2500\u2500 README.md\n```\n\n## API Endpoints\n\n| Operation | Description |\n|-----------|-------------|\n| `GetCustomerLendingOverview` | Full lending overview for a customer including all active instruments |\n| `GetCustomerPaymentHistory` | Consolidated payment history across all lending instruments |\n| `GetMortgage` | Mortgage loan details by loan_id or customer_id |\n| `GetCreditCard` | Credit card account details by account_id or customer_id |\n| `GetConsumerLoan` | Consumer loan details by loan_id or customer_id |\n\n## Running Tests\n\nRun from the **repository root**: the whole repository is mounted so the shared `data-catalog` submodule is visible, and `-r lending` selects this project.\n\n```bash\ndocker run -it --rm -p 8888:8888 -p 8081:8081 -v $PWD:/workspace datasqrl/cmd \\\n  test lending360-shared-package.json lending360-test-package.json -r lending\n```\n\n## Design Notes\n\n- CDC streams are deduplicated with `DISTINCT ... ORDER BY source_updated_at DESC` to retain the latest record per entity\n- ConsumerLoan unifies personal and auto loans via UNION ALL; `loan_purpose` is null for auto loans (they use `loan_type` for vehicle category instead)\n- ConsolidatedLoanPayments joins payment records with their respective loan/account tables to enrich with `customer_id`, which payments do not carry directly\n- The Customer table excludes SSN, TIN, and date of birth to avoid exposing sensitive PII\n- `instrument_type` values in ConsolidatedLoanPayments: `MORTGAGE`, `PERSONAL_LOAN`, `AUTO_LOAN`, `CREDIT_CARD`\n"}], "isError": false, "durationMs": 4, "timestamp": 1795509912776}, {"role": "assistant", "content": [{"type": "thinking", "thinking": "I now have plenty. Let me now think about the plan design.\n\n## Classification\n\nAxis 1: scenario = `pipeline` (a DataSQRL pipeline: sources, transforms, API).\nAxis 2: task = `new-project` (no .sqrl files exist in loan-payments yet).\n\nDomains: `finance` (loan payments). Maybe `analytics`? It's a transactional lookup, not really dashboards. Just `finance`.\n\n## Design decisions\n\nKey architectural points:\n\n1. **Custom GraphQL schema + operations** \u2014 Requirements define the API surface (three queries, JWT auth). The requirements say \"Protocols: GraphQL, REST and MCP, the same as sibling lending/\". The API is specified: `LoanPaymentSummary(loan_id)`, `LoanPayments(loan_id)`, and \"Loans of a customer\" (all loans of the signed-in customer each with summary). The customer query: the requirements Open Question recommends adding loan_status, original_amount_cents, current_balance_cents, monthly_payment_cents, next_payment_due_date. So we need a custom schema/operations. Use `/from-api` and `/design-api`.\n\nActually: The API is specified enough that a custom schema is appropriate, following lending's pattern. Also, the customer query must be filtered by JWT claim, not a caller-supplied customer_id. That requires table functions with `METADATA FROM 'auth.customer_id'`. This is a strong reason for custom schema/operations with table functions and relationships.\n\nLet me think about the API design mapping:\n\nQueries (all filtered by JWT claim customer_id):\n- `LoanPaymentSummary(loan_id)` \u2192 0/1 row. Since it needs auth filtering and a loan_id arg, define a table function `LoanPaymentSummary(loan_id STRING NOT NULL, customer_id STRING NOT NULL METADATA FROM 'auth.customer_id')` selecting from summary where loan_id = :loan_id AND customer_id = :customer_id LIMIT 1. The claim arg is not caller-supplied.\n- `LoanPayments(loan_id)` \u2192 payments of a loan, newest due date first, paged (limit/offset). Table function `LoanPayments(loan_id STRING NOT NULL, customer_id STRING NOT NULL METADATA FROM 'auth.customer_id')`.\n- Loans of a customer: all personal loans of the signed in customer with summary by customer_id. Table function with only the auth claim: e.g. `CustomerLoans(customer_id STRING NOT NULL METADATA FROM 'auth.customer_id')`. Each loan with its summary. Relationship from loan to summary? Since summary is one-per-loan, we can define a relationship `CustomerLoan.summary := SELECT * FROM LoanPaymentSummary s WHERE this.loan_id = s.loan_id LIMIT 1;` But summary table function requires auth claim too\u2014relationships don't have auth args unless defined with METADATA. We can define the relationship to read from a base state table.\n\nHmm, this is getting into implementation detail, which downstream decides. The plan should state what's built and the constraints.\n\n2. **Engines**: Flink (streaming), Postgres (serve), Vertx (API), Kafka? The sources are Kafka in prod but they're external connector tables provided by the catalog, not internal `engine(kafka)` tables. Do we need kafka engine enabled? The lending360 shared package enables `[\"flink\", \"postgres\", \"kafka\", \"vertx\"]`. Why kafka? Perhaps because the catalog includes internal kafka tables? Actually the catalog's prod connector uses `kafka-safe` external connector; that's a Flink connector, not the SQRL kafka engine. Hmm. The customer project enables iceberg/duckdb.\n\nWait \u2014 `enabled-engines` includes kafka when there are SUBSCRIBE or `engine(kafka)` internal tables. Here there are none. But lending uses kafka. The minimal recipe \"API over a database, no streaming pub/sub\" \u2192 `[\"flink\", \"postgres\", \"vertx\"]`. Since no mutation/subscription, we could drop kafka. But requirements say \"same layout as sibling lending/\". The task says always check minimal engines at end. The plan should specify minimal engine set. I'll go with `flink, postgres, vertx` \u2014 but note the catalog test connectors use filesystem and prod uses kafka-safe (Flink connectors), which don't require the SQRL kafka engine. Let me double check: does the catalog ontology require kafka engine? The include only loads the consumer_loans scripts we import. The `kafka` engine is for DataSQRL-managed internal Kafka topics. There are none. So minimal is flink+postgres+vertx.\n\nHowever, hmm: including the data catalog loads ALL .sqrl files (the whole data-catalog folder + subfolders). Wait, does `script.include` loading all `.sqrl` matter? It says the compiler copies the included project into build/<namespace>/ and loads every .sqrl. But only imported scripts' statements execute. So no internal tables. Still, might the catalog's own scripts (e.g. some dataset) contain internal kafka tables? Possibly bronze sources are external; silver are external iceberg maybe. But they won't be planned unless imported. So kafka engine not needed. But to be safe and \"same layout as lending\", I'll match lending's `[\"flink\",\"postgres\",\"kafka\",\"vertx\"]`? The plan's technical decisions should pick minimal. I'll state flink, postgres, vertx as minimal and note kafka not needed because no mutations/subscriptions. Actually wait \u2014 is there risk that the include needs kafka engine due to some internal table? The catalog's consumer_loans-test uses filesystem, prod uses kafka-safe. No internal. So safe.\n\nHmm, but there's a subtlety: The catalog test package config includes `is_batch` variable. The include config must pass `is_batch: false` (and environment). Lending passes `\"is_batch\": false` in the include config. The shared package uses `../data-catalog/ontology-test-package.json` which itself sets `environment: test`? Let me check: ontology-test-package.json sets `\"environment\": \"test\"`. But lending's shared config uses `package: ../data-catalog/ontology-test-package.json` and config `is_batch:false`. Then the test overlay sets `script.config.environment=test`, prod sets prod. But the include's `environment` comes from the package file named (`ontology-test-package.json` \u2192 environment test) overridden by the include config. Lending's include config only sets is_batch, so environment is fixed to \"test\" from ontology-test-package.json? Wait, that seems wrong for prod. Let me re-check.\n\nLending shared package:\n```\n\"include\": {\n  \"data-catalog\": {\n    \"package\": \"../data-catalog/ontology-test-package.json\",\n    \"config\": { \"is_batch\": false }\n  }\n}\n```\nThe package file's `script.config.environment` is \"test\". So the included catalog always resolves `{{environment}}` to \"test\" even in prod? That seems like a bug in lending, or the include config is overridden by... Hmm. Actually the docs say: \"DataSQRL renders them from two sources: the script.config of the package file named in package, and the include entry's own config, which overrides it.\" So lending's include would always use environment test. That means lending's prod compiles against test data connectors! That seems odd. But maybe the intended reference: the requirements' hard constraint says \"Use the catalog tables ... through script.include, the same way as lending/lending360-shared-package.json.\"\n\nThe task context suggests using `../data-catalog/ontology-shared-package.json` (which has no environment config) and supplying `environment` in the include config or via the consumer's script.config? Wait, no: `script.config.environment` of the consumer does NOT propagate to included scripts unless include config references it. The include config is static JSON. Hmm.\n\nBut actually re-reading: the consumer sets `script.config.environment = test` in the test overlay. The include's scripts have `{{environment}}` and the value comes from the package file named (`ontology-test-package.json` \u2192 test) + include config overrides. For prod, we want environment=prod. The include config in shared package can't differ per overlay because overlays can override `script.include`? They can \u2014 merging is per field, last wins. Actually script.include is a field; an overlay could redefine it. But lending doesn't.\n\nThe cleanest: use `../data-catalog/ontology-shared-package.json` (no environment config, no is_batch) and put `config: { \"environment\": \"test\", \"is_batch\": false }` in the test overlay's include, and `environment: prod` in prod overlay. But the rule says declare script.include in the config that declares script.main (the shared base). Hmm, but overlays can override.\n\nActually, wait. Let me re-read the task context carefully: \n\n\"If a module's OWN scripts contain `{{...}}` placeholders (inspect them before importing), supply those values in that module's `script.include` entry via a `config` object, e.g. `\"data_catalog\": { \"package\": \"../data-catalog/ontology-shared-package.json\", \"config\": { \"environment\": \"test\" } }` \u2014 otherwise unresolved placeholders become SQL parse errors.\"\n\nAnd the example package config shows `\"config\": { \"variant\": \"test\" }` at the script level, not include.\n\nThe catalog scripts use `{{environment}}` and `{{^is_batch}}`. If we use `ontology-shared-package.json`, its `script.config` doesn't set environment or is_batch. The `{{^is_batch}}` inverted section renders when is_batch is falsy; if not provided, is_batch is undefined \u2192 falsy \u2192 renders. Good. But `{{environment}}` would be unresolved \u2192 parse error. So we must supply environment.\n\nBut the consumer's own script imports `consumer_loans-{{environment}}`. The consumer's `{{environment}}` is resolved from the consumer's `script.config.environment`, which is set per overlay. However, inside the included project's OWN scripts (consumer_loans-test.sqrl etc.), the `{{environment}}` is only in the import line `IMPORT consumer_loans.*;`? Wait no. Let me check: consumer_loans-test.sqrl starts with `IMPORT consumer_loans.*;`. The `consumer_loans.sqrl` schema file doesn't have {{environment}}. The `{{^is_batch}}` is in the test connector. The `{{environment}}` appears in ontology.sqrl and lob ontologies, but we don't import those. So for our import `IMPORT data_catalog.lending.cards_consumer_credit.consumer_loans-{{environment}} AS cons;` \u2014 the `{{environment}}` here is in the consumer's import statement, resolved from consumer's script.config. So the included project's schema/connector scripts themselves: consumer_loans-test.sqrl has no placeholders except `{{^is_batch}}`. consumer_loans-prod.sqrl has `{{#is_batch}}`/`{{^is_batch}}`.\n\nSo is_batch must be resolved. Where does it come from for the included scripts? From the package file named (`ontology-shared-package.json`) script.config (none) + include config. If not provided, `{{^is_batch}}` renders (falsy) which is what we want (streaming). So is_batch undefined is fine. But to be explicit and match lending, set is_batch:false.\n\nNow `environment` for the included scripts: The included scripts consumer_loans-test.sqrl has no `{{environment}}`. So no issue. But if the include root loads all .sqrl and only executes imported ones, fine. However, the compiler might parse all files? \"loads every .sqrl in that directory and its subfolders\" \u2014 loads, but placeholders resolve at parse? If it parses all, unresolved `{{environment}}` in ontology.sqrl could error. Hmm. Lending includes ontology-test-package.json which sets environment test, avoiding that. So to be safe, we should also supply environment in the include config.\n\nGiven requirements say same layout as lending, and hard constraint \"the same way as lending/lending360-shared-package.json\", I'll follow lending closely: include `../data-catalog/ontology-test-package.json` with config `{is_batch: false}`. But then prod uses test connectors. Hmm, that contradicts FR-1 prod transport. But is that actually what lending does? Let me verify by seeing whether lending prod maybe changes include. lending360-prod-package.json only sets environment prod. So yes lending's include environment is pinned to test. That seems like a latent bug. But requirements explicitly say \"same layout as sibling lending\" and \"the same way as lending/lending360-shared-package.json\". The task-context however gives `ontology-shared-package.json` and demonstrates per-namespace config.\n\nI think the right plan decision: use `../data-catalog/ontology-shared-package.json` as the include package (per task-context authoritative), and supply `environment` per environment. But script.include is declared in the base (shared) config which can't differ per env. So declare the include in the shared base with a `config` referencing... can't use consumer's script.config in include config. Hmm.\n\nAlternative: put script.include in each env overlay? The rule says declare in the config that declares script.main, but overlays can also add script.include. Actually the configure-sqrl skill says overlays that only add engine or test-runner settings need no script.include \u2014 implying overlays CAN have include. And merging per-field. But `script` merging: does `script.include` merge or replace? Probably merge objects key by key. If we put include in shared base with `ontology-shared-package.json` and `config: {is_batch:false}`, and then in test overlay set include config environment test, and prod overlay environment prod \u2014 but the docs say package layers merge objects key by key, arrays replace. So the include config object would merge. That could work: base defines include with package + config.is_batch, test overlay adds config.environment=test, prod adds config.environment=prod.\n\nWait, but does the include `config` merge key-by-key across layers? The configure-sqrl doc says \"Package layers merge objects key by key but replace arrays whole\" (in context of auth). Generally JSON merge is deep. So yes likely.\n\nHowever, that's getting complicated. Let me look at what the other project `customer` does with its include, since it was \"declared under script.include by customer\". Let me check customer's package configs. That may reveal the pattern for environment.\n\nLet me read customer's shared/test/prod package.", "thinkingSignature": "reasoning_content"}, {"type": "toolCall", "id": "call_01a20cbb216b7bb3b6786fdb", "name": "bash", "arguments": {"command": "cd /workspace/customer && ls -la && echo \"===SHARED===\" && cat customer_enriched_pipeline-shared-package.json && echo \"===TEST===\" && cat customer_enriched_pipeline-test-package.json && echo \"===PROD===\" && cat customer_enriched_pipeline-prod-package.json && echo \"===BATCH===\" && cat customer_enriched_pipeline-batch-package.json"}}, {"type": "toolCall", "id": "call_01a20cbb21e279c29189f766", "name": "bash", "arguments": {"command": "cd /workspace/data-catalog && grep -rn \"{{\" ontology-shared-package.json ontology-test-package.json; echo \"===lob ontology head===\"; head -20 lending/lending-ontology.sqrl; echo \"===repo tree top===\"; ls -la /workspace/data-catalog/lending/cards_consumer_credit/"}}], "api": "openai-completions", "provider": "together", "model": "deepseek-ai/DeepSeek-V4.1-Flash", "usage": {"input": 3490, "output": 3490, "cacheRead": 82432, "cacheWrite": 0, "reasoning": 3263, "totalTokens": 89412, "cost": {"input": 0.001047, "output": 0.004188, "cacheRead": 0.000494592, "cacheWrite": 0, "total": 0.005729592}}, "stopReason": "toolUse", "timestamp": 1795509912778, "responseId": "f1a5e9ffae4e416198ca111a33b41280-aws_ec1", "rawStopReason": "tool_calls", "durationMs": 7714, "thinkingLevel": "high"}, {"role": "toolResult", "toolCallId": "call_01a20cbb216b7bb3b6786fdb", "toolName": "bash", "content": [{"type": "text", "text": "total 48\ndrwxr-xr-x 11 root root   352 Nov 24 08:27 .\ndrwxr-xr-x 11 root root   352 Nov 24 08:28 ..\n-rw-r--r--  1 root root   354 Nov 24 08:27 customer_enriched_pipeline-batch-package.json\n-rw-r--r--  1 root root   187 Nov 24 08:27 customer_enriched_pipeline-prod-package.json\n-rw-r--r--  1 root root   629 Nov 24 08:27 customer_enriched_pipeline-shared-package.json\n-rw-r--r--  1 root root 13863 Nov 24 08:27 customer_enriched_pipeline.sqrl\n-rw-r--r--  1 root root   437 Nov 24 08:27 customer_enriched_pipeline-test-package.json\n-rw-r--r--  1 root root    68 Nov 24 08:27 customer_enriched_sinks-prod.sqrl\n-rw-r--r--  1 root root  1091 Nov 24 08:27 customer_enriched_sinks-test.sqrl\n-rw-r--r--  1 root root  7985 Nov 24 08:27 README.md\ndrwxr-xr-x  3 root root    96 Nov 24 08:27 snapshots\n===SHARED===\n{\n  \"version\": \"1\",\n  \"enabled-engines\": [\"flink\", \"iceberg\", \"duckdb\", \"vertx\"],\n  \"script\": {\n    \"main\": \"customer_enriched_pipeline.sqrl\",\n    \"include\": {\n      \"data-catalog\": {\n        \"package\": \"../data-catalog/ontology-test-package.json\",\n        \"config\": {\n          \"is_batch\": false\n        }\n      }\n    }\n  },\n  \"engines\": {\n    \"flink\": {\n      \"config\": {\n        \"execution.runtime-mode\": \"STREAMING\"\n      }\n    }\n  },\n  \"compiler\": {\n    \"predicate-pushdown-rules\": \"LIMITED_RULES\",\n    \"api\": {\n      \"protocols\": [\"GRAPHQL\", \"REST\", \"MCP\"],\n      \"endpoints\": \"FULL\",\n      \"default-limit\": 20\n    }\n  }\n}\n===TEST===\n{\n  \"script\": {\n    \"config\": {\n      \"environment\": \"test\"\n    }\n  },\n  \"engines\": {\n    \"flink\": {\n      \"config\": {\n        \"table.exec.source.idle-timeout\": \"1 s\",\n        \"execution.checkpointing.interval\": \"30 s\"\n      }\n    }\n  },\n  \"test-runner\": {\n    \"delay-sec\": -1,\n    \"required-checkpoints\": 1,\n    \"snapshot-folder\": \"snapshots/customer_enriched_pipeline/\",\n    \"test-folder\": \"customer_enriched_pipeline-api/tests\"\n  }\n}\n===PROD===\n{\n  \"script\": {\n    \"config\": {\n      \"environment\": \"prod\"\n    }\n  },\n  \"engines\": {\n    \"flink\": {\n      \"config\": {\n        \"table.exec.source.idle-timeout\": \"1 s\"\n      }\n    }\n  }\n}\n===BATCH===\n{\n  \"script\": {\n    \"config\": {\n      \"is_batch\": true\n    },\n    \"include\": {\n      \"data-catalog\": {\n        \"package\": \"../data-catalog/ontology-test-package.json\",\n        \"config\": {\n          \"is_batch\": true\n        }\n      }\n    }\n  },\n  \"engines\": {\n    \"flink\": {\n      \"config\": {\n        \"execution.runtime-mode\": \"BATCH\"\n      }\n    }\n  }\n}\n"}], "isError": false, "durationMs": 11, "timestamp": 1795509920507}, {"role": "toolResult", "toolCallId": "call_01a20cbb21e279c29189f766", "toolName": "bash", "content": [{"type": "text", "text": "===lob ontology head===\nIMPORT cards_consumer_credit.credit_cards-{{environment}}.*;\nIMPORT cards_consumer_credit.consumer_loans-{{environment}}.*;\nIMPORT mortgages.mortgage_originations-{{environment}}.*;\nIMPORT mortgages.mortgage_servicing-{{environment}}.*;\nIMPORT cards_consumer_credit.credit_risk_signals-{{environment}}.*;\nIMPORT mortgages.mortgage_performance-{{environment}}.*;\n\n-- =====================================================\n-- Credit Card Account Relationships\n-- =====================================================\n\n/** All credit cards associated with this account */\nCredit_Card_Account.cards := SELECT * FROM Credit_Card c WHERE this.credit_card_account_id = c.credit_card_account_id;\n\n/** Active credit cards for this account */\nCredit_Card_Account.active_cards := SELECT * FROM Credit_Card c WHERE this.credit_card_account_id = c.credit_card_account_id\n                                                            AND card_status = 'ACTIVE';\n\n/** Billing statements for this account */\nCredit_Card_Account.statements := SELECT * FROM Credit_Card_Statement s WHERE this.credit_card_account_id = s.credit_card_account_id\n===repo tree top===\ntotal 72\ndrwxr-xr-x 13 root root   416 Nov 24 08:27 .\ndrwxr-xr-x  5 root root   160 Nov 24 08:27 ..\n-rw-r--r--  1 root root  3400 Nov 24 08:27 consumer_loans-prod.sqrl\n-rw-r--r--  1 root root 13558 Nov 24 08:27 consumer_loans.sqrl\n-rw-r--r--  1 root root  2556 Nov 24 08:27 consumer_loans-test.sqrl\n-rw-r--r--  1 root root  4089 Nov 24 08:27 credit_cards-prod.sqrl\n-rw-r--r--  1 root root 13309 Nov 24 08:27 credit_cards.sqrl\n-rw-r--r--  1 root root  3075 Nov 24 08:27 credit_cards-test.sqrl\n-rw-r--r--  1 root root  2269 Nov 24 08:27 credit_risk_signals-prod.sqrl\n-rw-r--r--  1 root root  9145 Nov 24 08:27 credit_risk_signals.sqrl\n-rw-r--r--  1 root root  1798 Nov 24 08:27 credit_risk_signals-test.sqrl\n-rw-r--r--  1 root root  1537 Nov 24 08:27 README.md\ndrwxr-xr-x 17 root root   544 Nov 24 08:27 testdata\n"}], "isError": false, "durationMs": 12, "timestamp": 1795509920507}, {"role": "assistant", "content": [{"type": "thinking", "thinking": "So both sibling projects pin the include to `ontology-test-package.json` and only override `is_batch`. They never pass `environment` for the include, meaning the catalog always uses `environment: test`. Wait but the consumer's scripts import `consumer_loans-{{environment}}` where `{{environment}}` is consumer's script.config \u2014 that's per-env. But the included catalog's own scripts (e.g., ontology.sqrl) use `{{environment}}` from the include config/package. Since the catalog is loaded entirely, ontology.sqrl would need environment. With `ontology-test-package.json`, environment is \"test\". So in prod, the loaded catalog would use test connectors. But which scripts actually execute? Only imported ones. If the consumer only imports `consumer_loans-{{environment}}` from the namespace, then only consumer_loans-test/prod execute. The rest of the catalog files are loaded but not executed.\n\nActually the imports inside consumer_loans-test.sqrl and consumer_loans-prod.sqrl are `IMPORT consumer_loans.*;` (relative), no environment. So the included project's environment resolution is irrelevant for what the consumer uses. The consumer itself selects the connector file via `consumer_loans-{{environment}}` with its own script.config.\n\nSo the pattern is fine: include package = ontology-test-package.json (any top-level file works), config is_batch false. Consumer picks test/prod connector via its own `{{environment}}`.\n\nGood \u2014 that's exactly how lending works. So I'll mirror lending.\n\nBut the task context says declare `\"data_catalog\": { \"package\": \"../data-catalog/ontology-shared-package.json\" }`. Which to use? The include package file's script.config environment matters for the included project's OWN scripts. If we use ontology-shared-package.json (no environment), and the catalog loads ontology.sqrl with `{{environment}}` unresolved, could error. But we don't import ontology.sqrl. Does the compiler evaluate all loaded files or only imported? The docs: \"DataSQRL takes that file's folder as the include root and loads every `.sqrl` in it and its subfolders\". \"Loads\" might mean it stages them, and IMPORT pulls. Unresolved placeholders likely only error when the file is imported/parsed. Lending/customer use ontology-test-package.json specifically, likely to ensure environment resolves. Safer to follow the proven sibling pattern: `../data-catalog/ontology-test-package.json` with config `{is_batch:false}`.\n\nHmm, but the task context explicitly gave `ontology-shared-package.json` as the example and warned about placeholders. It says: \"If a module's OWN scripts contain `{{...}}` placeholders ... supply those values in that module's `script.include` entry via a `config` object.\" So I could use ontology-shared-package.json and supply `config: {environment: test, is_batch: false}`. But then environment is pinned test for the included project's scripts \u2014 irrelevant since they aren't imported, and consumer picks connector. Actually wait: if environment is pinned to test in the include config, and the consumer imports `consumer_loans-{{environment}}` (consumer's own environment), that's independent. Good.\n\nI think the safest plan: follow the sibling `lending` exactly (include `../data-catalog/ontology-test-package.json` with `config: { is_batch: false }`), because requirements hard-constrain \"the same way as lending/lending360-shared-package.json\". But the task context (planning agent instructions) is more authoritative about include declaration. Hmm, they conflict slightly. The task context example uses namespace `data_catalog` and package `ontology-shared-package.json`. The siblings use namespace `data-catalog` (dash) and `ontology-test-package.json`.\n\nGiven the task context says \"prefer underscores for each namespace\", and requirements say same layout as lending. The key point: the plan is high-level; I can state the include configuration approach and let implementation decide exact. But plans should give file paths. I'll state: declare the catalog under `script.include` in the shared package (namespace `data_catalog`, package a top-level catalog package file), with `config.is_batch: false`; test/prod overlays set `script.config.environment`. That mirrors lending and satisfies both. I'll mention using `../data-catalog/ontology-shared-package.json` (task-context), but the implementation can pick any top-level package file. Actually the requirement says \"the same way as lending/lending360-shared-package.json\", which references a specific file. To be safe I'll explicitly say use the catalog top-level package file (e.g. `../data-catalog/ontology-shared-package.json`) and pass `is_batch: false`; this is equivalent since only the folder matters. Hmm, but \"same way as lending\" \u2014 lending uses ontology-test-package.json. The folder is the same (data-catalog root), so both load the same files. The difference is only the default environment for the catalog's own imported scripts.\n\nActually there IS a subtle risk: If we use ontology-shared-package.json, then when the catalog's `ontology.sqrl` is loaded but not imported, the compiler might still parse it and hit `{{environment}}`. The task context explicitly warns: \"If a module's OWN scripts contain `{{...}}` placeholders (inspect them before importing), supply those values in that module's script.include entry via a config object ... otherwise unresolved placeholders become SQL parse errors.\" So supply environment in include config. To fully match lending and avoid risk, use ontology-test-package.json which provides environment test.\n\nI'll decide: include package `../data-catalog/ontology-test-package.json` with config `{ \"is_batch\": false }`, exactly like lending. That's the hard constraint. I'll record the rationale in Technical Decisions.\n\nWait, but then in prod the included project's environment is test. Since only the consumer-selected connector file executes, it's fine. I'll note it.\n\nHmm, but actually there's a concern: The consumer import `IMPORT data_catalog.lending.cards_consumer_credit.consumer_loans-{{environment}} AS cons_loans;`. The `{{environment}}` resolves from the consumer's script.config (test/prod overlays). Good. And the schema file `consumer_loans.sqrl` gets imported by consumer_loans-test.sqrl/prod.sqrl relative. Fine.\n\n3. **Latest versions (FR-2)**: `DISTINCT ... ON loan_id ORDER BY source_updated_at DESC` and same for payment_id. Exactly like lending.\n\n4. **Filter FR-3**: personal payments: after DISTINCT filter `loan_type='PERSONAL'`, then inner join to latest loans on loan_id. Note: requirements say filter to latest payments loan_type PERSONAL, and a loan_id that exists in Personal_Loan. Inner join does that.\n\nShould we dedup payments then filter loan_type, or filter then dedup? The order: dedup on payment_id latest, then filter loan_type PERSONAL. Since loan_type could theoretically change across versions (unlikely), better dedup first then filter. Requirements transformation #2 says \"the latest version of each Loan_Payment by source_updated_at, key payment_id, filtered to loan_type='PERSONAL'.\" So dedup then filter.\n\n5. **LoanPayments (FR-4)**: join latest payments to latest loans on loan_id (inner join), select columns. Include `customer_id` = primary_borrower_customer_id, `loan_purpose`. Default order due_date desc then payment_id. Exposed as queryable by loan_id (FR-10) and by customer_id (FR-11? no, FR-11 uses loans of customer). Actually FR-10 query payments of a loan by loan_id. FR-11 query all loans of customer each with summary by customer_id. LoanPayments also needs customer_id filtering for auth (FR-12). Hmm.\n\nActually the API surface: `LoanPayments(loan_id)` paged, `LoanPaymentSummary(loan_id)`, and \"Loans of a customer\" query. So payments only queried by loan_id (with auth filter). Summary by loan_id (with auth). The customer query returns loans each with summary.\n\nAuth approach: use table functions with `METADATA FROM 'auth.customer_id'`.\n\n6. **LoanPaymentSummary (FR-6/7)**: group LoanPayments by loan_id, count APPLIED, count RETURNED, sum amounts where APPLIED (`SUM(CASE WHEN status='APPLIED' THEN ... END)`), last_payment_date = MAX(applied_date) where APPLIED. Unbounded window (regular GROUP BY). Note: `total_paid_cents` sum of payment_amount_cents of applied only. `principal_paid_cents`, `interest_paid_cents`, `late_fees_paid_cents` similarly only APPLIED. `last_payment_date` latest applied_date of applied.\n\nFR-8: when payment status changes, summary uses only latest status. Because LoanPayments is built from latest payments (dedup), re-grouping on update yields updated summary. Since it's a non-windowed group by, Flink will emit updates. Good.\n\nLoans without payments (FR-6/open question): LoanPaymentSummary has one row per personal loan (all 170 loans? Actually \"one row per personal loan\" \u2014 FR-6 says one row per personal loan, and the loan without payments gets counts 0). But FR-6 header says `LoanPaymentSummary` has one row per personal loan. Hmm, but if we group LoanPayments by loan_id, loans without payments won't appear. Requirements acceptance says \"For PL-011 (no payments), the summary row has counts and sums of 0 and a null last_payment_date.\" So we need to include all loans. That means summary should be based on the latest loans LEFT JOIN aggregated payments, not group by payments. So: aggregate LoanPayments (or latest personal payments) grouped by loan_id, then LEFT JOIN onto latest loans so every loan gets a row with COALESCE(0).\n\nWait but FR-6 says \"one row per personal loan\" and FR-11 customer query returns all loans each with summary. So summary must cover all loans including no-payment ones. The transformation #4 says \"group LoanPayments by loan_id\" but that's inconsistent with loans without payments. Open question resolves: yes show row with zeros. So implement: latest loans as the spine, LEFT JOIN the grouped aggregates. This is an important design point to record.\n\nHmm, but the requirement transformation explicitly says \"**LoanPaymentSummary**: group `LoanPayments` by `loan_id`, with the values of FR-6 and the filter rule of FR-7. Window: none (unbounded, updated on each change). A loan without payments gets a row with counts and sums of 0 and a null `last_payment_date` (see Open Questions).\" So you can't get no-payment loans by grouping payments. The implementation must outer-join. The plan should note this: derive summary from the full set of latest personal loans, LEFT JOIN the per-loan applied-payment aggregates, so loans with no payments appear with zeros.\n\n7. **Customer query (FR-11)**: \"all loans of a customer, each with its summary\". Need loan details (open question default: loan_status, original_amount_cents, current_balance_cents, monthly_payment_cents, next_payment_due_date). Define a table function filtered by JWT claim, returning loan rows, with a relationship to its summary. Since summary row per loan.\n\nDesign: `CustomerLoan(customer_id STRING NOT NULL METADATA FROM 'auth.customer_id')` returns loans for that customer from `_LatestPersonalLoan`. Then relationship `CustomerLoan.summary := SELECT * FROM LoanPaymentSummary s WHERE s.loan_id = this.loan_id LIMIT 1;` But LoanPaymentSummary as a table function has auth claim arg. Relationship definitions can read the underlying table. Hmm. Implementation detail.\n\nAlternatively define `_LoanSummary` internal table (the aggregate) and relationships/functions read it. The auth filter is applied at function level. The plan leaves names to implementation.\n\n8. **API schema/operations**: custom GraphQL schema `loan-payments-api/schema.v1.graphqls` and operations `operations.v1.graphql`. But since auth filtering uses table functions with METADATA claims, the schema fields for `LoanPaymentSummary(loan_id)`, `LoanPayments(loan_id, limit, offset)`, and customer loans query. The customer query\u2014the JWT claim is injected, so it takes no customer_id arg. The schema should reflect only caller-visible args (loan_id, limit, offset).\n\nWait, `LoanPaymentSummary(loan_id)` returns 0 or 1 row. In SQRL table functions that take loan_id and claim and return possibly multiple. Use LIMIT 1 to make it a single object type; the schema declares it as `LoanPaymentSummary` returning nullable object. Need to verify DataSQRL can expose a function as a single object. The design-api docs: \"a query field may also return a single object rather than a list when the spec demands it.\" So yes.\n\n9. **Auth configuration**: vertx `auth` block with issuer/audience/keys. Test HS256 fixed secret; prod key from `${JWT_SECRET}`. The open question default: HS256 with fixed test secret in test, key from env var in prod. Note configure-sqrl: `${...}` env vars resolved at runtime for vertx config? \"String values can reference environment variables, e.g. issuer: ${AUTH_ISSUER}\". Good. But auth `keys` array with kty oct k. For prod HS256, `k` base64url secret via `${JWT_SECRET}`. Need auth block in shared or each overlay. Since test and prod differ, put auth in each overlay, or shared with env placeholder. The task says \"Give every compiled combination an auth provider when the script reads a claim.\" Put auth in shared base with `${...}` placeholders? But test needs fixed secret. Better: test overlay has test issuer/key; prod overlay has prod issuer/key. But shared base compiles too (compile uses base+overlay always). Actually every compile layers base+overlay, so putting auth only in overlays is fine as long as each overlay has it. I'll put auth in each env overlay (test + prod + dev). Hmm, but the plan says give every pipeline project a `-test`, `-dev`, `-prod` overlay. We need dev too.\n\nWait \u2014 requirements say \"A `test` and a `prod` environment, with the same layout as the sibling project `lending/`\". Lending has only test and prod. The checklist rule says give `-test`, `-dev`, `-prod`. But requirements explicitly scope test and prod. Hmm, rule 10: \"Give each pipeline project a -test, a -dev and a -prod overlay. Leave out an environment only when the requirements say that the environment is not needed, and record that in ## Assumptions.\" Requirements say test and prod only. So we can omit dev, and record in Assumptions. Good. Similarly run-tests ENVS = \"test prod\".\n\n10. **Engines**: flink, postgres, vertx. Kafka not needed (no mutation/subscription). But wait: the sources are Kafka in prod, but external connector `kafka-safe` is a Flink connector, doesn't need kafka engine. Postgres serves the API. Vertx serves. So minimal = flink, postgres, vertx. I'll record.\n\nHmm, but lending uses kafka. Requirements say same layout. But configure-sqrl says prune engines not used and check minimal at end. I'll go minimal and note.\n\n11. **Freshness**: streaming Flink, 1 minute. No windowing (unbounded), so updates appear as they arrive. Watermarks from catalog (10s test / 30s prod). Good.\n\n12. **Tests**: API tests under `loan-payments-api/tests/`, custom schema, `use-inferred-schema: false`. Snapshots under `snapshots/loan-payments/` (or similar). Authorization tests with two tokens (CUST-439 and CUST-060) plus no-token test. `.properties` files for token overrides; default token in test-runner headers. FR-8 not testable with catalog data \u2192 cover with a table test? Requirements say \"The plan says how it covers this rule.\" Options: add an additional test record? Can't modify catalog test data. Could add a `/*+test*/` table test? Still no status change in data. Hmm. Could we create a project-local test source that simulates a payment status change? But out-of-scope? The requirement says project adds no source data of its own; tests use catalog test data. So FR-8 is not testable with catalog data. We can cover by reasoning: the DISTINCT-on-latest + non-windowed re-aggregation guarantees it. Could add a unit test in a separate test package with a synthetic CDC fixture? That would add source data of our own, which the scope says no (\"The project adds no source data of its own\"). So best: document that FR-8 is covered by design (dedup by latest source_updated_at then unbounded re-aggregation) and not by a snapshot, since the catalog test data has no status changes. I'll state in the plan / DQ.\n\nActually, could we test FR-8 with a GraphQL test? No. I'll note in the checklist step for tests: FR-8 is verified by construction, documented in README, because no test data exercises a status change; optionally add a table test only if synthetic data allowed. I'll leave it as a note.\n\n13. **run-tests.sh**: single sub-project (loan-payments? or maybe named `loan_payments`). SUBNPROJECTS = one, e.g. `loan_payments`? The build folder convention `-b <sub-project>`. Since a single-pipeline project, use e.g. `loan_payments` or `loan-payments`. Build folder name. I'll leave name to implementation but say one sub-project. ENVS = \"test prod\".\n\n14. **Data Quality & Observability**:\n- Build: The join `LoanPayments` = latest personal payments INNER JOIN latest Personal_Loan. A PERSONAL payment whose loan isn't in Personal_Loan (or whose loan record is missing) is silently dropped by the inner join \u2014 FR-3 explicitly wants only payments with a matching loan, so dropping is intended. But if a personal payment references a loan that never appears, the customer's payment is lost and the summary undercounts. This is a credible failure only if the catalog doesn't guarantee referential integrity. The catalog's lending-ontology asserts cross-domain FKs? Let me check whether loan_payment.loan_id \u2192 Personal_Loan is asserted. The catalog README says intra-unit FKs asserted in unit ontology, and cross-domain in root. `Loan_Payment.loan_id` references... there's no single parent because both Personal_Loan and Auto_Loan. Let me check the lending ontology for assertions on Loan_Payment. This matters for DQ decision.\n\nLet me grep the catalog for Loan_Payment assertions.", "thinkingSignature": "reasoning_content"}, {"type": "toolCall", "id": "call_01a20cbb482f7f82bf72c6ed", "name": "bash", "arguments": {"command": "cd /workspace/data-catalog && grep -rn \"Loan_Payment\\|loan_payment\\|personal_loan\" lending/lending-ontology.sqrl ontology.sqrl | head -40; echo \"===assertions in lending ontology===\"; grep -n \"no_rows\\|+test\" lending/lending-ontology.sqrl | head -40"}}, {"type": "toolCall", "id": "call_01a20cbb48a87190a7314c60", "name": "bash", "arguments": {"command": "cd /workspace/data-catalog && sed -n '1,120p' lending/lending-ontology.sqrl | grep -n \"Payment\\|payment\" ; echo \"===tail===\"; tail -120 lending/lending-ontology.sqrl"}}], "api": "openai-completions", "provider": "together", "model": "deepseek-ai/DeepSeek-V4.1-Flash", "usage": {"input": 1511, "output": 4373, "cacheRead": 89344, "cacheWrite": 0, "reasoning": 4183, "totalTokens": 95228, "cost": {"input": 0.00045329999999999996, "output": 0.0052476, "cacheRead": 0.000536064, "cacheWrite": 0, "total": 0.006236964}}, "stopReason": "toolUse", "timestamp": 1795509920510, "responseId": "c29d3a624a7249b9b7dbab5347ebe3fa-aws_ec1", "rawStopReason": "tool_calls", "durationMs": 9886, "thinkingLevel": "high"}, {"role": "toolResult", "toolCallId": "call_01a20cbb482f7f82bf72c6ed", "toolName": "bash", "content": [{"type": "text", "text": "lending/lending-ontology.sqrl:51:Personal_Loan.payments := SELECT * FROM Loan_Payment p WHERE this.loan_id = p.loan_id\nlending/lending-ontology.sqrl:68:Auto_Loan.payments := SELECT * FROM Loan_Payment p WHERE this.loan_id = p.loan_id\nlending/lending-ontology.sqrl:82:Loan_Application.personal_loan := SELECT * FROM Personal_Loan l WHERE this.application_id = l.application_id;\nlending/lending-ontology.sqrl:245:/** Every Loan_Payment for a PERSONAL loan must reference an existing Personal_Loan */\nlending/lending-ontology.sqrl:247:LoanPaymentReferencesValidPersonalLoan_Test := SELECT p.* FROM Loan_Payment p\nlending/lending-ontology.sqrl:251:/** Every Loan_Payment for an AUTO loan must reference an existing Auto_Loan */\nlending/lending-ontology.sqrl:253:LoanPaymentReferencesValidAutoLoan_Test := SELECT p.* FROM Loan_Payment p\nlending/lending-ontology.sqrl:456:LoanPaymentAmountNonNegative_Test := SELECT * FROM Loan_Payment WHERE payment_amount_cents < 0;\nontology.sqrl:28:Customer.personal_loans := SELECT * FROM Personal_Loan l WHERE this.customer_id = l.primary_borrower_customer_id;\nontology.sqrl:31:Customer.active_personal_loans := SELECT * FROM Personal_Loan l WHERE this.customer_id = l.primary_borrower_customer_id\n===assertions in lending ontology===\n180:/*+test(no_rows) */\n186:/*+test(no_rows) */\n192:/*+test(no_rows) */\n198:/*+test(no_rows) */\n204:/*+test(no_rows) */\n210:/*+test(no_row