payments-api/tests/loan-late-fees.graphql\n./loan-payments-api/tests/loan-late-fees.properties\n./loan-payments-api/tests/loan-summary-returned.graphql\n./loan-payments-api/tests/loan-summary-returned.properties\n./loan-payments-api/tests/missing-token.graphql\n./loan-payments-api/tests/payment-returned.graphql\n./loan-payments-api/tests/payment-returned.properties\n./loan-payments-api/tests/wrong-customer-payments.graphql\n./loan-payments-api/tests/wrong-customer-payments.properties\n./loan-payments-api/tests/wrong-customer-summary.graphql\n./loan-payments-api/tests/wrong-customer-summary.properties\n./loan-payments-api/tests/zero-payment-loan.graphql\n./loan-payments-api/tests/zero-payment-loan.properties\n./loan-payments-prod-package.json\n./loan-payments-shared-package.json\n./loan-payments.sqrl\n./loan-payments-table-test-package.json\n./README.md\n./run-tests.sh\n./snapshots/loan-payments/customer-loans.snapshot\n./snapshots/loan-payments/loan-late-fees.snapshot\n./snapshots/loan-payments/loan-summary-returned.snapshot\n./snapshots/loan-payments/missing-token.snapshot\n./snapshots/loan-payments/payment-returned.snapshot\n./snapshots/loan-payments_table_test/LoanPaymentsCountTest.snapshot\n./snapshots/loan-payments_table_test/ZeroPaymentSummaryTest.snapshot\n./snapshots/loan-payments/wrong-customer-payments.snapshot\n./snapshots/loan-payments/wrong-customer-summary.snapshot\n./snapshots/loan-payments/zero-payment-loan.snapshot\n"}], "isError": false, "durationMs": 31, "timestamp": 1795511347126}]}
