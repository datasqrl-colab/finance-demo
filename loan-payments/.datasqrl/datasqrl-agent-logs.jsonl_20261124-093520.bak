{"request_uuid": "a5a0a341-67dd-4fe9-88b6-c2c5702db363", "timestamp": "2026-11-24T09:24:19.521757+00:00", "level": "INFO", "mode": "implementation", "workspace_folder": "loan-payments", "mac_id": "5c:9b:a6:82:ff:92", "source": "judge", "message": "Judge tests: 7 issue(s)", "name": "tests", "issue_count": 7, "issues": [{"severity": "LOW", "description": "Auto_Loan (and Auto_Loan_schema) has no test coverage. The source table is imported but is not consumed by any downstream table or function, and no /*+test */ query references it (AutoLoanLeakTest only filters the personal-loan payment source and does not exercise the Auto_Loan table).", "location": "loan-payments.sqrl", "verifier": "tests"}, {"severity": "LOW", "description": "Loan_Application (and Loan_Application_schema) has no test coverage. The source table is imported but never used by any downstream table or function, and no test queries it.", "location": "loan-payments.sqrl", "verifier": "tests"}, {"severity": "LOW", "description": "Consumer_Loan_Delinquency_Event (and Consumer_Loan_Delinquency_Event_schema) has no test coverage. The source table is imported but never used by any downstream table or function, and no test queries it.", "location": "loan-payments.sqrl", "verifier": "tests"}, {"severity": "LOW", "description": "The user-facing function LoanPaymentSummary has no test. Only its underlying internal table _LoanPaymentSummarySource is snapshot-tested; the function's metadata-injected customer_id/loan_id filter and column projection are not exercised by any test.", "location": "loan-payments.sqrl", "verifier": "tests"}, {"severity": "LOW", "description": "The user-facing function LoanPayments has no test. Only its underlying internal table _LoanPaymentsSource is snapshot-tested; the function's metadata-injected customer_id/loan_id filter, ordering, and projection are not exercised by any test.", "location": "loan-payments.sqrl", "verifier": "tests"}, {"severity": "LOW", "description": "The user-facing function CustomerLoans has no test. Only its underlying internal table _CustomerLoansSource is snapshot-tested; the function's metadata-injected customer_id filter and ordering are not exercised by any test.", "location": "loan-payments.sqrl", "verifier": "tests"}, {"severity": "LOW", "description": "run-tests.sh depends on the ../data-catalog submodule's lending/cards_consumer_credit/testdata/*.jsonl fixtures (the setup block is commented out on the assumption that ${DATA_PATH} points at that folder), but the script never initializes or fetches that submodule. From a clean checkout the fixture data may be absent, making the run non-reproducible.", "location": "run-tests.sh", "verifier": "tests"}], "cost_usd": 0.018075, "duration_ms": 23905}
